<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Settings > General: product name; Odoo stays credited as the base it is built on (LGPL). -->
    <t t-inherit="res_config_edition" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('user-heading')]/h3" position="replace">
            <h3 class="px-0 d-flex align-items-center gap-2">
                <img src="/varyshop_brand/static/img/logo.svg" alt="Varyshop" style="height: 1.6em;"/>
                <t t-esc="serverVersion"/>
            </h3>
        </xpath>
        <xpath expr="//div[@id='settings']/small" position="before">
            <small class="d-block"><a target="_blank" href="https://www.varyshop.eu?utm_source=db&amp;utm_medium=settings" style="text-decoration: underline;">Varyshop</a> – built on Odoo Community Edition.</small>
        </xpath>
    </t>

    <!-- Installing a scoped app: publisher -->
    <t t-inherit="web.InstallScopedApp" t-inherit-mode="extension">
        <xpath expr="//a[@href='https://odoo.com']" position="replace">
            <a class="text-primary text-decoration-none" href="https://www.varyshop.eu" alt="Varyshop" target="_blank">Varyshop</a>
        </xpath>
    </t>
</templates>
