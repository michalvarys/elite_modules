<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- E-mail layouts: "Powered by Varyshop". Links in other e-mail templates are replaced when the
         e-mail is sent (models/mail_mail.py). -->
    <template id="mail_notification_layout" inherit_id="mail.mail_notification_layout" name="Varyshop: e-mail layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://www.varyshop.eu?utm_source=db&amp;utm_medium=email"
               t-att-style="'color: ' + (company.email_secondary_color or '#6ea8fe') + ';'">Varyshop</a>
        </xpath>
    </template>
    <template id="mail_notification_light" inherit_id="mail.mail_notification_light" name="Varyshop: light e-mail layout">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://www.varyshop.eu?utm_source=db&amp;utm_medium=email"
               t-att-style="'color: ' + (company.email_secondary_color or '#6ea8fe') + ';'">Varyshop</a>
        </xpath>
    </template>

    <!-- Public discuss page (meeting / chat link): tab title and favicon -->
    <template id="discuss_public_channel_template" inherit_id="mail.discuss_public_channel_template" name="Varyshop: public discuss">
        <xpath expr="//title" position="attributes">
            <attribute name="t-esc">title or 'Varyshop'</attribute>
        </xpath>
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/varyshop_brand/static/img/favicon.ico'</attribute>
        </xpath>
    </template>
</odoo>
