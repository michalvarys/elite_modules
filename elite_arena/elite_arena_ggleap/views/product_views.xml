<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggleap_product_list" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.product.list</field>
        <field name="model">elite.arena.ggleap.product</field>
        <field name="arch" type="xml">
            <list string="Produkty" create="0" delete="0" editable="bottom" decoration-muted="not in_catalog">
                <field name="name" readonly="1"/>
                <field name="kind"/>
                <field name="kind_manual" optional="hide"/>
                <field name="price"/>
                <field name="hours" widget="float_time"/>
                <field name="product_type" optional="hide"/>
                <field name="in_catalog"/>
            </list>
        </field>
    </record>
    <record id="view_ggleap_product_search" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.product.search</field>
        <field name="model">elite.arena.ggleap.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="catalog" string="V nabídce" domain="[('in_catalog', '=', True)]"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_kind" string="Druh" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_ggleap_product" model="ir.actions.act_window">
        <field name="name">Produkty</field>
        <field name="res_model">elite.arena.ggleap.product</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_kind': 1}</field>
        <field name="help" type="html">
            <p>Produkty a herní balíčky z pokladny ggLeapu. Druh (hraní / zdarma / občerstvení) se odhadne
               sám; když nesedí, opravte ho tady, synchronizace ho už nepřepíše.</p>
        </field>
    </record>
</odoo>
