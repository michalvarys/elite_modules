<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- games / apps -->
    <record id="view_ggleap_app_list" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.app.list</field>
        <field name="model">elite.arena.ggleap.app</field>
        <field name="arch" type="xml">
            <list string="Hry" create="0" delete="0" editable="bottom" decoration-muted="not is_game">
                <field name="name" readonly="1"/>
                <field name="tags"/>
                <field name="player_count" sum="Celkem"/>
                <field name="launch_count" optional="show"/>
                <field name="last_played"/>
                <field name="is_game" groups="elite_arena_ggleap.group_ggleap_manager"/>
                <field name="is_game_manual" optional="hide"/>
                <field name="app_type" optional="hide"/>
                <field name="in_catalog" optional="hide"/>
                <button name="action_open_partners" type="object" string="Kontakty" icon="fa-users"
                        invisible="not player_count"/>
            </list>
        </field>
    </record>
    <record id="view_ggleap_app_search" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.app.search</field>
        <field name="model">elite.arena.ggleap.app</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="tags"/>
                <filter name="games" string="Hry" domain="[('is_game', '=', True)]"/>
                <filter name="not_games" string="Launchery a programy" domain="[('is_game', '=', False)]"/>
                <separator/>
                <filter name="played" string="Někdo hrál" domain="[('player_count', '>', 0)]"/>
                <filter name="catalog" string="V nabídce ggLeap" domain="[('in_catalog', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="action_ggleap_app" model="ir.actions.act_window">
        <field name="name">Hry</field>
        <field name="res_model">elite.arena.ggleap.app</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_games': 1, 'search_default_played': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím žádné hry</p>
            <p>Hry a jejich spuštění se stahují z ggLeapu. Počítají se jen počítače, konzole hry nezapisují.</p>
        </field>
    </record>

    <!-- launches -->
    <record id="view_ggleap_app_launch_list" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.app.launch.list</field>
        <field name="model">elite.arena.ggleap.app.launch</field>
        <field name="arch" type="xml">
            <list string="Spuštění her" create="0" delete="0" edit="0">
                <field name="start"/>
                <field name="app_id"/>
                <field name="player_id"/>
                <field name="is_guest" optional="hide"/>
                <field name="machine_id"/>
            </list>
        </field>
    </record>
    <record id="view_ggleap_app_launch_search" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.app.launch.search</field>
        <field name="model">elite.arena.ggleap.app.launch</field>
        <field name="arch" type="xml">
            <search>
                <field name="app_id"/>
                <field name="player_id"/>
                <field name="machine_id"/>
                <filter name="games" string="Jen hry" domain="[('is_game', '=', True)]"/>
                <separator/>
                <filter name="start" string="Spuštěno" date="start"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_app" string="Hra" context="{'group_by': 'app_id'}"/>
                    <filter name="group_player" string="Hráč" context="{'group_by': 'player_id'}"/>
                    <filter name="group_month" string="Měsíc" context="{'group_by': 'start:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_ggleap_app_launch_pivot" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.app.launch.pivot</field>
        <field name="model">elite.arena.ggleap.app.launch</field>
        <field name="arch" type="xml">
            <pivot string="Spuštění her">
                <field name="app_id" type="row"/>
                <field name="start" interval="month" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="action_ggleap_app_launch" model="ir.actions.act_window">
        <field name="name">Spuštění her</field>
        <field name="res_model">elite.arena.ggleap.app.launch</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_games': 1}</field>
    </record>
</odoo>
