<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggleap_transaction_list" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.list</field>
        <field name="model">elite.arena.ggleap.transaction</field>
        <field name="arch" type="xml">
            <list string="Prodeje" create="0" delete="0" edit="0" decoration-muted="not is_paid">
                <field name="date"/>
                <field name="name"/>
                <field name="player_id"/>
                <field name="amount" sum="Celkem"/>
                <field name="paid_cash" optional="show" sum="Celkem"/>
                <field name="paid_card" optional="show" sum="Celkem"/>
                <field name="paid_balance" optional="show" sum="Celkem"/>
                <field name="discount" optional="hide" sum="Celkem"/>
                <field name="coupon_code" optional="hide"/>
                <field name="status" widget="badge" decoration-success="status == 'Paid'" decoration-danger="status == 'Refunded'"/>
                <field name="source" optional="hide"/>
                <field name="employee" optional="show"/>
                <field name="is_paid" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_ggleap_transaction_form" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.form</field>
        <field name="model">elite.arena.ggleap.transaction</field>
        <field name="arch" type="xml">
            <form string="Prodej" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="player_id"/>
                            <field name="partner_id"/>
                            <field name="employee"/>
                            <field name="source"/>
                            <field name="status"/>
                            <field name="refunded_at" invisible="not refunded_at"/>
                            <field name="coupon_code" invisible="not coupon_code"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="discount"/>
                            <field name="paid_cash"/>
                            <field name="paid_card"/>
                            <field name="paid_balance"/>
                            <field name="is_paid"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="quantity"/>
                            <field name="hours" widget="float_time"/>
                            <field name="discount"/>
                            <field name="amount"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ggleap_transaction_search" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.search</field>
        <field name="model">elite.arena.ggleap.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="player_id"/>
                <field name="employee"/>
                <field name="coupon_code"/>
                <filter name="paid" string="Do tržeb" domain="[('is_paid', '=', True)]"/>
                <filter name="refunded" string="Vrácené" domain="[('status', '=', 'Refunded')]"/>
                <filter name="coupon" string="S kuponem" domain="[('coupon_code', '!=', False)]"/>
                <filter name="guest" string="Bez hráče (host)" domain="[('player_id', '=', False)]"/>
                <separator/>
                <filter name="date" string="Datum" date="date"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_day" string="Den" context="{'group_by': 'date:day'}"/>
                    <filter name="group_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                    <filter name="group_employee" string="Obsluha" context="{'group_by': 'employee'}"/>
                    <filter name="group_source" string="Kde" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_ggleap_transaction_pivot" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.pivot</field>
        <field name="model">elite.arena.ggleap.transaction</field>
        <field name="arch" type="xml">
            <pivot string="Prodeje">
                <field name="date" interval="month" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_ggleap_transaction_graph" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.graph</field>
        <field name="model">elite.arena.ggleap.transaction</field>
        <field name="arch" type="xml">
            <graph string="Prodeje" type="bar">
                <field name="date" interval="day"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_ggleap_transaction" model="ir.actions.act_window">
        <field name="name">Prodeje</field>
        <field name="res_model">elite.arena.ggleap.transaction</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_paid': 1}</field>
    </record>

    <record id="view_ggleap_line_list" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.line.list</field>
        <field name="model">elite.arena.ggleap.transaction.line</field>
        <field name="arch" type="xml">
            <list string="Prodané položky" create="0" delete="0" edit="0">
                <field name="date"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="quantity" sum="Celkem"/>
                <field name="hours" widget="float_time" sum="Celkem" optional="show"/>
                <field name="amount" sum="Celkem"/>
                <field name="list_amount" optional="hide" sum="Celkem"/>
                <field name="player_id"/>
                <field name="transaction_id" optional="hide"/>
                <field name="status" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_ggleap_line_search" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.line.search</field>
        <field name="model">elite.arena.ggleap.transaction.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="player_id"/>
                <filter name="paid" string="Do tržeb" domain="[('is_paid', '=', True)]"/>
                <separator/>
                <filter name="time" string="Hraní" domain="[('kind', '=', 'time')]"/>
                <filter name="free" string="Hraní zdarma" domain="[('kind', '=', 'free')]"/>
                <filter name="food" string="Občerstvení" domain="[('kind', '=', 'food')]"/>
                <separator/>
                <filter name="date" string="Datum" date="date"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_product" string="Položka" context="{'group_by': 'name'}"/>
                    <filter name="group_kind" string="Druh" context="{'group_by': 'kind'}"/>
                    <filter name="group_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_ggleap_line_pivot" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.line.pivot</field>
        <field name="model">elite.arena.ggleap.transaction.line</field>
        <field name="arch" type="xml">
            <pivot string="Prodané položky">
                <field name="kind" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_ggleap_line_graph" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.transaction.line.graph</field>
        <field name="model">elite.arena.ggleap.transaction.line</field>
        <field name="arch" type="xml">
            <graph string="Prodané položky" type="bar" stacked="1">
                <field name="date" interval="month"/>
                <field name="kind"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_ggleap_line" model="ir.actions.act_window">
        <field name="name">Tržby podle položek</field>
        <field name="res_model">elite.arena.ggleap.transaction.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_paid': 1}</field>
    </record>
</odoo>
