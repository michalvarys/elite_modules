<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggleap_machine_list" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.machine.list</field>
        <field name="model">elite.arena.ggleap.machine</field>
        <field name="arch" type="xml">
            <list string="Počítače" create="0" delete="0" edit="0" decoration-muted="not in_catalog">
                <field name="name"/>
                <field name="state"/>
                <field name="last_update"/>
                <field name="group_uuid" optional="hide"/>
                <field name="in_catalog"/>
            </list>
        </field>
    </record>
    <record id="action_ggleap_machine" model="ir.actions.act_window">
        <field name="name">Počítače</field>
        <field name="res_model">elite.arena.ggleap.machine</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
