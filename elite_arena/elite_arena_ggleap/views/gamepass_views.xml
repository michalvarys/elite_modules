<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ggleap_gamepass_list" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.gamepass.list</field>
        <field name="model">elite.arena.ggleap.gamepass</field>
        <field name="arch" type="xml">
            <list string="Herní passy" create="0" delete="0" edit="0"
                  decoration-muted="state in ('used', 'expired', 'removed')">
                <field name="added_at"/>
                <field name="player_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="name"/>
                <field name="hours" widget="float_time" sum="Celkem"/>
                <field name="hours_left" widget="float_time" sum="Celkem"/>
                <field name="expires_at"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"/>
                <field name="granted_in_odoo" optional="show" string="Z Odoo"/>
                <field name="granted_by_id" optional="hide"/>
                <field name="grant_note" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_ggleap_gamepass_form" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.gamepass.form</field>
        <field name="model">elite.arena.ggleap.gamepass</field>
        <field name="arch" type="xml">
            <form string="Herní pass" create="0" delete="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="state" widget="badge"/>
                    </div>
                    <group>
                        <group>
                            <field name="player_id"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="hours" widget="float_time"/>
                            <field name="hours_used" widget="float_time"/>
                            <field name="hours_left" widget="float_time"/>
                        </group>
                        <group>
                            <field name="added_at"/>
                            <field name="started_at"/>
                            <field name="consumed_at"/>
                            <field name="expires_at"/>
                            <field name="removed_at" invisible="not removed_at"/>
                            <field name="pass_type"/>
                        </group>
                        <group string="Přidán z Odoo" invisible="not granted_in_odoo">
                            <field name="granted_by_id"/>
                            <field name="grant_note"/>
                        </group>
                        <group groups="base.group_no_one">
                            <field name="uuid"/>
                            <field name="offer_uuid"/>
                            <field name="priority"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ggleap_gamepass_search" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.gamepass.search</field>
        <field name="model">elite.arena.ggleap.gamepass</field>
        <field name="arch" type="xml">
            <search>
                <field name="player_id"/>
                <field name="partner_id"/>
                <field name="name"/>
                <filter name="active" string="Platné" domain="[('state', '=', 'active')]"/>
                <filter name="used" string="Vyčerpané" domain="[('state', '=', 'used')]"/>
                <filter name="expired" string="Propadlé" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="from_odoo" string="Přidané z Odoo" domain="[('granted_in_odoo', '=', True)]"/>
                <filter name="unused" string="Nezačaté" domain="[('state', '=', 'active'), ('seconds_used', '=', 0)]"/>
                <separator/>
                <filter name="added" string="Přidán" date="added_at"/>
                <filter name="expires" string="Platí do" date="expires_at"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_name" string="Pass" context="{'group_by': 'name'}"/>
                    <filter name="group_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_added" string="Měsíc přidání" context="{'group_by': 'added_at:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_ggleap_gamepass" model="ir.actions.act_window">
        <field name="name">Herní passy</field>
        <field name="res_model">elite.arena.ggleap.gamepass</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím žádné passy</p>
            <p>Passy hráčů se načítají z ggLeapu po dávkách. Nový pass přidáte u kontaktu v záložce Herna.</p>
        </field>
    </record>

    <record id="view_ggleap_gamepass_wizard_form" model="ir.ui.view">
        <field name="name">elite.arena.ggleap.gamepass.wizard.form</field>
        <field name="model">elite.arena.ggleap.gamepass.wizard</field>
        <field name="arch" type="xml">
            <form string="Přidat herní pass">
                <p class="text-muted">
                    Pass se hned zapíše do účtu hráče v ggLeapu. Hráč ho uvidí po přihlášení
                    a čas se mu odečte přednostně podle nastavení produktu.
                </p>
                <group>
                    <group>
                        <field name="partner_id" invisible="not partner_id" readonly="1"/>
                        <field name="player_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="restrictions"/>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="hours" widget="float_time"/>
                        <field name="valid_days"/>
                        <field name="expires_on"/>
                        <field name="start_type" widget="radio"/>
                        <field name="note" placeholder="např. hodina za dotazník"/>
                    </group>
                </group>
                <footer>
                    <button name="action_grant" type="object" string="Přidat pass" class="btn-primary"/>
                    <button string="Zrušit" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
