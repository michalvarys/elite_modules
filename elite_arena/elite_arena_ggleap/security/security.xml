<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ggleap" model="ir.module.category">
        <field name="name">Herna (ggLeap)</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_ggleap_user" model="res.groups">
        <field name="name">Data a přehled</field>
        <field name="category_id" ref="module_category_ggleap"/>
        <field name="comment">Vidí přehled herny, hráče, návštěvy, prodeje a rezervace z ggLeapu.</field>
    </record>
    <record id="group_ggleap_manager" model="res.groups">
        <field name="name">Správce</field>
        <field name="category_id" ref="module_category_ggleap"/>
        <field name="implied_ids" eval="[(4, ref('group_ggleap_user'))]"/>
        <field name="comment">Navíc nastavuje propojení s ggLeapem a spouští synchronizaci.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
