<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="survey_fill_form_done_reward" inherit_id="survey.survey_fill_form_done" name="Survey: odměna Elite Arény">
        <xpath expr="//div[@t-field='survey.description_done']" position="after">
            <t t-set="arena_claim" t-value="answer.sudo().arena_claim_id"/>
            <div t-if="arena_claim" class="my-4 p-4 text-center" style="background:#111111;color:#ffffff;border-radius:12px">
                <p class="mb-2" style="color:#ff4d6d;letter-spacing:2px;text-transform:uppercase;font-size:13px">Odměna za vyplnění</p>
                <p class="fs-4 mb-3" t-out="arena_claim.reward_id.name"/>
                <a t-att-href="'/odmena/%s' % arena_claim.token" class="btn btn-lg"
                   style="background:#e4002b;color:#ffffff;font-weight:bold;padding:14px 32px;border-radius:8px">Pro vyzvednutí odměny klikni zde</a>
            </div>
        </xpath>
    </template>
</odoo>
