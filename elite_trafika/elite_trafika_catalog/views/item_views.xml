<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalog_item_list" model="ir.ui.view">
        <field name="name">elite.trafika.catalog.item.list</field>
        <field name="model">elite.trafika.catalog.item</field>
        <field name="arch" type="xml">
            <list default_order="like_count desc, sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="pack"/>
                <field name="in_store"/>
                <field name="like_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_catalog_item_form" model="ir.ui.view">
        <field name="name">elite.trafika.catalog.item.form</field>
        <field name="model">elite.trafika.catalog.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Název výrobku"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="pack"/>
                            <field name="aroma"/>
                        </group>
                        <group>
                            <field name="in_store"/>
                            <field name="active"/>
                            <field name="ean"/>
                            <field name="like_count"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_catalog_item_search" model="ir.ui.view">
        <field name="name">elite.trafika.catalog.item.search</field>
        <field name="model">elite.trafika.catalog.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="not_in_store" string="Zatím nemáme" domain="[('in_store', '=', False)]"/>
                <filter name="hidden" string="Skryté" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_kind" string="Druh" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_catalog_like_pivot" model="ir.ui.view">
        <field name="name">elite.trafika.catalog.like.pivot</field>
        <field name="model">elite.trafika.catalog.like</field>
        <field name="arch" type="xml">
            <pivot string="Zájem">
                <field name="item_id" type="row"/>
                <field name="source" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_catalog_like_list" model="ir.ui.view">
        <field name="name">elite.trafika.catalog.like.list</field>
        <field name="model">elite.trafika.catalog.like</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Kdy"/>
                <field name="item_id"/>
                <field name="kind"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="action_catalog_items" model="ir.actions.act_window">
        <field name="name">Výrobky v katalogu</field>
        <field name="res_model">elite.trafika.catalog.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_catalog_likes" model="ir.actions.act_window">
        <field name="name">Zájem podle zdroje</field>
        <field name="res_model">elite.trafika.catalog.like</field>
        <field name="view_mode">pivot,list</field>
    </record>

    <menuitem id="menu_catalog" name="Katalog trafiky" parent="website.menu_website_configuration" sequence="40"
              groups="website.group_website_designer"/>
    <menuitem id="menu_catalog_items" parent="menu_catalog" action="action_catalog_items" sequence="10"/>
    <menuitem id="menu_catalog_likes" parent="menu_catalog" action="action_catalog_likes" sequence="20"/>
</odoo>
