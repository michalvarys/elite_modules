<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Vlastni kategorie a skupina, aby slo uzivateli dat pristup jen
            ke sprave tymu.
        -->
        <record id="module_category_elite_vet_team" model="ir.module.category">
            <field name="name">Náš tým</field>
            <field name="description">Přístup ke správě stránky Náš tým.</field>
            <field name="sequence">51</field>
        </record>

        <record id="group_team_manager" model="res.groups">
            <field name="name">Správce týmu</field>
            <field name="category_id" ref="module_category_elite_vet_team"/>
            <field name="comment">Může přidávat a upravovat lidi, fotky, sekce a popisky.</field>
        </record>
    </data>

    <!-- Mimo noupdate blok schvalne: spravce systemu ma skupinu dostat
         i pri upgradu uz nainstalovaneho modulu, jinak by po zprisneni prav
         prestal videt vlastni data. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_team_manager'))]"/>
    </record>
</odoo>
