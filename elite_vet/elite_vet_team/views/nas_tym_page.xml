<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Verejna stranka /nas-tym. Obsah se cely bere z aplikace Nas tym
        (sekce, lide, podrobnosti), takze se do tohohle souboru nesaha, kdyz
        nekdo prijde nebo odejde. Design zustal stejny jako u puvodni rucni
        stranky.
    -->
    <template id="nas_tym" name="Our team">
    <t t-call="website.layout">
        <!-- Adresa teze stranky v kazdem jazyce. Prepinac na ne vede primo,
             protoze pres /website/lang/ to stoji na cookie frontend_lang a ten
             in-app prohlizec Instagramu a Facebooku neposila tak, jak Odoo ceka.
             Cestina je vychozi jazyk a na "/" vraci url_for prazdno, proto "/". -->
        <t t-set="ev_jazyk_cs" t-value="('%s' % url_for(request.httprequest.path, lang_code='cs_CZ')) or '/'"/>
        <t t-set="ev_jazyk_de" t-value="('%s' % url_for(request.httprequest.path, lang_code='de_DE')) or '/'"/>
        <t t-set="ev_jazyk_en" t-value="('%s' % url_for(request.httprequest.path, lang_code='en_US')) or '/'"/>
        <t t-set="ev_jazyk_ru" t-value="('%s' % url_for(request.httprequest.path, lang_code='ru_RU')) or '/'"/>
            <t t-set="ev_web" t-value="request.env['elite.vet.setting'].sudo().nastaveni() if 'elite.vet.setting' in request.env else None"/>
        <t t-set="no_header" t-value="true"/>
        <t t-set="no_footer" t-value="true"/>
        <t t-set="additional_title">Our team | Elite Vet Karlovy Vary</t>
        <t t-set="meta_description">The team opening the Elite Vet veterinary clinic in Karlovy Vary — veterinarians, veterinary nurses, client service and management. Education, experience, specialisation and languages of the whole team.</t>
        <meta name="theme-color" content="#1a2744"/>

        <style>
            :root {
                --ev-bg: #ffffff;
                --ev-fg: #1a2744;
                --ev-primary: #1a2744;
                --ev-primary-dark: #111b30;
                --ev-accent: #2b7870;
                --ev-accent-dark: #1f5a54;
                --ev-accent-light: #e0f2f0;
                --ev-muted: #f7f9fb;
                --ev-border: #e2e8f0;
                --ev-text-secondary: #64748b;
            }

            /* ============ SKRÝT DEFAULTNÍ ODOO HEADER / FOOTER ============ */
            body > header,
            #wrapwrap > header,
            #wrapwrap > div > header,
            header#top,
            header.o_header_standard,
            header.o_header_affix,
            header.o_main_header,
            .o_header_standard,
            .o_header_affix,
            .o_main_navbar,
            .o_top_fixed_element,
            body > footer,
            #wrapwrap > footer,
            footer#footer,
            footer.o_footer,
            .o_footer,
            .o_footer_copyright { display: none !important; visibility: hidden !important; height: 0 !important; max-height: 0 !important; overflow: hidden !important; opacity: 0 !important; pointer-events: none !important; }
            body, html { padding-top: 0 !important; margin-top: 0 !important; }

            /* ============ TOPBAR (stejná jako na homepage) ============ */
            .ev-topbar { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: #ffffff; border-bottom: 1px solid var(--ev-border); transition: transform .3s ease; -webkit-backface-visibility: hidden; backface-visibility: hidden; will-change: transform; }
            .ev-topbar.ev-nav-hidden { transform: translateY(-100%); }
            .ev-topbar-inner { display: flex; align-items: center; justify-content: space-between; height: 68px; }
            .ev-topbar-logo { display: inline-flex; align-items: center; gap: 0; font-size: 20px; font-weight: 800; color: var(--ev-primary); letter-spacing: -0.01em; }
            .ev-topbar-logo:hover { color: var(--ev-primary); }
            .ev-topbar-img { height: 44px; width: auto; max-width: 80px; object-fit: contain; display: block; border-radius: 8px; margin-right: 10px; }
            .ev-topbar-nav { display: flex; align-items: center; gap: 26px; }
            .ev-topbar-nav a { font-size: 14px; font-weight: 500; color: var(--ev-text-secondary); transition: color .2s; white-space: nowrap; }
            .ev-topbar-nav a:hover { color: var(--ev-accent); }
            .ev-topbar-nav a.ev-nav-active { color: var(--ev-primary); font-weight: 700; }

            /* ============ BURGER (pure CSS přes details) ============ */
            .ev-burger { position: relative; display: none; }
            .ev-burger > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 12px; background: var(--ev-accent); color: #fff; transition: background-color .2s; }
            .ev-burger > summary::-webkit-details-marker { display: none; }
            .ev-burger > summary:hover { background: var(--ev-accent-dark); }
            .ev-burger-panel { position: absolute; top: calc(100% + 10px); right: 0; min-width: 280px; max-width: calc(100vw - 24px); background: #fff; border: 1px solid var(--ev-border); border-radius: 18px; padding: 14px; box-shadow: 0 18px 40px -12px rgba(17,27,48,.28); z-index: 999; animation: evCallInTop .18s ease-out; display: flex; flex-direction: column; gap: 4px; }
            .ev-burger-link { display: flex; align-items: center; gap: 14px; padding: 15px 18px; border-radius: 14px; color: var(--ev-primary); font-size: 16px; font-weight: 600; transition: background-color .15s; }
            .ev-burger-link:hover { background: var(--ev-muted); color: var(--ev-primary); }
            .ev-burger-link svg { color: var(--ev-accent); flex-shrink: 0; }

            /* ============ KONTAKTNÍ POPUP ============ */
            /* ============ PŘEPÍNAČ JAZYKŮ (odkazy rovnou na /cs, /de, /en, /ru) ============ */
            .ev-lang { position: relative; display: inline-flex; }
            .ev-lang > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; padding: 8px 13px; border-radius: 9999px; border: 1px solid var(--ev-border); background: #fff; color: var(--ev-primary); font-size: 13px; font-weight: 700; letter-spacing: .02em; transition: border-color .2s, background-color .2s, color .2s; }
            .ev-lang > summary::-webkit-details-marker { display: none; }
            .ev-lang > summary::marker { content: ""; }
            .ev-lang > summary:hover { border-color: var(--ev-accent); background: var(--ev-accent-light); color: var(--ev-accent-dark); }
            .ev-lang > summary svg { flex-shrink: 0; }
            .ev-lang-caret { opacity: .6; transition: transform .25s ease; }
            .ev-lang[open] > summary .ev-lang-caret { transform: rotate(180deg); }
            details.ev-lang[open] { z-index: 9999; }
            .ev-lang-panel { position: absolute; top: calc(100% + 10px); right: 0; min-width: 170px; display: flex; flex-direction: column; gap: 2px; background: #fff; border: 1px solid var(--ev-border); border-radius: 14px; padding: 6px; box-shadow: 0 18px 40px -12px rgba(17,27,48,.28); z-index: 9999; animation: evCallInTop .18s ease-out; }
            .ev-lang-opt { display: block; padding: 10px 14px; border-radius: 10px; font-size: 14px; font-weight: 600; color: var(--ev-text-secondary); white-space: nowrap; transition: background-color .15s, color .15s; }
            .ev-lang-opt:hover { background: var(--ev-muted); color: var(--ev-primary); }
            .ev-lang-opt.is-active { background: var(--ev-accent-light); color: var(--ev-accent-dark); }
            /* odznak aktuálního jazyka — pure CSS podle html[lang], bez QWeb (aby šel text v editoru upravovat) */
            .ev-lang-code { display: none; }
            .ev-lang-code-cs { display: inline; }
            html[lang^="de"] .ev-lang-code-cs,
            html[lang^="en"] .ev-lang-code-cs,
            html[lang^="ru"] .ev-lang-code-cs { display: none; }
            html[lang^="de"] .ev-lang-code-de,
            html[lang^="en"] .ev-lang-code-en,
            html[lang^="ru"] .ev-lang-code-ru { display: inline; }
            .ev-call { position: relative; display: inline-flex; }
            .ev-call > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600; transition: background-color .2s, color .2s, border-color .2s; }
            .ev-call > summary::-webkit-details-marker { display: none; }
            .ev-call-panel { position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%); min-width: 260px; background: #fff; border: 1px solid var(--ev-border); border-radius: 16px; padding: 8px; box-shadow: 0 18px 40px -12px rgba(17,27,48,.28); z-index: 9999; animation: evCallIn .18s ease-out; }
            details.ev-call[open] { position: relative; z-index: 9999; }
            @keyframes evCallIn { from { opacity: 0; transform: translate(-50%, -6px); } to { opacity: 1; transform: translate(-50%, 0); } }
            @keyframes evCallInTop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
            .ev-call-item { display: flex; align-items: center; gap: 12px; padding: 11px 14px; border-radius: 12px; transition: background-color .15s; color: var(--ev-primary); }
            .ev-call-item:hover { background: var(--ev-accent-light); color: var(--ev-primary); }
            .ev-call-icon { width: 38px; height: 38px; border-radius: 10px; background: var(--ev-accent-light); color: var(--ev-accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
            .ev-call-num { font-size: 15px; font-weight: 700; color: var(--ev-primary); }
            .ev-call-lbl { font-size: 12px; color: var(--ev-text-secondary); margin-top: 1px; }
            .ev-call--topbar > summary { background: var(--ev-accent); color: #fff; padding: 9px 18px; border-radius: 9999px; font-size: 14px; }
            .ev-call--topbar > summary:hover { background: var(--ev-accent-dark); }
            .ev-call--topbar > .ev-call-panel { left: auto !important; right: 0 !important; transform: none !important; animation: evCallInTop .18s ease-out; }
            .ev-call--outro > summary { background: var(--ev-accent); color: #fff; padding: 14px 26px; border-radius: 9999px; font-size: 15px; }
            .ev-call--outro > summary:hover { background: var(--ev-accent-dark); }

            /* přímé volání — telefonní tlačítko je odkaz tel: místo rozbalovacího details */
            a.ev-call { display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600; text-decoration: none; transition: background-color .2s, color .2s, border-color .2s; }
            a.ev-call--outro { background: var(--ev-accent); color: #fff !important; padding: 14px 26px; border-radius: 9999px; font-size: 15px; }
            a.ev-call--outro:hover { background: var(--ev-accent-dark); color: #fff !important; }

            /* ============ ZÁKLAD ============ */
            html { scroll-behavior: smooth; }
            .vet-page { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--ev-fg); background: var(--ev-bg); line-height: 1.5; }
            .vet-page * { box-sizing: border-box; }
            .vet-page a { color: inherit; text-decoration: none; }
            .vet-page p { margin: 0; }
            .vet-page h1, .vet-page h2, .vet-page h3 { margin: 0; letter-spacing: -0.02em; color: var(--ev-primary); font-weight: 700; }
            .vet-page section.o_colored_level { padding-left: 0; padding-right: 0; }
            .ev-container { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 24px; }

            /* ============ HERO (kompaktní — je to podstránka, ne landing) ============ */
            .tm-hero { position: relative; padding: 132px 0 64px; overflow: hidden;
                background:
                    radial-gradient(circle at 12% 10%, rgba(91,168,160,.26) 0%, transparent 46%),
                    radial-gradient(circle at 88% 90%, rgba(91,168,160,.20) 0%, transparent 48%),
                    linear-gradient(135deg, var(--ev-primary), var(--ev-primary-dark));
            }
            .tm-hero-inner { position: relative; z-index: 2; text-align: center; }
            .tm-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(91,168,160,.18); border: 1px solid rgba(91,168,160,.45); color: #a7dcd6; padding: 7px 18px; border-radius: 9999px; font-size: 12.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
            .tm-badge svg { flex-shrink: 0; }
            .vet-page .tm-hero h1 { margin-top: 18px; font-size: clamp(28px, 4.4vw, 50px); line-height: 1.1; font-weight: 800; color: #fff; }
            .tm-hero-sub { margin-top: 12px; display: inline-flex; align-items: center; gap: 10px; color: #fff; font-size: clamp(14px, 1.5vw, 17px); font-weight: 600; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); padding: 8px 18px; border-radius: 9999px; }
            .tm-hero-sub svg { color: var(--ev-accent); flex-shrink: 0; }
            /* .vet-page prefix je nutny: .vet-page p { margin: 0 } jinak prebije auto okraje i margin-top */
            .vet-page .tm-lead { margin: 24px auto 0; max-width: 860px; text-align: center; color: rgba(255,255,255,.78); font-size: clamp(14.5px, 1.3vw, 16.5px); line-height: 1.75; }

            /* callout — externí specialisté + hlavní odpovědný tým */
            .tm-note { margin: 22px auto 0; max-width: 780px; display: flex; align-items: flex-start; gap: 13px; text-align: left; background: rgba(91,168,160,.14); border: 1px solid rgba(91,168,160,.34); border-radius: 16px; padding: 16px 20px; }
            .tm-note svg { color: var(--ev-accent); flex-shrink: 0; margin-top: 2px; }
            .vet-page .tm-note p { color: rgba(255,255,255,.9); font-size: clamp(13.5px, 1.2vw, 15px); line-height: 1.62; }
            .tm-note strong { color: #fff; font-weight: 800; }

            .tm-jump { margin-top: 24px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
            .tm-jump a { display: inline-flex; align-items: center; gap: 8px; padding: 9px 18px; border-radius: 9999px; background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.2); color: rgba(255,255,255,.88) !important; font-size: 13.5px; font-weight: 600; transition: background-color .2s, border-color .2s, color .2s; }
            .tm-jump a:hover { background: rgba(91,168,160,.22); border-color: var(--ev-accent); color: #fff !important; }
            .tm-jump b { color: var(--ev-accent); font-weight: 800; }

            /* ============ SEKCE ============ */
            .tm-sec { padding: 74px 0; scroll-margin-top: 88px; }
            .tm-sec--alt { background: var(--ev-muted); }
            .tm-sec-head { display: flex; align-items: center; gap: 16px; margin-bottom: 34px; }
            .tm-sec-head h2 { font-size: clamp(24px, 3vw, 32px); line-height: 1.15; white-space: nowrap; }
            .tm-sec-count { display: inline-flex; align-items: center; justify-content: center; min-width: 30px; height: 30px; padding: 0 10px; border-radius: 9999px; background: var(--ev-accent-light); color: var(--ev-accent-dark); font-size: 13px; font-weight: 800; flex-shrink: 0; }
            .tm-sec-line { flex: 1 1 auto; height: 1px; background: var(--ev-border); }

            /* ============ KARTA ČLENA (rozbalovací — hlava vidět, detail na klik) ============ */
            .tm-list { display: flex; flex-direction: column; gap: 16px; }
            .tm-card { display: block; background: #fff; border: 1px solid var(--ev-border); border-radius: 22px; padding: 24px 30px; box-shadow: 0 12px 34px -22px rgba(17,27,48,.28); transition: border-color .25s, box-shadow .25s; }
            .tm-card:hover { border-color: rgba(91,168,160,.4); box-shadow: 0 18px 44px -22px rgba(91,168,160,.4); }
            .tm-card--lead { border-color: rgba(91,168,160,.45); background: linear-gradient(180deg, rgba(224,242,240,.5) 0%, #fff 150px); }
            .tm-card > summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 16px; }
            .tm-card > summary::-webkit-details-marker { display: none; }
            .tm-card > summary > .tm-head { flex: 1 1 auto; min-width: 0; }
            .tm-card-toggle { flex-shrink: 0; display: inline-flex; align-items: center; gap: 7px; color: var(--ev-accent-dark); font-size: 12.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; white-space: nowrap; }
            .tm-card-toggle svg { transition: transform .25s ease; }
            .tm-card[open] .tm-card-toggle svg { transform: rotate(180deg); }
            .tm-card-open { margin-top: 20px; padding-top: 22px; border-top: 1px solid var(--ev-border); }
            /* rozbalovací detail (vzdělání, praxe, specializace…) */
            .tm-more { margin-top: 16px; }
            .tm-more > summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 9999px; background: var(--ev-accent-light); color: var(--ev-accent-dark); font-size: 12.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; transition: background-color .2s; }
            .tm-more > summary::-webkit-details-marker { display: none; }
            .tm-more > summary:hover { background: rgba(91,168,160,.25); }
            .tm-more-chevron { transition: transform .25s ease; }
            .tm-more[open] > summary .tm-more-chevron { transform: rotate(180deg); }
            .tm-more > .tm-facts { margin-top: 18px; }

            .tm-head { display: flex; align-items: center; gap: 16px; }
            .tm-avatar { width: 64px; height: 64px; border-radius: 9999px; background: linear-gradient(135deg, var(--ev-accent), var(--ev-accent-dark)); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 800; flex-shrink: 0; box-shadow: 0 10px 22px -12px rgba(91,168,160,.9); }
            .tm-avatar--photo { padding: 0; background: none; object-fit: cover; object-position: center; }

            /* ====== ZVĚTŠENÍ FOTKY PO KLIKNUTÍ ======
               Bez JavaScriptu: skrytý checkbox, klik na fotku ho zaškrtne a tím
               se ukáže překryv. Překryv je zároveň label pro ten samý checkbox,
               takže klik kamkoliv na něj zvětšení zavře. Nepoužíváme :target,
               ten Odoo rozbíjí. */
            .tm-zoom-toggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; margin: 0; }
            .tm-zoom-open { display: block; flex-shrink: 0; cursor: zoom-in; border-radius: 9999px; line-height: 0; }
            .tm-zoom-open:focus-visible { outline: 3px solid var(--ev-accent); outline-offset: 3px; }
            .tm-zoom-overlay { display: none; }
            .tm-zoom-toggle:checked ~ .tm-zoom-overlay {
                display: flex; position: fixed; inset: 0; z-index: 10000;
                align-items: center; justify-content: center; padding: 24px;
                background: rgba(9, 15, 28, .88); cursor: zoom-out;
                overflow: auto; overscroll-behavior: contain;
                animation: evZoomIn .18s ease-out;
            }
            .tm-zoom-img { max-width: min(720px, 94vw); max-height: 82vh; width: auto; height: auto; object-fit: contain; }
            .tm-zoom-name { position: absolute; bottom: 26px; left: 0; right: 0; text-align: center; color: rgba(255,255,255,.8); font-size: 14px; font-weight: 600; letter-spacing: .02em; padding: 0 20px; }
            @keyframes evZoomIn { from { opacity: 0; } to { opacity: 1; } }
            @media (prefers-reduced-motion: reduce) { .tm-zoom-toggle:checked ~ .tm-zoom-overlay { animation: none; } }
            /* v editoru a v režimu překladu překryv nesmí plavat přes obsah */
            body.editor_enable .tm-zoom-toggle:checked ~ .tm-zoom-overlay,
            body.editor_has_snippets .tm-zoom-toggle:checked ~ .tm-zoom-overlay,
            body.o_translate_mode .tm-zoom-toggle:checked ~ .tm-zoom-overlay { display: none !important; }
            .tm-card--lead .tm-avatar { background: linear-gradient(135deg, var(--ev-primary), var(--ev-primary-dark)); box-shadow: 0 10px 22px -12px rgba(17,27,48,.7); }
            .vet-page .tm-name { font-size: 19px; line-height: 1.25; }
            .vet-page .tm-role { margin-top: 6px; color: var(--ev-accent-dark); font-size: 13.5px; font-weight: 600; line-height: 1.45; }
            .tm-tag .ev-spec-ico { flex-shrink: 0; display: block; object-fit: contain; }
            .tm-tag { display: inline-flex; align-items: center; gap: 7px; margin-top: 14px; padding: 5px 12px; border-radius: 9999px; background: var(--ev-primary); color: #fff; font-size: 11.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; }
            /* Specializace — stitky s ikonou. Svetlejsi nez .tm-tag, aby zustal
               hlavni stitek (Vedouci lekarka) tim vyraznejsim prvkem. */
            .tm-specs { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
            .tm-spec { display: inline-flex; align-items: center; gap: 7px; padding: 5px 13px 5px 9px; border-radius: 9999px; background: var(--ev-accent-light); border: 1px solid rgba(43,120,112,.28); color: var(--ev-accent-dark); font-size: 12px; font-weight: 600; line-height: 1.2; }
            .tm-spec .ev-spec-ico { flex-shrink: 0; display: block; object-fit: contain; }
            .vet-page .tm-perex { margin-top: 14px; color: var(--ev-text-secondary); font-size: 14.5px; line-height: 1.7; }

            .tm-facts { display: flex; flex-direction: column; }
            .tm-fact { display: grid; grid-template-columns: 152px 1fr; gap: 16px; padding: 13px 0; border-top: 1px solid var(--ev-border); }
            .tm-fact:first-child { border-top: 0; padding-top: 0; }
            .tm-fact:last-child { padding-bottom: 0; }
            .tm-fact-k { font-size: 11.5px; font-weight: 800; letter-spacing: .09em; text-transform: uppercase; color: var(--ev-accent); padding-top: 3px; }
            .tm-fact-v { font-size: 14.5px; line-height: 1.65; color: var(--ev-text-secondary); }

            /* ============ ZÁVĚR ============ */
            .tm-outro { padding: 70px 0 84px; background: radial-gradient(circle at 100% 0%, rgba(91,168,160,.18) 0%, transparent 30%), radial-gradient(circle at 0% 100%, rgba(91,168,160,.12) 0%, transparent 26%), linear-gradient(135deg, var(--ev-primary), var(--ev-primary-dark)); text-align: center; }
            .tm-outro-icon { width: 62px; height: 62px; margin: 0 auto 22px; border-radius: 18px; background: rgba(255,255,255,.1); color: #fff; display: flex; align-items: center; justify-content: center; }
            .vet-page .tm-outro h2 { color: #fff; font-size: clamp(22px, 2.8vw, 28px); text-align: center; }
            /* centrovani drzime explicitne i na containeru — jinak ho Odoo edicni styly prebijou */
            .vet-page .tm-outro .ev-container { text-align: center; }
            .vet-page .tm-outro p { margin: 14px auto 0; max-width: 640px; color: rgba(255,255,255,.75); font-size: 15.5px; line-height: 1.7; text-align: center; }
            .tm-outro-cta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; align-items: center; }
            .tm-btn-ghost { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 14px 26px; border-radius: 9999px; font-size: 15px; font-weight: 700; background: transparent; color: #fff !important; border: 1.5px solid rgba(255,255,255,.28); transition: border-color .2s, color .2s; }
            .tm-btn-ghost:hover { border-color: var(--ev-accent); color: var(--ev-accent) !important; }

            /* ============ RESPONZIVITA ============ */
            @media (max-width: 1100px) {
                .ev-topbar-nav { gap: 13px; }
                /* textovy odkaz Contact duplikuje zeleny Contact button vedle — na uzkem PC ho schovame, jinak nav dosedne na logo */
                .ev-topbar-nav > a[href$="#kontakt"] { display: none; }
                .ev-topbar-nav a { font-size: 13.5px; white-space: nowrap; }
                .ev-call--topbar > summary { padding: 9px 14px; }
                .tm-card { grid-template-columns: 260px 1fr; gap: 28px; }
                .tm-fact { grid-template-columns: 140px 1fr; }
            }
            @media (max-width: 900px) {
                .tm-card { grid-template-columns: 1fr; gap: 22px; padding: 26px; }
                .tm-card--lead { background: linear-gradient(180deg, rgba(224,242,240,.5) 0%, #fff 150px); }
            }
            @media (max-width: 768px) {
                .ev-container { padding: 0 20px; }
                html { scroll-behavior: auto; }
                .ev-topbar-inner { height: 60px; }
                .ev-topbar-nav { gap: 10px; }
                .ev-topbar-nav a:not(.ev-burger-link):not(.ev-lang-opt) { display: none; }
                .ev-topbar-nav > .ev-call--topbar { display: none; }
                .ev-lang > summary { padding: 7px 11px; font-size: 12.5px; gap: 6px; }
                .ev-lang-panel { min-width: 158px; }
                .ev-burger { display: inline-flex; }
                .ev-topbar-logo { font-size: 17px; }
                .ev-topbar-img { height: 36px; }
                .ev-call-panel { min-width: 230px; max-width: calc(100vw - 32px); }

                .tm-hero { padding: 96px 0 46px; }
                .vet-page .tm-hero h1 { margin-top: 14px; font-size: 27px; }
                .tm-badge { font-size: 11px; padding: 6px 14px; }
                .tm-hero-sub { margin-top: 10px; font-size: 13.5px; padding: 7px 15px; }
                .vet-page .tm-lead { margin-top: 18px; font-size: 14px; line-height: 1.65; }
                .tm-jump { margin-top: 22px; gap: 8px; }
                .tm-jump a { padding: 8px 14px; font-size: 12.5px; }

                .tm-sec { padding: 48px 0; scroll-margin-top: 70px; }
                .tm-sec-head { gap: 12px; margin-bottom: 22px; }
                .tm-sec-head h2 { font-size: 22px; white-space: normal; }
                .tm-sec-line { display: none; }

                .tm-list { gap: 16px; }
                .tm-card { padding: 22px; border-radius: 18px; }
                .tm-head { gap: 13px; }
                .tm-avatar { width: 54px; height: 54px; font-size: 18px; }
                .vet-page .tm-name { font-size: 17.5px; }
                .vet-page .tm-role { font-size: 13px; margin-top: 5px; }
                .vet-page .tm-perex { font-size: 14px; line-height: 1.65; }
                .tm-fact { grid-template-columns: 1fr; gap: 4px; padding: 11px 0; }
                .tm-fact-k { padding-top: 0; font-size: 11px; }
                .tm-fact-v { font-size: 14px; }

                .tm-outro { padding: 52px 0 60px; text-align: center; }
                .tm-outro-icon { width: 56px; height: 56px; margin-bottom: 18px; }
                .vet-page .tm-outro .ev-container { text-align: center; }
                .vet-page .tm-outro h2 { text-align: center; }
                .vet-page .tm-outro p { font-size: 14.5px; max-width: 100%; margin-left: auto; margin-right: auto; text-align: center; text-wrap: balance; }
                .tm-outro-cta { flex-direction: column; width: 100%; max-width: 330px; margin-left: auto; margin-right: auto; }
                .tm-outro-cta > .tm-btn-ghost { width: 100%; }
                .tm-outro-cta > .ev-call { width: 100%; }
                .tm-outro-cta > .ev-call > summary, .tm-outro-cta > a.ev-call { width: 100%; }
                .tm-outro-cta > .ev-call > .ev-call-panel { top: auto; bottom: calc(100% + 10px); left: 0 !important; right: 0 !important; transform: none !important; width: 100%; min-width: 0; max-width: none; }
            }
            @media (max-width: 480px) {
                .ev-container { padding: 0 16px; }
                .tm-card { padding: 20px; }
                .vet-page .tm-hero h1 { font-size: 24px; }
            }

            /* ============ KONTAKTNÍ EMAIL U JMÉNA ============ */
            .tm-mail { margin-top: 11px; display: inline-flex; align-items: center; gap: 7px; background: var(--ev-accent-light); color: var(--ev-accent-dark) !important; padding: 7px 14px; border-radius: 9999px; font-size: 12.5px; font-weight: 600; letter-spacing: .01em; transition: background-color .2s, color .2s, box-shadow .2s; }
            .tm-mail:hover { background: var(--ev-accent); color: #fff !important; box-shadow: 0 8px 18px -8px rgba(91,168,160,.7); }
            .tm-mail svg { flex-shrink: 0; }

            /* ============ AUTORSKÝ KREDIT (patička) — menší, ale výrazný ============ */
            .ev-footer-credit { padding: 18px 24px 20px; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: 0.02em; color: #fff; background: linear-gradient(135deg, var(--ev-primary), var(--ev-primary-dark)); border-top: 3px solid var(--ev-accent); }
            .ev-footer-credit a { color: var(--ev-accent); font-weight: 800; border-bottom: 1.5px solid var(--ev-accent); padding-bottom: 1px; transition: color 0.25s, border-color 0.25s; }
            .ev-footer-credit a:hover { color: #fff; border-color: #fff; }

            /* ============ ODOO EDITOR / PŘEKLAD ============ */
            /* splash je fixed přes celou obrazovku se z-indexem 9999 — v editoru překrývá obsah a nejde klikat do textu */
            body.editor_enable .ev-splash,
            body.editor_has_snippets .ev-splash,
            body.o_translate_mode .ev-splash { display: none !important; }
            /* zavřené details (rozbalovací sekce) skrývají text před editorem i před režimem překladu — v editoru je otevřeme.
               Popupy (.ev-call, .ev-burger, .ev-lang) necháme zavřené, jinak by plavaly přes obsah. */
            body.editor_enable details:not(.ev-call):not(.ev-burger):not(.ev-lang) > *:not(summary),
            body.editor_has_snippets details:not(.ev-call):not(.ev-burger):not(.ev-lang) > *:not(summary),
            body.o_translate_mode details:not(.ev-call):not(.ev-burger):not(.ev-lang) > *:not(summary) { display: block !important; }
            body.editor_enable details:not(.ev-call):not(.ev-burger):not(.ev-lang)::details-content,
            body.editor_has_snippets details:not(.ev-call):not(.ev-burger):not(.ev-lang)::details-content,
            body.o_translate_mode details:not(.ev-call):not(.ev-burger):not(.ev-lang)::details-content { content-visibility: visible !important; }
        </style>

        <!-- pojistka: potlačí neškodnou cross-origin SecurityError (www vs bez www iframe ?iframe_reload) co nejdřív -->
        <script>(function(){function ev_isXO(msg){msg=msg||"";return msg.indexOf("cross-origin frame")>-1||msg.indexOf("named property 'href'")>-1||msg.indexOf("Blocked a frame")>-1;}
        window.addEventListener("error",function(e){if(ev_isXO(e&amp;&amp;e.message)){if(e.stopImmediatePropagation){e.stopImmediatePropagation();}if(e.preventDefault){e.preventDefault();}return false;}},true);
        window.addEventListener("unhandledrejection",function(e){var r=e&amp;&amp;e.reason;var m=(r&amp;&amp;r.message)?r.message:(""+r);if(ev_isXO(m)){if(e.stopImmediatePropagation){e.stopImmediatePropagation();}if(e.preventDefault){e.preventDefault();}return false;}},true);})();</script>

        <div id="wrap" class="oe_structure vet-page">

            <!-- =========================== TOPBAR =========================== -->
            <!-- Horni lista je spolecna pro cely web, viz elite_vet_theme. -->
            <t t-call="elite_vet_theme.vet_header"/>

            <!-- =========================== HERO =========================== -->
            <section id="tym" class="tm-hero o_colored_level">
                <div class="ev-container tm-hero-inner">
                    <div class="tm-badge">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Our team
                    </div>

                    <h1>The team opening our clinic</h1>

                    <div class="tm-hero-sub">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        ELITE VET Karlovy Vary
                    </div>

                    <p class="tm-lead">ELITE VET is being built as a modern veterinary facility whose professional foundation combines clinical practice, specialised training, teamwork and a thorough approach to every patient. At the opening of the clinic the team includes veterinarians experienced in surgery, internal and emergency medicine, ophthalmology, ultrasonography, dentistry and critical patient care; veterinary nurses experienced in everyday clinical operations; client service with a professional veterinary background; and management with direct experience of veterinary practices and running operations.</p>

                    <div class="tm-note">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <path d="M9 12l2 2 4-4"/>
                        </svg>
                        <p>Besides the doctors and staff at our own branch, a number of external specialists and doctors also work with the clinic. The people below make up the <strong>core team responsible for looking after your pets</strong> — and the team keeps growing.</p>
                    </div>

                    <t t-set="tym_ma_model" t-value="'elite.vet.team.section' in request.env"/>
                    <t t-set="tym_sekce" t-value="request.env['elite.vet.team.section'].sudo().search([]) if tym_ma_model else []"/>
                    <div class="tm-jump">
                        <t t-foreach="tym_sekce" t-as="tm_s">
                            <a t-if="tm_s.member_ids" t-attf-href="##{tm_s.anchor}"><span t-field="tm_s.name"></span></a>
                        </t>
                    </div>
                </div>
            </section>

            <t t-foreach="tym_sekce" t-as="tm_s">
                <t t-if="tm_s.member_ids">
                    <section t-att-id="tm_s.anchor" t-attf-class="tm-sec#{' tm-sec--alt' if tm_s_index % 2 == 1 else ''} o_colored_level">
                        <div class="ev-container">
                            <div class="tm-sec-head">
                                <h2><span t-field="tm_s.name"></span></h2>
                                <span class="tm-sec-line"></span>
                            </div>

                            <div class="tm-list">
                                <t t-foreach="tm_s.member_ids" t-as="tm_m">
                                    <article t-attf-class="tm-card#{' tm-card--lead' if tm_m.highlight else ''}">
                                        <div class="tm-card-main">
                                            <div class="tm-head">
                                                <t t-if="tm_m.has_image">
                                                    <input type="checkbox" class="tm-zoom-toggle" t-attf-id="evzoom-#{tm_m.id}" aria-hidden="true" tabindex="-1"/>
                                                    <label class="tm-zoom-open" t-attf-for="evzoom-#{tm_m.id}" t-attf-title="Enlarge photo: #{tm_m.name}">
