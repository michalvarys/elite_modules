            <!-- =========================== AUTORSKÝ KREDIT =========================== -->
            <t t-call="elite_vet_theme.vet_footer"/>

        </div>

        <script>
            /* potlačí neškodnou Odoo chybu SecurityError při čtení cross-origin iframu (Google Analytics / Maps apod.) */
            window.addEventListener('error', function (e) {
                var m = (e &amp;&amp; e.message) ? e.message : '';
                if (m.indexOf('cross-origin frame') > -1 || m.indexOf("named property 'href'") > -1) {
                    if (e.stopImmediatePropagation) { e.stopImmediatePropagation(); }
                    if (e.preventDefault) { e.preventDefault(); }
                    return false;
                }
            }, true);

            /* zavřít popup po kliknutí na odkaz uvnitř */
            document.addEventListener('click', function (e) {
                var link = e.target.closest('details a');
                if (!link) return;
                var d = link.closest('details');
                if (d) d.open = false;
            });

            /* horní lišta: schovat při scrollu dolů, ukázat při scrollu nahoru */
            (function () {
                var ua = navigator.userAgent || '';
                if (/Instagram|FBAN|FBAV|FB_IAB|Messenger|MicroMessenger|Snapchat|Pinterest/i.test(ua)) { return; }
                var nav = document.querySelector('.ev-topbar');
                if (!nav) { return; }
                var lastY = window.pageYOffset || 0;
                var ticking = false;
                function closeMenus() {
                    var open = nav.querySelectorAll('details[open]');
                    for (var i = 0; i &lt; open.length; i++) { open[i].open = false; }
                }
                function navScroll() {
                    var y = window.pageYOffset || 0;
                    if (y > lastY + 4) {
                        if (y > 90) { nav.classList.add('ev-nav-hidden'); closeMenus(); }
                        lastY = y;
                    } else if (lastY - 4 > y) {
                        nav.classList.remove('ev-nav-hidden');
                        lastY = y;
                    }
                    ticking = false;
                }
                window.addEventListener('scroll', function () {
                    if (ticking === false) { ticking = true; window.requestAnimationFrame(navScroll); }
                }, { passive: true });
            })();
        </script>
    </t>
    </template>

