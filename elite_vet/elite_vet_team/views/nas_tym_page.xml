                                                             t-att-alt="tm_m.name" loading="lazy"/>
                                                    </label>
                                                    <label class="tm-zoom-overlay" t-attf-for="evzoom-#{tm_m.id}" aria-label="Close">
                                                        <img class="tm-zoom-img"
                                                             t-attf-src="/web/image/elite.vet.team.member/#{tm_m.id}/image_1024?unique=#{tm_m.write_date}"
                                                             t-att-alt="tm_m.name" loading="lazy"/>
                                                        <span class="tm-zoom-name"><t t-esc="tm_m.name"/></span>
                                                    </label>
                                                </t>
                                                <div t-if="not tm_m.has_image" class="tm-avatar"><t t-esc="tm_m.initials"/></div>
                                                <div>
                                                    <h3 class="tm-name"><t t-esc="tm_m.name"/></h3>
                                                    <p t-if="tm_m.role" class="tm-role"><span t-field="tm_m.role"></span></p>
                                                    <a t-if="tm_m.email" t-attf-href="mailto:#{tm_m.email}" class="tm-mail" t-attf-aria-label="Email: #{tm_m.email}">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                                                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                                        </svg>
                                                        <t t-esc="tm_m.email"/>
                                                    </a>
                                                </div>
                                            </div>
                                            <span t-if="tm_m.badge" class="tm-tag">
                                                <!-- kdyz si klinika vybrala ikonu, pouzije se; jinak zustava fajfka jako doted -->
                                                <t t-if="tm_m.badge_icon_id">
                                                    <t t-call="elite_vet_team.specialization_icon">
