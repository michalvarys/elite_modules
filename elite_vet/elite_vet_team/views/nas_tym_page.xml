                                            </div>
                                            <p t-if="tm_m.perex" class="tm-perex"><span t-field="tm_m.perex"></span></p>
                                        </div>
                                        <details t-if="tm_m.fact_ids.filtered(lambda f: f.value)" class="tm-more">
