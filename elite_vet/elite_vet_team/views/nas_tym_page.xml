                                                        <t t-set="ev_size" t-value="16"/>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="20 6 9 17 4 12"/>
                                                    </svg>
                                                </t>
                                                <span t-field="tm_m.badge"></span>
                                            </span>
                                            <div t-if="tm_m.specialization_ids" class="tm-specs">
                                                <t t-foreach="tm_m.specialization_ids" t-as="tm_s">
                                                    <span class="tm-spec">
                                                        <t t-call="elite_vet_team.specialization_icon">
                                                            <t t-set="ev_icon_rec" t-value="tm_s.icon_id"/>
                                                            <t t-set="ev_size" t-value="22"/>
                                                        </t>
                                                        <span t-field="tm_s.name"></span>
                                                    </span>
