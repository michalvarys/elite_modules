<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Verejna stranka /nas-tym. Obsah se cely bere z aplikace Nas tym
        (sekce, lide, podrobnosti), takze se do tohohle souboru nesaha, kdyz
        nekdo prijde nebo odejde. Design zustal stejny jako u puvodni rucni
        stranky.
    -->
    <template id="nas_tym" name="Our team">
    <t t-call="website.layout">
        <!-- Adresa teze stranky v kazdem jazyce. Prepinac na ne vede primo,
             protoze pres /website/lang/ to stoji na cookie frontend_lang a ten
             in-app prohlizec Instagramu a Facebooku neposila tak, jak Odoo ceka.
             Cestina je vychozi jazyk a na "/" vraci url_for prazdno, proto "/". -->
        <t t-set="ev_jazyk_cs" t-value="('%s' % url_for(request.httprequest.path, lang_code='cs_CZ')) or '/'"/>
        <t t-set="ev_jazyk_de" t-value="('%s' % url_for(request.httprequest.path, lang_code='de_DE')) or '/'"/>
        <t t-set="ev_jazyk_en" t-value="('%s' % url_for(request.httprequest.path, lang_code='en_US')) or '/'"/>
        <t t-set="ev_jazyk_ru" t-value="('%s' % url_for(request.httprequest.path, lang_code='ru_RU')) or '/'"/>
            <t t-set="ev_web" t-value="request.env['elite.vet.setting'].sudo().nastaveni() if 'elite.vet.setting' in request.env else None"/>
        <t t-set="no_header" t-value="true"/>
        <t t-set="no_footer" t-value="true"/>
        <t t-set="additional_title">Our team | Elite Vet Karlovy Vary</t>
        <t t-set="meta_description">The team opening the Elite Vet veterinary clinic in Karlovy Vary — veterinarians, veterinary nurses, client service and management. Education, experience, specialisation and languages of the whole team.</t>
        <meta name="theme-color" content="#1a2744"/>

        <!-- Styly stranky jsou v CSS souboru modulu, spolecne v elite_vet_theme. -->
        <t t-set="head">
            <t t-call-assets="elite_vet_team.stranka_nas_tym" t-js="false"/>
        </t>

        <!-- pojistka: potlačí neškodnou cross-origin SecurityError (www vs bez www iframe ?iframe_reload) co nejdřív -->
        <script>(function(){function ev_isXO(msg){msg=msg||"";return msg.indexOf("cross-origin frame")>-1||msg.indexOf("named property 'href'")>-1||msg.indexOf("Blocked a frame")>-1;}
        window.addEventListener("error",function(e){if(ev_isXO(e&amp;&amp;e.message)){if(e.stopImmediatePropagation){e.stopImmediatePropagation();}if(e.preventDefault){e.preventDefault();}return false;}},true);
        window.addEventListener("unhandledrejection",function(e){var r=e&amp;&amp;e.reason;var m=(r&amp;&amp;r.message)?r.message:(""+r);if(ev_isXO(m)){if(e.stopImmediatePropagation){e.stopImmediatePropagation();}if(e.preventDefault){e.preventDefault();}return false;}},true);})();</script>

        <div id="wrap" class="oe_structure vet-page">

            <!-- =========================== TOPBAR =========================== -->
            <!-- Horni lista je spolecna pro cely web, viz elite_vet_theme. -->
            <t t-call="elite_vet_theme.vet_header"/>

            <!-- =========================== HERO =========================== -->
            <section id="tym" class="tm-hero o_colored_level">
                <div class="ev-container tm-hero-inner">
                    <div class="tm-badge">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        Our team
                    </div>

                    <h1>The team opening our clinic</h1>

                    <div class="tm-hero-sub">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                        ELITE VET Karlovy Vary
                    </div>

                    <p class="tm-lead">ELITE VET is being built as a modern veterinary facility whose professional foundation combines clinical practice, specialised training, teamwork and a thorough approach to every patient. At the opening of the clinic the team includes veterinarians experienced in surgery, internal and emergency medicine, ophthalmology, ultrasonography, dentistry and critical patient care; veterinary nurses experienced in everyday clinical operations; client service with a professional veterinary background; and management with direct experience of veterinary practices and running operations.</p>

                    <div class="tm-note">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <path d="M9 12l2 2 4-4"/>
                        </svg>
                        <p>Besides the doctors and staff at our own branch, a number of external specialists and doctors also work with the clinic. The people below make up the <strong>core team responsible for looking after your pets</strong> — and the team keeps growing.</p>
                    </div>

                    <t t-set="tym_ma_model" t-value="'elite.vet.team.section' in request.env"/>
                    <t t-set="tym_sekce" t-value="request.env['elite.vet.team.section'].sudo().search([]) if tym_ma_model else []"/>
                    <div class="tm-jump">
                        <t t-foreach="tym_sekce" t-as="tm_s">
                            <a t-if="tm_s.member_ids" t-attf-href="##{tm_s.anchor}"><span t-field="tm_s.name"></span></a>
                        </t>
                    </div>
                </div>
            </section>

            <t t-foreach="tym_sekce" t-as="tm_s">
                <t t-if="tm_s.member_ids">
                    <section t-att-id="tm_s.anchor" t-attf-class="tm-sec#{' tm-sec--alt' if tm_s_index % 2 == 1 else ''} o_colored_level">
                        <div class="ev-container">
                            <div class="tm-sec-head">
                                <h2><span t-field="tm_s.name"></span></h2>
                                <span class="tm-sec-line"></span>
                            </div>

                            <div class="tm-list">
                                <t t-foreach="tm_s.member_ids" t-as="tm_m">
                                    <article t-attf-class="tm-card#{' tm-card--lead' if tm_m.highlight else ''}">
                                        <div class="tm-card-main">
                                            <div class="tm-head">
                                                <t t-if="tm_m.has_image">
                                                    <input type="checkbox" class="tm-zoom-toggle" t-attf-id="evzoom-#{tm_m.id}" aria-hidden="true" tabindex="-1"/>
                                                    <label class="tm-zoom-open" t-attf-for="evzoom-#{tm_m.id}" t-attf-title="Enlarge photo: #{tm_m.name}">
                                                        <img class="tm-avatar tm-avatar--photo"
                                                             t-attf-src="/web/image/elite.vet.team.member/#{tm_m.id}/image_128?unique=#{tm_m.write_date}"
                                                             t-att-alt="tm_m.name" loading="lazy"/>
                                                    </label>
                                                    <label class="tm-zoom-overlay" t-attf-for="evzoom-#{tm_m.id}" aria-label="Close">
                                                        <img class="tm-zoom-img"
                                                             t-attf-src="/web/image/elite.vet.team.member/#{tm_m.id}/image_1024?unique=#{tm_m.write_date}"
                                                             t-att-alt="tm_m.name" loading="lazy"/>
                                                        <span class="tm-zoom-name"><t t-esc="tm_m.name"/></span>
                                                    </label>
                                                </t>
                                                <div t-if="not tm_m.has_image" class="tm-avatar"><t t-esc="tm_m.initials"/></div>
                                                <div>
                                                    <h3 class="tm-name"><t t-esc="tm_m.name"/></h3>
                                                    <p t-if="tm_m.role" class="tm-role"><span t-field="tm_m.role"></span></p>
                                                    <a t-if="tm_m.email" t-attf-href="mailto:#{tm_m.email}" class="tm-mail" t-attf-aria-label="Email: #{tm_m.email}">
                                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                                                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                                        </svg>
                                                        <t t-esc="tm_m.email"/>
                                                    </a>
                                                </div>
                                            </div>
                                            <span t-if="tm_m.badge" class="tm-tag">
                                                <!-- kdyz si klinika vybrala ikonu, pouzije se; jinak zustava fajfka jako doted -->
                                                <t t-if="tm_m.badge_icon_id">
                                                    <t t-call="elite_vet_team.specialization_icon">
                                                        <t t-set="ev_icon_rec" t-value="tm_m.badge_icon_id"/>
                                                        <t t-set="ev_size" t-value="16"/>
                                                    </t>
                                                </t>
                                                <t t-else="">
                                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <polyline points="20 6 9 17 4 12"/>
                                                    </svg>
                                                </t>
                                                <span t-field="tm_m.badge"></span>
                                            </span>
                                            <div t-if="tm_m.specialization_ids" class="tm-specs">
                                                <t t-foreach="tm_m.specialization_ids" t-as="tm_s">
                                                    <span class="tm-spec">
                                                        <t t-call="elite_vet_team.specialization_icon">
                                                            <t t-set="ev_icon_rec" t-value="tm_s.icon_id"/>
                                                            <t t-set="ev_size" t-value="22"/>
                                                        </t>
                                                        <span t-field="tm_s.name"></span>
                                                    </span>
                                                </t>
                                            </div>
                                            <p t-if="tm_m.perex" class="tm-perex"><span t-field="tm_m.perex"></span></p>
                                        </div>
                                        <details t-if="tm_m.fact_ids.filtered(lambda f: f.value)" class="tm-more">
                                            <summary>
                                                Education, experience and specialisation
                                                <svg class="tm-more-chevron" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                            </summary>
                                            <div class="tm-facts">
                                                <t t-foreach="tm_m.fact_ids.filtered(lambda f: f.value)" t-as="tm_f">
                                                    <div class="tm-fact">
                                                        <div class="tm-fact-k"><span t-field="tm_f.label_id.name"></span></div>
                                                        <div class="tm-fact-v"><span t-field="tm_f.value"></span></div>
                                                    </div>
                                                </t>
                                            </div>
                                        </details>
                                    </article>
                                </t>
                            </div>
                        </div>
                    </section>
                </t>
            </t>

            <!-- =========================== ZÁVĚR =========================== -->
            <section class="tm-outro o_colored_level">
                <div class="ev-container">
                    <div class="tm-outro-icon">
                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <line x1="19" y1="8" x2="19" y2="14"/>
                            <line x1="22" y1="11" x2="16" y2="11"/>
                        </svg>
                    </div>
                    <h2>The team keeps growing</h2>
                    <p>We keep adding more doctors and specialist staff to the clinic's team. We are looking for colleagues to join our newly forming team — from experienced vets to fresh graduates.</p>
                    <div class="tm-outro-cta">
                        <a t-attf-href="tel:#{(ev_web.hr_phone if ev_web else False) or (ev_web.phone if ev_web else False) or '+420728549095'}" class="ev-call ev-call--outro">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                            </svg>
                            Recruitment contact
                        </a>
                        <a t-attf-href="mailto:#{(ev_web.hr_email if ev_web else False) or (ev_web.email if ev_web else False) or 'info@elite-vet.cz'}?subject=Zájem o pozici v Elite Vet Karlovy Vary" class="tm-btn-ghost">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="4" width="20" height="16" rx="2"/>
                                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                            </svg>
                            Send your CV
                        </a>
                    </div>
                </div>
            </section>

            <!-- =========================== AUTORSKÝ KREDIT =========================== -->
            <t t-call="elite_vet_theme.vet_footer"/>

        </div>

        <script>
            /* potlačí neškodnou Odoo chybu SecurityError při čtení cross-origin iframu (Google Analytics / Maps apod.) */
            window.addEventListener('error', function (e) {
                var m = (e &amp;&amp; e.message) ? e.message : '';
                if (m.indexOf('cross-origin frame') > -1 || m.indexOf("named property 'href'") > -1) {
                    if (e.stopImmediatePropagation) { e.stopImmediatePropagation(); }
                    if (e.preventDefault) { e.preventDefault(); }
                    return false;
                }
            }, true);

            /* zavřít popup po kliknutí na odkaz uvnitř */
            document.addEventListener('click', function (e) {
                var link = e.target.closest('details a');
                if (!link) return;
                var d = link.closest('details');
                if (d) d.open = false;
            });

            /* horní lišta: schovat při scrollu dolů, ukázat při scrollu nahoru */
            (function () {
                var ua = navigator.userAgent || '';
                if (/Instagram|FBAN|FBAV|FB_IAB|Messenger|MicroMessenger|Snapchat|Pinterest/i.test(ua)) { return; }
                var nav = document.querySelector('.ev-topbar');
                if (!nav) { return; }
                var lastY = window.pageYOffset || 0;
                var ticking = false;
                function closeMenus() {
                    var open = nav.querySelectorAll('details[open]');
                    for (var i = 0; i &lt; open.length; i++) { open[i].open = false; }
                }
                function navScroll() {
                    var y = window.pageYOffset || 0;
                    if (y > lastY + 4) {
                        if (y > 90) { nav.classList.add('ev-nav-hidden'); closeMenus(); }
                        lastY = y;
                    } else if (lastY - 4 > y) {
                        nav.classList.remove('ev-nav-hidden');
                        lastY = y;
                    }
                    ticking = false;
                }
                window.addEventListener('scroll', function () {
                    if (ticking === false) { ticking = true; window.requestAnimationFrame(navScroll); }
                }, { passive: true });
            })();
        </script>
    </t>
    </template>

    <record id="nas_tym_page" model="website.page">
        <field name="name">Our team</field>
        <field name="url">/nas-tym</field>
        <field name="view_id" ref="nas_tym"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>
</odoo>
