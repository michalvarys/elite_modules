<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_team_specialization_list" model="ir.ui.view">
        <field name="name">elite.vet.team.specialization.list</field>
        <field name="model">elite.vet.team.specialization</field>
        <field name="arch" type="xml">
            <list string="Specializace" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon_image" widget="image" options="{'size': [28, 28]}" string=""/>
                <field name="name"/>
                <field name="icon_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_team_specialization_form" model="ir.ui.view">
        <field name="name">elite.vet.team.specialization.form</field>
        <field name="model">elite.vet.team.specialization</field>
        <field name="arch" type="xml">
            <form string="Specializace">
                <sheet>
                    <widget name="web_ribbon" title="Archivováno" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Stomatologie"/></h1>
                    </div>
                    <field name="icon_image" widget="image" class="oe_avatar"/>
                    <group>
                        <group>
                            <field name="icon_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Kdo ji má">
                        <field name="member_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_team_specialization" model="ir.actions.act_window">
        <field name="name">Specializace</field>
        <field name="res_model">elite.vet.team.specialization</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Přidejte první specializaci</p>
            <p>
                Specializace se lékaři zobrazí na kartě jako štítek s ikonou.
                V rozpisu služeb se u jména ukáže jen samotná ikona.
            </p>
        </field>
    </record>
</odoo>
