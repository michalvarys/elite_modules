<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Vlastni stavebni bloky kliniky. Objevi se v editoru v sekci "Elite Vet"
        a daji se pretahovat do volnych mist na strance (zony s id, ktere
        obsahuje "oe_structure" — bez nich Odoo bloky nema kam pustit).

        Obsah bloku je bezne HTML, takze se po pretazeni prepisuje primo
        v editoru a uklada se do stranky. Zadne pole v adminu k tomu netreba.

        Vzhled ramecku (.ev-hero-note) je ve stylu hlavicky v layout.xml —
        ta se vykresluje na kazde strance, takze blok vypada stejne, at ho
        nekdo pretahne kamkoliv.
    -->

    <!-- Ramecek s poznamkou — napriklad o priplatcich mimo ordinacni dobu. -->
    <!-- Korenem bloku musi byt <section>. Do volnych mist (oe_structure) pousti
         Odoo jen sekce; s korenovym <div> zustane blok v panelu sedy. -->
    <template id="s_vet_note" name="Elite Vet: rámeček s poznámkou">
        <section class="s_vet_note">
            <div class="ev-hero-note">
                <div class="ev-hero-note-in">
                    <p><strong>Nadpis poznámky</strong> — sem napište, co má návštěvník vědět.</p>
                    <p>Druhý řádek můžete smazat, nebo do něj vložit <a href="/cenik">odkaz</a>.</p>
                </div>
            </div>
        </section>
    </template>

    <!-- Zarazeni do panelu bloku. -->
    <template id="ev_snippets_registry" name="Elite Vet Snippets" inherit_id="website.snippets">
        <xpath expr="//snippets[@id='snippet_content']" position="after">
            <snippets id="ev_snippets" string="Elite Vet">
                <t t-snippet="elite_vet_theme.s_vet_letak" string="Leták s otevírací dobou"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_letak.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_o_klinice" string="O klinice"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_o_klinice.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_sluzby" string="Služby"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_sluzby.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_tym" string="Pozvánka na tým"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_tym.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_kontakt" string="Kontakt a hodiny"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_kontakt.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_objednat" string="Tlačítko Objednat se"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_objednat.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_nadpis" string="Nadpis"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_nadpis.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_text" string="Text"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_text.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_oznameni" string="Banner"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_oznameni.svg"/>
                <t t-snippet="elite_vet_theme.s_vet_note" string="Rámeček s poznámkou"
                   t-thumbnail="/elite_vet_theme/static/src/img/snippets/s_vet_note.svg"/>
            </snippets>
        </xpath>
    </template>

</odoo>
