<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Spolecna hlavicka a paticka. Obe sablony jsou samostatne: dotahnou si
        nastaveni i kontakty samy, takze je muze zavolat kterakoliv stranka
        z kterehokoliv modulu kliniky bez pripravy promennych.

        Zbytek vzhledu hlavicky (tridy ev-topbar*, ev-burger*, ev-lang*) je
        popsany ve stylu kazde stranky; tady je jen to, co k hlavicce pribylo
        s dvouurovnovym menu.
    -->

    <!-- =========================== HLAVICKA =========================== -->
    <template id="vet_header" name="Elite Vet: horní lišta">
        <!-- Prepinac jazyku odkazuje primo na /cs, /de, /en, /ru. Cesta pres
             /website/lang/ stoji na cookie frontend_lang a ta v prohlizeci uvnitr
             Instagramu ani Facebooku neprojde — jazyk by se neprepnul.
             data-no-post-process brani Odoo prepsat adresu na prazdny retezec. -->
        <t t-set="ev_h_web" t-value="request.env['elite.vet.setting'].sudo().nastaveni() if 'elite.vet.setting' in request.env else False"/>
        <t t-set="ev_h_cs" t-value="('%s' % url_for(request.httprequest.path, lang_code='cs_CZ')) or '/'"/>
        <t t-set="ev_h_de" t-value="('%s' % url_for(request.httprequest.path, lang_code='de_DE')) or '/'"/>
        <t t-set="ev_h_en" t-value="('%s' % url_for(request.httprequest.path, lang_code='en_US')) or '/'"/>
        <t t-set="ev_h_ru" t-value="('%s' % url_for(request.httprequest.path, lang_code='ru_RU')) or '/'"/>


        <div class="ev-topbar">
            <div class="ev-container ev-topbar-inner">
                <!-- Logo vede na domovskou stranku, a to ve stejnem jazyce, v jakem
                     je navstevnik. Holy href="/" nestaci: Odoo adresy pri vykresleni
                     prepisuje a na vychozim jazyce z nej udela prazdny retezec —
                     na klik se pak nestane nic. data-no-post-process to zakazuje.
                     Drive tu byla dokonce kotva #odpocet, ktera mimo domovskou
                     stranku nevedla nikam. -->
                <t t-set="ev_h_domu" t-value="('%s' % url_for('/')) or '/'"/>
                <a data-no-post-process="1" t-att-href="ev_h_domu" class="ev-topbar-logo">
                    <img src="/elite_vet_web/static/src/img/logo.jpeg" alt="Elite Vet" class="ev-topbar-img" loading="lazy"/>
                    <span class="ev-logo-brand" style="display: inline-block; white-space: nowrap;"><span style="color: #1a2744 !important;">Elite</span><span style="color: #2b7870 !important;">Vet</span></span>
                </a>
                <nav class="ev-topbar-nav">
                    <!-- Polozky navigace se berou z menu webu (Odoo: Web -> Upravit -> Menu),
                         takze se daji menit bez zasahu do kodu stranky. -->

                    <t t-set="ev_path" t-value="request.httprequest.path"/>
                    <t t-foreach="website.menu_id.child_id.filtered(lambda m: m.is_visible)" t-as="ev_m">
                        <t t-set="ev_kids" t-value="ev_m.child_id.filtered(lambda m: m.is_visible)"/>

                        <!-- Polozka se submenu -->
                        <details t-if="ev_kids" name="ev-nav" t-attf-class="ev-nav-drop #{'ev-nav-active' if ev_path in ev_kids.mapped('url') + [ev_m.url] else ''}">
                            <summary>
                                <span t-field="ev_m.name"/>
                                <svg class="ev-nav-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="6 9 12 15 18 9"/>
                                </svg>
                            </summary>
                            <div class="ev-nav-panel">
                                <a t-if="ev_m.url and ev_m.url not in ('#', '/#')" t-att-href="ev_m.url" t-attf-class="ev-nav-opt #{'is-active' if ev_m.url == ev_path else ''}">
                                    <span t-field="ev_m.name"/>
                                </a>
                                <t t-foreach="ev_kids" t-as="ev_k">
                                    <a t-att-href="ev_k.url" t-attf-class="ev-nav-opt #{'is-active' if ev_k.url == ev_path else ''}" t-att-target="'_blank' if '://' in ev_k.url else False" t-att-rel="'noopener' if '://' in ev_k.url else False"><span t-field="ev_k.name"/></a>
                                </t>
                            </div>
                        </details>

                        <!-- Bezna polozka -->
                        <a t-else="" t-att-href="ev_m.url" t-attf-class="#{'ev-nav-active' if ev_m.url == ev_path else ''}" t-att-target="'_blank' if '://' in ev_m.url else False" t-att-rel="'noopener' if '://' in ev_m.url else False"><span t-field="ev_m.name"/></a>
                    </t>
                    <details class="ev-lang">
                        <summary>
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M2 12h20"/>
                                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                            </svg>
                            <span class="ev-lang-code ev-lang-code-cs">CZ</span><span class="ev-lang-code ev-lang-code-de">DE</span><span class="ev-lang-code ev-lang-code-en">EN</span><span class="ev-lang-code ev-lang-code-ru">RU</span>
                            <svg class="ev-lang-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </summary>
                        <div class="ev-lang-panel">
                            <a data-no-post-process="1" t-att-href="ev_h_cs" t-attf-class="ev-lang-opt{{ ' is-active' if request.env.lang == 'cs_CZ' else '' }}">Čeština</a>
                            <a data-no-post-process="1" t-att-href="ev_h_de" t-attf-class="ev-lang-opt{{ ' is-active' if request.env.lang == 'de_DE' else '' }}">Deutsch</a>
                            <a data-no-post-process="1" t-att-href="ev_h_en" t-attf-class="ev-lang-opt{{ ' is-active' if request.env.lang == 'en_US' else '' }}">English</a>
                            <a data-no-post-process="1" t-att-href="ev_h_ru" t-attf-class="ev-lang-opt{{ ' is-active' if request.env.lang == 'ru_RU' else '' }}">Русский</a>
                        </div>
                    </details>
                    <a t-attf-href="tel:#{ev_h_web.phone if ev_h_web and ev_h_web.phone else '+420722599699'}" class="ev-call ev-call--topbar">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                        Contact
                    </a>
                    <details class="ev-burger">
                        <summary aria-label="Menu">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="3" y1="6" x2="21" y2="6"/>
                                <line x1="3" y1="12" x2="21" y2="12"/>
                                <line x1="3" y1="18" x2="21" y2="18"/>
                            </svg>
                        </summary>
                        <div class="ev-burger-panel">
                            <t t-foreach="website.menu_id.child_id.filtered(lambda m: m.is_visible)" t-as="ev_m">
                                <t t-set="ev_kids" t-value="ev_m.child_id.filtered(lambda m: m.is_visible)"/>

                                <!-- Skupina se sama otevre, kdyz jsi na nektere z jejich stranek. -->
                                <details t-if="ev_kids" class="ev-burger-group" t-att-open="'open' if ev_path in ev_kids.mapped('url') + [ev_m.url] else None">
                                    <summary class="ev-burger-link">
                                        <svg class="ev-burger-caret" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="9 18 15 12 9 6"/>
                                        </svg>
                                        <span t-field="ev_m.name"/>
                                    </summary>
                                    <div class="ev-burger-sub">
                                        <a t-if="ev_m.url and ev_m.url not in ('#', '/#')" t-att-href="ev_m.url" class="ev-burger-sublink">
                                            <span t-field="ev_m.name"/>
                                        </a>
                                        <t t-foreach="ev_kids" t-as="ev_k">
                                            <a t-att-href="ev_k.url" class="ev-burger-sublink" t-att-target="'_blank' if '://' in ev_k.url else False" t-att-rel="'noopener' if '://' in ev_k.url else False"><span t-field="ev_k.name"/></a>
                                        </t>
                                    </div>
                                </details>

                                <a t-else="" t-att-href="ev_m.url" class="ev-burger-link" t-att-target="'_blank' if '://' in ev_m.url else False" t-att-rel="'noopener' if '://' in ev_m.url else False">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"/>
                                    </svg>
                                    <span t-field="ev_m.name"/>
                                </a>
                            </t>
                        </div>
                    </details>
                </nav>
            </div>
        </div>
    </template>

    <!-- =========================== PATICKA =========================== -->
    <!-- Paticka je jen autorsky kredit. Trisloupcovy blok (znacka, navigace,
         kontakt) na webu nikdy nebyl a byl na zadost odstranen. -->
    <template id="vet_footer" name="Elite Vet: patička">

        <div class="ev-footer-credit">Created <a href="https://www.michalvarys.eu/chytil-jste-se-do-site" target="_blank" rel="noopener">Michal Varys</a> · runs on <a href="https://www.varyshop.cz/jak-vypada-nas-system" target="_blank" rel="noopener">Varyshop</a></div>
    </template>

</odoo>
