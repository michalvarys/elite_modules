<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Oznamovaci pruh pres celou sirku. Klinika do nej pise, ze se neco deje —
        zmena ordinacnich hodin, dovolena, mimoradna akce.

        Blikajici tecka rekne na prvni pohled "tohle je ted aktualni". Kdo ma
        v systemu vypnute animace, vidi ji staticky.

        Barvy stoji na dvou promennych, ktere dedi cely pruh:
            oznam-cara    tecka a linky nad a pod pruhem,
            oznam-pozadi  pozadi pruhu.
        Diky tomu staci v bocnim panelu vybrat jednu barvu a prebarvi se
        tecka i linky zaroven.
    -->
    <template id="s_vet_oznameni" name="Elite Vet: banner">
        <section class="s_vet_oznameni ev-oznam ev-oznam--info o_cc o_cc2">
            <div class="ev-oznam-in">
                <span class="ev-oznam-tecka"></span>
                <div class="ev-oznam-text">
                    <p><strong>Something is happening</strong> — write here what clients should know.</p>
                </div>
            </div>
        </section>
    </template>

    <!--
        Volby v bocnim panelu. Pripravene varianty meni tridu, vlastni barva
        zapisuje primo promennou do stylu prvku — a ta prebije tridu, takze
        obe cesty muzou existovat vedle sebe.
    -->
    <template id="snippet_options_vet_oznameni" inherit_id="website.snippet_options">
        <xpath expr="//div[@data-js='ContainerWidth']" position="before">
            <div data-selector=".s_vet_oznameni">
                <we-select string="Připravené barvy">
                    <we-button data-select-class="ev-oznam--info">Modrý</we-button>
                    <we-button data-select-class="ev-oznam--uspech">Zelený</we-button>
                    <we-button data-select-class="ev-oznam--pozor">Oranžový</we-button>
                    <we-button data-select-class="ev-oznam--dulezite">Červený</we-button>
                    <we-button data-select-class="ev-oznam--tmavy">Tmavý</we-button>
                </we-select>

                <!-- Jedna barva pro tecku i linky. Zapisuje se do promenne
                     oznam-cara, ze ktere obe veci cerpaji. -->
                <we-colorpicker string="Barva tečky a linek"
                                data-select-style="true"
                                data-css-property="--oznam-cara"/>

                <we-colorpicker string="Barva pozadí"
                                data-select-style="true"
                                data-css-property="--oznam-pozadi"/>

                <!-- Zaskrtnute = trida se prida, proto jsou popisky "schovat". -->
                <we-checkbox string="Schovat linky nad a pod"
                             data-select-class="ev-oznam--bez-car"
                             data-no-preview="true"/>
                <we-checkbox string="Schovat tečku"
                             data-select-class="ev-oznam--bez-tecky"
                             data-no-preview="true"/>
            </div>
        </xpath>
    </template>

</odoo>
