#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We have built a modern clinic for <span class=\"ev-accent-text\">your pets</span>"
msgstr "Wir haben eine moderne Klinik für <span class=\"ev-accent-text\">Ihre Lieblinge</span> gebaut"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We have built a modern veterinary clinic in Karlovy Vary for you — a long-term project with the goal of offering comprehensive veterinary care in the region, all in one place."
msgstr "Wir haben für Sie eine moderne Tierklinik in Karlovy Vary gebaut — ein langfristiges Projekt mit dem Ziel, in der Region umfassende tierärztliche Versorgung an einem Ort anzubieten."

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "The clinic is equipped with modern diagnostic and treatment technology and from the outset offers extended opening hours including weekends. We will gradually extend our operation further."
msgstr "Die Klinik ist mit moderner Diagnose- und Behandlungstechnik ausgestattet und bietet von Anfang an erweiterte Öffnungszeiten inklusive Wochenenden. Den Betrieb werden wir schrittweise weiter ausbauen."

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Modern equipment"
msgstr "Moderne Ausstattung"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Gentle handling"
msgstr "Schonender Umgang"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Individual approach"
msgstr "Individueller Ansatz"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Complex care"
msgstr "Komplexe Versorgung"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Reception of the Elite Vet veterinary clinic in Karlovy Vary"
msgstr "Rezeption der Tierklinik Elite Vet in Karlovy Vary"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We are here for you every day"
msgstr "Wir sind jeden Tag für Sie da"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We are in full operation — <span>sat – sun</span> <span>10:00 – 18:00</span>. Book online or by phone at the reception."
msgstr "Wir sind im vollen Betrieb — <span>sa – so</span> <span>10:00 – 18:00</span>. Termine online oder telefonisch an der Rezeption."

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Call the reception<br/>"
msgstr "Rezeption anrufen<br/>"

