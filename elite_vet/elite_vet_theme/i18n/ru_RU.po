#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "About the clinic"
msgstr "О клинике"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We have built a modern clinic for <span class=\"ev-accent-text\">your pets</span>"
msgstr "Мы построили современную клинику для <span class=\"ev-accent-text\">ваших питомцев</span>"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We have built a modern veterinary clinic in Karlovy Vary for you — a long-term project with the goal of offering comprehensive veterinary care in the region, all in one place."
msgstr "Мы построили для вас современную ветеринарную клинику в Карловых Варах — долгосрочный проект с целью предложить в регионе комплексную ветеринарную помощь в одном месте."

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "The clinic is equipped with modern diagnostic and treatment technology and from the outset offers extended opening hours including weekends. We will gradually extend our operation further."
msgstr "Клиника оснащена современными диагностическими и лечебными технологиями и с самого начала предлагает расширенные часы работы, включая выходные. Работу мы будем постепенно расширять."

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Modern equipment"
msgstr "Современное оборудование"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Gentle handling"
msgstr "Бережное обращение"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Individual approach"
msgstr "Индивидуальный подход"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Complex care"
msgstr "Комплексный уход"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Reception of the Elite Vet veterinary clinic in Karlovy Vary"
msgstr "Ресепшн ветеринарной клиники Elite Vet в Карловых Варах"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We are here for you every day"
msgstr "Мы работаем для вас каждый день"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "We are in full operation — <span>sat – sun</span> <span>10:00 – 18:00</span>. Book online or by phone at the reception."
msgstr "Клиника работает в полном режиме — <span>сб – вс</span> <span>10:00 – 18:00</span>. Записаться можно онлайн или по телефону на ресепшене."

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
msgid "Call the reception<br/>"
msgstr "Позвонить на ресепшн<br/>"

#. module: elite_vet_theme
#: model_terms:ir.ui.view,arch_db:elite_vet_theme.s_vet_o_klinice
