#. module: elite_vet_reservation
#. odoo-python
#: code:addons/elite_vet_reservation/models/doctor_assignment.py:0
msgid "%(doctor)s už v tu dobu slouží v ordinaci %(room)s: %(clash)s."
msgstr ""
"%(doctor)s is already on duty at that time in room %(room)s: %(clash)s."

#. module: elite_vet_reservation
#. odoo-python
#: code:addons/elite_vet_reservation/models/doctor_assignment.py:0
msgid "%(n)s služeb je z Rozpisu služeb – ty se nekopírují, zadávají se tam."
msgstr ""
"%(n)s duties come from the Duty roster – they are not copied, they are "
"entered there."

#. module: elite_vet_reservation
#. odoo-python
#: code:addons/elite_vet_reservation/wizard/reservation_wizard.py:0
msgid "%(time)s v %(room)s je obsazený: %(conflict)s."
msgstr "%(time)s in %(room)s is taken: %(conflict)s."

#. module: elite_vet_reservation
#. odoo-python
#: code:addons/elite_vet_reservation/wizard/reservation_wizard.py:0
msgid ""
"%(time)s v %(room)s je obsazený: %(conflict)s. Vyberte jiný čas, nebo "
"použijte „Přesto vytvořit“."
msgstr ""
"%(time)s in %(room)s is taken: %(conflict)s. Choose another time or use "
"“Create anyway”."

#. module: elite_vet_reservation
#. odoo-python
#: code:addons/elite_vet_reservation/wizard/reservation_wizard.py:0
msgid "%(time)s v %(room)s není pro tento úkon volný – vyberte jiný čas."
msgstr ""
"%(time)s in %(room)s is not free for this procedure – choose another time."

#. module: elite_vet_reservation
#. odoo-python
#: code:addons/elite_vet_reservation/models/doctor_assignment.py:0
msgid ""
"%s nemá zaškrtnuto „Lékařka – přijímá rezervace“. Do rozpisu lékařů patří "
"jen lékařky; nastavuje se v Rozpis služeb → Lékařky."
msgstr ""
"%s does not have “Doctor – accepts appointments” ticked. Only doctors belong"
" in the Doctors' schedule; set it in Duty roster → Doctors."

#. module: elite_vet_reservation
#. odoo-python
#: code:addons/elite_vet_reservation/models/shift.py:0
msgid ""
"%s nepřijímá rezervace, proto u její směny nemůže být ordinace – ordinaci "
"smažte. (Lékařky se označují v Rozpis služeb → Lékařky, „Lékařka – přijímá "
"rezervace“.)"
msgstr ""
"%s does not accept appointments, so her shift cannot have a room – remove "
"the room. (Doctors are marked in Duty roster → Doctors, “Doctor – accepts "
"appointments”.)"

#. module: elite_vet_reservation
#: model_terms:ir.ui.view,arch_db:elite_vet_reservation.view_assignment_form
