#. module: elite_vet_reservation
#: model:mail.template,body_html:elite_vet_reservation.mail_new_for_clinic
msgid ""
"<div style=\"font-family:system-ui,sans-serif\">\n"
"    <p><b t-out=\"object.contact_name\"/> · <t t-out=\"object.contact_phone\"/> · <t t-out=\"object.contact_email\"/></p>\n"
"    <p>Mazlíček: <t t-out=\"object.pet_name\"/> (<t t-out=\"dict(object._fields['pet_species'].selection).get(object.pet_species, '')\"/>)</p>\n"
"    <p>Úkon: <t t-out=\"object.procedure_id.name\"/> · <t t-out=\"object.start_display\"/><t t-if=\"object.doctor_id\"> · <t t-out=\"object.doctor_id.name\"/></t></p>\n"
"    <p>Popis: <t t-out=\"object.problem\"/></p>\n"
"    <p><a t-attf-href=\"{{ object.get_base_url() }}/odoo/action-elite_vet_reservation.action_reservation_waiting\">Otevřít frontu Čekající z webu</a></p>\n"
"</div>\n"
"            "
msgstr ""

#. module: elite_vet_reservation
#: model:mail.template,body_html:elite_vet_reservation.mail_reminder
msgid ""
"<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n"
"    <p>Hello <t t-out=\"object.contact_name\"/>, a reminder of your appointment <b t-out=\"object.procedure_id.name\"/>\n"
"       on <b t-out=\"object.start_display\"/> (<t t-out=\"object.room_id.name\"/>).</p>\n"
"    <p t-if=\"object.procedure_id.client_note\" t-out=\"object.procedure_id.client_note\"/>\n"
"    <p>Cannot come? Cancel here: <a t-att-href=\"object.cancel_url\" t-out=\"object.cancel_url\"/></p>\n"
"</div>\n"
"            "
msgstr "<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n    <p>Здравствуйте <t t-out=\"object.contact_name\"/>, напоминаем о вашей записи <b t-out=\"object.procedure_id.name\"/>\n       на <b t-out=\"object.start_display\"/> (<t t-out=\"object.room_id.name\"/>).</p>\n    <p t-if=\"object.procedure_id.client_note\" t-out=\"object.procedure_id.client_note\"/>\n    <p>Не можете прийти? Отмените запись здесь: <a t-att-href=\"object.cancel_url\" t-out=\"object.cancel_url\"/></p>\n</div>\n            "

#. module: elite_vet_reservation
#: model:mail.template,body_html:elite_vet_reservation.mail_web_received
msgid ""
"<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n"
"    <p>Hello <t t-out=\"object.contact_name\"/>,</p>\n"
"    <p>we have received your request for <b t-out=\"object.procedure_id.name\"/> on <b t-out=\"object.start_display\"/>.\n"
"       Our reception will confirm it shortly by e-mail.</p>\n"
"    <p t-if=\"object.procedure_id.client_note\" style=\"background:#e0f2f0;padding:10px 14px;border-radius:8px\" t-out=\"object.procedure_id.client_note\"/>\n"
"    <p>Elite Vet Karlovy Vary</p>\n"
"</div>\n"
"            "
msgstr "<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n    <p>Здравствуйте <t t-out=\"object.contact_name\"/>,</p>\n    <p>мы получили ваш запрос на <b t-out=\"object.procedure_id.name\"/> на <b t-out=\"object.start_display\"/>.\n       Наш ресепшен вскоре подтвердит её по e-mail.</p>\n    <p t-if=\"object.procedure_id.client_note\" style=\"background:#e0f2f0;padding:10px 14px;border-radius:8px\" t-out=\"object.procedure_id.client_note\"/>\n    <p>Elite Vet Karlovy Vary</p>\n</div>\n            "

#. module: elite_vet_reservation
#: model:mail.template,body_html:elite_vet_reservation.mail_rescheduled
msgid ""
"<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n"
"    <p>Hello <t t-out=\"object.contact_name\"/>,</p>\n"
"    <p>your appointment for <b t-out=\"object.procedure_id.name\"/> has been moved to <b t-out=\"object.start_display\"/>\n"
"       (<t t-out=\"object.room_id.name\"/>). If it does not suit you, cancel here: <a t-att-href=\"object.cancel_url\" t-out=\"object.cancel_url\"/></p>\n"
"    <p>Elite Vet Karlovy Vary</p>\n"
"</div>\n"
"            "
msgstr "<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n    <p>Здравствуйте <t t-out=\"object.contact_name\"/>,</p>\n    <p>ваша запись на <b t-out=\"object.procedure_id.name\"/> перенесена на <b t-out=\"object.start_display\"/>\n       (<t t-out=\"object.room_id.name\"/>). Если вам не подходит, отмените запись здесь: <a t-att-href=\"object.cancel_url\" t-out=\"object.cancel_url\"/></p>\n    <p>Elite Vet Karlovy Vary</p>\n</div>\n            "

#. module: elite_vet_reservation
#: model:mail.template,body_html:elite_vet_reservation.mail_confirmed
msgid ""
"<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n"
"    <p>Hello <t t-out=\"object.contact_name\"/>,</p>\n"
"    <p>your appointment is confirmed:</p>\n"
"    <table style=\"border-collapse:collapse\">\n"
"        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">When</td><td><b t-out=\"object.start_display\"/></td></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Reason</td><td t-out=\"object.procedure_id.name\"/></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Room</td><td t-out=\"object.room_id.name\"/></tr>\n"
"        <tr t-if=\"object.doctor_id\"><td style=\"padding:4px 12px 4px 0;color:#64748b\">Doctor</td><td t-out=\"object.doctor_id.name\"/></tr>\n"
"        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Where</td><td>Hybešova 167/18, Karlovy Vary</td></tr>\n"
"    </table>\n"
"    <p t-if=\"object.procedure_id.client_note\" style=\"background:#e0f2f0;padding:10px 14px;border-radius:8px\" t-out=\"object.procedure_id.client_note\"/>\n"
"    <p>If you cannot come, please cancel here: <a t-att-href=\"object.cancel_url\" t-out=\"object.cancel_url\"/></p>\n"
"    <p>Elite Vet Karlovy Vary</p>\n"
"</div>\n"
"            "
msgstr "<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n    <p>Здравствуйте <t t-out=\"object.contact_name\"/>,</p>\n    <p>ваша запись подтверждена:</p>\n    <table style=\"border-collapse:collapse\">\n        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Когда</td><td><b t-out=\"object.start_display\"/></td></tr>\n        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Причина</td><td t-out=\"object.procedure_id.name\"/></tr>\n        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Кабинет</td><td t-out=\"object.room_id.name\"/></tr>\n        <tr t-if=\"object.doctor_id\"><td style=\"padding:4px 12px 4px 0;color:#64748b\">Врач</td><td t-out=\"object.doctor_id.name\"/></tr>\n        <tr><td style=\"padding:4px 12px 4px 0;color:#64748b\">Где</td><td>Hybešova 167/18, Karlovy Vary</td></tr>\n    </table>\n    <p t-if=\"object.procedure_id.client_note\" style=\"background:#e0f2f0;padding:10px 14px;border-radius:8px\" t-out=\"object.procedure_id.client_note\"/>\n    <p>Если не сможете прийти, отмените запись здесь: <a t-att-href=\"object.cancel_url\" t-out=\"object.cancel_url\"/></p>\n    <p>Elite Vet Karlovy Vary</p>\n</div>\n            "

#. module: elite_vet_reservation
#: model:mail.template,body_html:elite_vet_reservation.mail_cancelled
msgid ""
"<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n"
"    <p>The appointment <b t-out=\"object.name\"/> on <b t-out=\"object.start_display\"/> has been cancelled.</p>\n"
"    <p>You can book a new one at <a t-attf-href=\"{{ object.get_base_url() }}/rezervacni-system\">our website</a> or call the reception.</p>\n"
"    <p>Elite Vet Karlovy Vary</p>\n"
"</div>\n"
"            "
msgstr "<div style=\"font-family:system-ui,sans-serif;color:#1a2744;max-width:560px\">\n    <p>Запись <b t-out=\"object.name\"/> на <b t-out=\"object.start_display\"/> отменена.</p>\n    <p>Новую запись можно сделать на <a t-attf-href=\"{{ object.get_base_url() }}/rezervacni-system\">нашем сайте</a> или позвоните на ресепшен.</p>\n    <p>Elite Vet Karlovy Vary</p>\n</div>\n            "

