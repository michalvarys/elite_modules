<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The doctor flag belongs to the person, so it is shown where people are managed
         (Shift schedule → Doctors), not in a separate reservations list. -->
    <record id="view_vet_doctor_list_reservation" model="ir.ui.view">
        <field name="name">elite.vet.doctor.list.reservation</field>
        <field name="model">elite.vet.doctor</field>
        <field name="inherit_id" ref="elite_vet_calendar.view_vet_doctor_list"/>
        <field name="arch" type="xml">
            <field name="member_id" position="after">
                <field name="accepts_bookings" string="Lékařka (rezervace)"/>
                <field name="calendar_color" widget="color" optional="show"/>
            </field>
        </field>
    </record>
    <record id="view_vet_doctor_form_reservation" model="ir.ui.view">
        <field name="name">elite.vet.doctor.form.reservation</field>
        <field name="model">elite.vet.doctor</field>
        <field name="inherit_id" ref="elite_vet_calendar.view_vet_doctor_form"/>
        <field name="arch" type="xml">
            <field name="member_id" position="after">
                <field name="accepts_bookings"/>
                <field name="calendar_color" widget="color" invisible="not accepts_bookings"/>
            </field>
        </field>
    </record>
</odoo>
