<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nahrazuje iframe WinVetu vlastnim pruvodcem. Texty jsou anglicky (zdroj),
         cestina/nemcina/rustina v i18n. JavaScript jen plni data do techto bloku. -->
    <template id="rezervace_widget" inherit_id="elite_vet_web.rezervace" name="Elite Vet - Rezervace: vlastní průvodce">
        <xpath expr="//div[hasclass('evrez')]" position="replace">
            <t t-set="ev_rez" t-value="request.env['elite.vet.setting'].sudo().nastaveni()"/>
            <section id="ev-booking" class="evbk o_colored_level" t-att-data-lang="request.env.lang">
                <div class="ev-container evbk-inner">
                    <div t-if="ev_rez.booking_intro" class="evbk-intro" t-out="ev_rez.booking_intro"/>

                    <ol class="evbk-steps" aria-label="Steps">
                        <li data-step="1" class="is-active">1 · What do you need</li>
                        <li data-step="2">2 · Date and time</li>
                        <li data-step="3">3 · Your details</li>
                        <li data-step="4">4 · Done</li>
                    </ol>

                    <!-- KROK 1 -->
                    <div class="evbk-step" data-step="1">
                        <div class="evbk-tabs" role="tablist">
                            <button type="button" class="is-active" data-tab="procedure">By problem</button>
                            <button type="button" data-tab="doctor">By doctor</button>
                            <button type="button" data-tab="specialization">By specialization</button>
                        </div>
                        <div class="evbk-tab" data-tab="procedure">
                            <p class="evbk-hint">Choose the reason for your visit.</p>
                            <div class="evbk-list" data-list="procedures"></div>
                        </div>
                        <div class="evbk-tab" data-tab="doctor" hidden="hidden">
                            <p class="evbk-hint">Choose a doctor, then the reason for your visit.</p>
                            <div class="evbk-cards" data-list="doctors"></div>
                            <div class="evbk-list" data-list="procedures-for-doctor" hidden="hidden"></div>
                            <p class="evbk-empty" data-empty="doctors" hidden="hidden">No doctor has online appointments in the coming weeks. Choose by problem or call us.</p>
                        </div>
                        <div class="evbk-tab" data-tab="specialization" hidden="hidden">
                            <p class="evbk-hint">Choose a specialization, then the reason for your visit.</p>
                            <div class="evbk-cards" data-list="specializations"></div>
                            <div class="evbk-list" data-list="procedures-for-spec" hidden="hidden"></div>
                            <p class="evbk-empty" data-empty="specializations" hidden="hidden">No specializations are set up yet. Choose by problem.</p>
                        </div>
                    </div>

                    <!-- KROK 2 -->
                    <div class="evbk-step" data-step="2" hidden="hidden">
                        <div class="evbk-summary" data-summary="choice"></div>
                        <div class="evbk-cal">
                            <div class="evbk-cal-head">
                                <button type="button" data-cal="prev" aria-label="Previous month">‹</button>
                                <strong data-cal="title"></strong>
                                <button type="button" data-cal="next" aria-label="Next month">›</button>
                            </div>
                            <div class="evbk-cal-grid" data-cal="grid"></div>
                            <p class="evbk-empty" data-empty="days" hidden="hidden">No free appointments in this month. Try the next one.</p>
                        </div>
                        <div class="evbk-slots">
                            <p class="evbk-hint" data-slots="hint">Pick a day first.</p>
                            <p class="evbk-error" data-slots="taken" hidden="hidden">This time has just been taken. Please choose another.</p>
                            <h4 data-slots="am-title" hidden="hidden">Morning</h4>
                            <div class="evbk-slot-grid" data-slots="am"></div>
                            <h4 data-slots="pm-title" hidden="hidden">Afternoon</h4>
                            <div class="evbk-slot-grid" data-slots="pm"></div>
                            <div class="evbk-doctor-pick" data-slots="doctor-pick" hidden="hidden">
                                <p>Which doctor?</p>
                                <span data-text="any-doctor" hidden="hidden">Any doctor</span>
                                <div data-list="slot-doctors"></div>
                            </div>
                        </div>
                        <button type="button" class="evbk-back" data-back="1">‹ Back</button>
                    </div>

                    <!-- KROK 3 -->
                    <div class="evbk-step" data-step="3" hidden="hidden">
                        <div class="evbk-summary" data-summary="slot"></div>
                        <form class="evbk-form" novalidate="novalidate">
                            <label>Your full name <input name="contact_name" type="text" autocomplete="name" required="required"/></label>
                            <label>Pet's name <input name="pet_name" type="text" required="required"/></label>
                            <label>Kind of animal
                                <select name="pet_species">
                                    <option value="dog">Dog</option><option value="cat">Cat</option>
                                    <option value="rabbit">Rabbit</option><option value="rodent">Rodent</option>
                                    <option value="bird">Bird</option><option value="reptile">Reptile</option>
                                    <option value="other">Other</option>
                                </select>
                            </label>
                            <label>Describe the problem <textarea name="problem" rows="3" required="required"></textarea></label>
                            <label>E-mail for confirmation <input name="contact_email" type="email" autocomplete="email" required="required"/></label>
                            <label>Phone <input name="contact_phone" type="tel" autocomplete="tel" required="required"/></label>
                            <label class="evbk-consent"><input name="consent" type="checkbox"/>
                                <span t-if="ev_rez.booking_consent_text" t-out="ev_rez.booking_consent_text"/>
                                <span t-else="">I agree to the processing of my personal data for the purpose of this appointment.</span>
                            </label>
                            <!-- Honeypot: skryte pole, ktere clovek nevyplni; boti ano a server je zahodi -->
                            <input name="hp" type="text" tabindex="-1" autocomplete="off" class="evbk-hp"/>
                            <p class="evbk-error" data-error="form" hidden="hidden"></p>
                            <button type="submit" class="evbk-submit">Send the request</button>
                        </form>
                        <button type="button" class="evbk-back" data-back="2">‹ Back</button>
                    </div>

                    <!-- KROK 4 -->
                    <div class="evbk-step" data-step="4" hidden="hidden">
                        <div class="evbk-done">
                            <div class="evbk-done-icon">✓</div>
                            <h3>We have received your request</h3>
                            <p>We will confirm the appointment by e-mail. If anything is unclear, we will call you.</p>
                            <div class="evbk-summary" data-summary="final"></div>
                            <p class="evbk-note" data-done="note" hidden="hidden"></p>
                            <p class="evbk-deposit" data-done="deposit" hidden="hidden">The appointment becomes valid after the deposit is paid. We will send the payment instructions by e-mail.</p>
                        </div>
                    </div>

                    <p class="evbk-fatal" data-error="fatal" hidden="hidden">The booking system is temporarily unavailable. Please call the reception.</p>
                </div>
            </section>
        </xpath>
    </template>
    <template id="cancel_page" name="Elite Vet - Zrušení rezervace">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="true"/>
            <t t-set="no_footer" t-value="true"/>
            <t t-set="additional_title">Cancel appointment | Elite Vet</t>
            <div id="wrap" class="oe_structure vet-page">
                <t t-call="elite_vet_theme.vet_header"/>
                <section class="evbk o_colored_level">
                    <div class="ev-container evbk-inner" style="max-width:560px">
                        <h1 style="font-size:28px;margin:24px 0 12px">Cancel appointment</h1>
                        <div class="evbk-summary">
                            <t t-out="rez.name"/><br/><t t-out="rez.start_display"/>
                            <t t-if="rez.room_id"> · <t t-out="rez.room_id.name"/></t>
                        </div>
                        <t t-if="stav == 'zruseno'">
                            <p class="evbk-note">The appointment has been cancelled. You can book a new one on the reservation page.</p>
                        </t>
                        <t t-elif="stav == 'uz_zruseno'">
                            <p>This appointment is already cancelled.</p>
                        </t>
                        <t t-elif="stav == 'pozde'">
                            <p>It is too late to cancel online. Please call the reception: <b t-out="telefon"/>.</p>
                        </t>
                        <t t-else="">
                            <form method="post">
                                <input type="hidden" name="potvrdit" value="1"/>
                                <p>Do you really want to cancel this appointment?</p>
                                <button type="submit" class="evbk-submit">Yes, cancel it</button>
                            </form>
                        </t>
                        <p><a t-att-href="url_for('/rezervacni-system')">‹ Back to reservations</a></p>
                    </div>
                </section>
                <t t-call="elite_vet_theme.vet_footer"/>
            </div>
        </t>
    </template>

    <template id="deposit_page" name="Elite Vet - Záloha">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="true"/>
            <t t-set="no_footer" t-value="true"/>
            <t t-set="additional_title">Deposit | Elite Vet</t>
            <div id="wrap" class="oe_structure vet-page">
                <t t-call="elite_vet_theme.vet_header"/>
                <section class="evbk o_colored_level">
                    <div class="ev-container evbk-inner" style="max-width:560px">
                        <h1 style="font-size:28px;margin:24px 0 12px">Deposit</h1>
                        <div class="evbk-summary"><t t-out="rez.name"/><br/><t t-out="rez.start_display"/></div>
                        <p t-if="rez.deposit_state == 'paid'">The deposit has been paid. Thank you.</p>
                        <p t-elif="rez.deposit_state == 'pending'">Deposit of <b t-out="rez.procedure_id.deposit_amount"/> Kč is pending.
                           Online payment will be available soon; until then the reception will send you the payment details.</p>
                        <p t-else="">No deposit is required for this appointment.</p>
                        <p><a t-att-href="url_for('/rezervacni-system')">‹ Back to reservations</a></p>
                    </div>
                </section>
                <t t-call="elite_vet_theme.vet_footer"/>
            </div>
        </t>
    </template>
</odoo>
