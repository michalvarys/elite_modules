<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_list" model="ir.ui.view">
        <field name="name">elite.vet.reservation.list</field>
        <field name="model">elite.vet.reservation</field>
        <field name="arch" type="xml">
            <list string="Rezervace" decoration-muted="state in ('cancelled','no_show')" decoration-info="state == 'web_new'">
                <field name="start" widget="datetime"/>
                <field name="stop" column_invisible="1"/>
                <field name="name"/>
                <field name="room_id"/>
                <field name="doctor_id" optional="show"/>
                <field name="procedure_id" optional="hide"/>
                <field name="contact_phone" optional="show"/>
                <field name="source" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="kind" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_reservation_form" model="ir.ui.view">
        <field name="name">elite.vet.reservation.form</field>
        <field name="model">elite.vet.reservation</field>
        <field name="arch" type="xml">
            <form string="Rezervace">
                <header>
                    <button name="action_confirm" type="object" string="Potvrdit" class="btn-primary"
                            invisible="state != 'web_new' or kind == 'block'"/>
                    <button name="action_send_confirmation" type="object" string="Poslat potvrzení"
                            invisible="state != 'confirmed' or kind == 'block' or not contact_email"/>
                    <button name="action_done" type="object" string="Proběhla" invisible="state != 'confirmed' or kind == 'block'"/>
                    <button name="action_no_show" type="object" string="Nedorazil" invisible="state != 'confirmed' or kind == 'block'"/>
                    <!-- Tri varianty zruseni: blokace nema komu psat, rezervace bez e-mailu taky ne.
                         Varovani o e-mailu jen tam, kde opravdu odejde. -->
                    <button name="action_cancel" type="object" string="Zrušit"
                            invisible="kind == 'block' or not contact_email or state in ('cancelled','done','no_show')"
                            confirm="Opravdu zrušit? Klientovi odejde e-mail o zrušení."/>
                    <button name="action_cancel" type="object" string="Zrušit"
                            invisible="kind == 'block' or contact_email or state in ('cancelled','done','no_show')"
                            confirm="Opravdu zrušit tuto rezervaci?"/>
                    <button name="action_cancel" type="object" string="Zrušit blokaci"
                            invisible="kind != 'block' or state in ('cancelled','done','no_show')"/>
                    <button name="action_sparovat" type="object" string="Spárovat klienta"
                            invisible="partner_id or kind == 'block'"/>
                    <field name="state" widget="statusbar" statusbar_visible="web_new,confirmed,done" invisible="kind == 'block'"/>
                </header>
                <sheet>
                    <field name="kind" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Termín">
                            <field name="procedure_id" invisible="kind == 'block'" required="kind == 'reservation'"/>
                            <field name="block_reason" invisible="kind == 'reservation'" required="kind == 'block'"/>
                            <field name="block_scope" widget="radio" invisible="kind != 'block'" required="kind == 'block'"/>
                            <field name="room_id" required="kind == 'reservation' and state in ('confirmed', 'done')"/>
                            <field name="doctor_id" invisible="kind == 'block'"/>
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="repeat_weekly_until" invisible="kind == 'reservation' or id"/>
                            <field name="source" invisible="kind == 'block'" readonly="1"/>
                        </group>
                        <group string="Klient" invisible="kind == 'block'">
                            <field name="partner_id"/>
                            <field name="pet_id"/>
                            <field name="contact_name"/>
                            <field name="contact_email" widget="email"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="pet_name"/>
                            <field name="pet_species"/>
                            <field name="lang" invisible="1"/>
                        </group>
                    </group>
                    <group invisible="kind == 'block'">
                        <field name="problem" placeholder="Co klient napsal do formuláře"/>
                    </group>
                    <group>
                        <field name="note" placeholder="Interní poznámka recepce"/>
                    </group>
                    <group string="Záloha" invisible="kind == 'block' or deposit_state == 'none'">
                        <field name="deposit_state"/>
                        <field name="transaction_id"/>
                    </group>
                    <field name="cancel_token" invisible="1"/>
                    <field name="cancel_reason" invisible="state != 'cancelled'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reservation_calendar" model="ir.ui.view">
        <field name="name">elite.vet.reservation.calendar</field>
        <field name="model">elite.vet.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Rezervace" date_start="start" date_stop="stop" color="procedure_id" mode="week" quick_create="0">
                <field name="room_id" filters="1"/>
                <field name="procedure_id"/>
                <field name="contact_phone"/>
            </calendar>
        </field>
    </record>

    <record id="view_reservation_kanban_waiting" model="ir.ui.view">
        <field name="name">elite.vet.reservation.kanban.waiting</field>
        <field name="model">elite.vet.reservation</field>
        <field name="arch" type="xml">
            <kanban default_order="start" create="0">
                <field name="name"/><field name="start"/><field name="procedure_id"/>
                <field name="contact_phone"/><field name="contact_email"/><field name="problem"/>
                <templates>
                    <t t-name="card">
                        <div class="p-2">
                            <strong t-esc="record.name.value"/>
                            <div><field name="start" widget="datetime"/> · <field name="procedure_id"/></div>
                            <div class="text-muted"><field name="contact_phone"/> · <field name="contact_email"/></div>
                            <div t-if="record.problem.value" class="small" t-esc="record.problem.value"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_reservation_search" model="ir.ui.view">
        <field name="name">elite.vet.reservation.search</field>
        <field name="model">elite.vet.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contact_phone"/>
                <field name="contact_email"/>
                <field name="partner_id"/>
                <filter name="waiting" string="Čekající z webu" domain="[('state', '=', 'web_new')]"/>
                <filter name="confirmed" string="Potvrzené" domain="[('state', '=', 'confirmed')]"/>
                <filter name="reservations" string="Jen rezervace" domain="[('kind', '=', 'reservation')]"/>
                <filter name="blocks" string="Jen blokace" domain="[('kind', '=', 'block')]"/>
                <filter name="blocks_web" string="Blokace jen pro web" domain="[('kind', '=', 'block'), ('block_scope', '=', 'web')]"/>
                <filter name="od_dneska" string="Od dneška" domain="[('stop', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Seskupit podle">
                    <filter name="group_room" string="Ordinace" context="{'group_by': 'room_id'}"/>
                    <filter name="group_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Den" context="{'group_by': 'start:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reservation" model="ir.actions.act_window">
        <field name="name">Rezervace</field>
        <field name="res_model">elite.vet.reservation</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_od_dneska': 1, 'search_default_reservations': 1}</field>
    </record>

    <!-- Čekající přicházejí jen z webu; ručně se tu nic nezakládá (na to je Nová rezervace). -->
    <record id="view_reservation_list_waiting" model="ir.ui.view">
        <field name="name">elite.vet.reservation.list.waiting</field>
        <field name="model">elite.vet.reservation</field>
        <field name="inherit_id" ref="view_reservation_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="create">0</attribute>
            </list>
        </field>
    </record>

    <record id="action_reservation_waiting" model="ir.actions.act_window">
        <field name="name">Čekající z webu</field>
        <field name="res_model">elite.vet.reservation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_reservation_kanban_waiting"/>
        <field name="domain">[('state', '=', 'web_new')]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_reservation_kanban_waiting')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_reservation_list_waiting')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nic nečeká</p>
            <p>Sem padají rezervace z webu. Otevřete je, vyberte ordinaci a potvrďte.</p>
        </field>
    </record>

    <record id="action_block_new" model="ir.actions.act_window">
        <field name="name">Nová blokace</field>
        <field name="res_model">elite.vet.reservation</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_kind': 'block', 'default_state': 'confirmed'}</field>
    </record>
</odoo>
