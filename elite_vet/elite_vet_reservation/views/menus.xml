<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aplikace Rezervace uz existuje v elite_vet_web (nastaveni + FAQ).
         Nic noveho se nezaklada, jen se do ni vesi dalsi polozky. -->
    <!-- Kořen patří elite_vet_web a vidí ho jen správce kalendáře; Recepce ho musí vidět taky. -->
    <record id="elite_vet_web.menu_rezervace_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('elite_vet_reservation.group_reservation_reception'))]"/>
    </record>
    <menuitem id="menu_reservation_board" name="Tabule"
              parent="elite_vet_web.menu_rezervace_root" action="action_board" sequence="10"
              groups="elite_vet_reservation.group_reservation_reception"/>
    <menuitem id="menu_reservation_new" name="Nová rezervace"
              parent="elite_vet_web.menu_rezervace_root" action="action_reservation_wizard" sequence="15"
              groups="elite_vet_reservation.group_reservation_reception"/>
    <menuitem id="menu_reservation_waiting" name="Čekající z webu"
              parent="elite_vet_web.menu_rezervace_root" action="action_reservation_waiting" sequence="20"
              groups="elite_vet_reservation.group_reservation_reception"/>
    <menuitem id="menu_reservation_all" name="Rezervace"
              parent="elite_vet_web.menu_rezervace_root" action="action_reservation" sequence="30"
              groups="elite_vet_reservation.group_reservation_reception"/>
    <menuitem id="menu_reservation_assignment" name="Rozpis lékařů"
              parent="elite_vet_web.menu_rezervace_root" action="action_assignment" sequence="40"
              groups="elite_vet_reservation.group_reservation_reception"/>
    <menuitem id="menu_reservation_client" name="Klienti"
              parent="elite_vet_web.menu_rezervace_root" action="action_client" sequence="50"
              groups="elite_vet_reservation.group_reservation_reception"/>
    <menuitem id="menu_reservation_pet" name="Mazlíčci"
              parent="elite_vet_web.menu_rezervace_root" action="action_pet" sequence="51"
              groups="elite_vet_reservation.group_reservation_reception"/>
    <menuitem id="menu_reservation_config" name="Konfigurace"
              parent="elite_vet_web.menu_rezervace_root" sequence="90"
              groups="elite_vet_reservation.group_reservation_manager"/>
    <menuitem id="menu_reservation_room" name="Ordinace"
              parent="menu_reservation_config" action="action_room" sequence="10"/>
    <menuitem id="menu_reservation_room_exception" name="Výjimky ordinační doby"
              parent="menu_reservation_config" action="action_room_exception" sequence="20"/>
    <menuitem id="menu_reservation_procedure" name="Úkony"
              parent="menu_reservation_config" action="action_procedure" sequence="30"/>

    <!-- Nastavení a časté dotazy patří elite_vet_web; recepce je denně nepotřebuje,
         proto je přesuneme do Konfigurace (jen datovým záznamem, cizí soubor se nemění).
         Samostatný -u elite_vet_web je vrátí pod kořen; -u elite_vet_reservation přesun
         obnoví (tyto záznamy + presunout_cizi_menu v __init__.py a migraci 18.0.1.3.0). -->
    <record id="elite_vet_web.menu_rezervace_nastaveni" model="ir.ui.menu">
        <field name="name">Nastavení rezervace</field>
        <field name="parent_id" ref="menu_reservation_config"/>
        <field name="sequence">40</field>
    </record>
    <record id="elite_vet_web.menu_rezervace_faq" model="ir.ui.menu">
        <field name="parent_id" ref="menu_reservation_config"/>
        <field name="sequence">50</field>
    </record>
</odoo>
