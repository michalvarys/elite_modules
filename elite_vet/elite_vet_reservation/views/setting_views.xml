<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_setting_reservation_form_booking" model="ir.ui.view">
        <field name="name">elite.vet.setting.rezervace.form.booking</field>
        <field name="model">elite.vet.setting</field>
        <field name="inherit_id" ref="elite_vet_web.view_setting_rezervace_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='booking_loading_title']/parent::group" position="before">
                <group string="Vlastní rezervační systém">
                    <group>
                        <field name="booking_slot_step"/>
                        <field name="booking_min_hours_before"/>
                        <field name="booking_max_days_ahead"/>
                        <field name="booking_cancel_hours_before"/>
                        <field name="booking_require_doctor"/>
                        <field name="booking_block_weekends"/>
                        <field name="booking_block_holidays"/>
                    </group>
                    <group>
                        <field name="booking_notify_email"/>
                        <field name="booking_email_from" placeholder="Elite Vet Karlovy Vary &lt;rezervace@elite-vet.cz&gt;"/>
                        <field name="booking_email_reply_to"/>
                        <field name="booking_reminder_enabled"/>
                        <field name="booking_reminder_hours_before" invisible="not booking_reminder_enabled"/>
                        <field name="booking_deposits_enabled"/>
                    </group>
                </group>
                <!-- Html pole přes celou šířku mimo group by bylo bez popisku; label dáme výslovně. -->
                <div class="mb-3">
                    <label for="booking_intro" string="Text nad rezervací" class="o_form_label d-block"/>
                    <field name="booking_intro" placeholder="Text nad rezervačním průvodcem"/>
                </div>
                <div class="mb-3">
                    <label for="booking_consent_text" string="Text souhlasu pod formulářem" class="o_form_label d-block"/>
                    <field name="booking_consent_text" placeholder="Souhlasím se zpracováním údajů…"/>
                </div>
            </xpath>
            <!-- Starý WinVet (odkaz na cizí rezervaci a hláška při načítání) stránka už nepoužívá.
                 Skrýváme jen tyto skupiny; telefon a odkaz na rozpis služeb zůstávají. -->
            <xpath expr="//field[@name='booking_url']/parent::group" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='booking_loading_title']/parent::group" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
