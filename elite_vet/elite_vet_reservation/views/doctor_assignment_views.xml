<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assignment_list" model="ir.ui.view">
        <field name="name">elite.vet.doctor.assignment.list</field>
        <field name="model">elite.vet.doctor.assignment</field>
        <field name="arch" type="xml">
            <list string="Rozpis lékařů" editable="bottom" multi_edit="1" default_order="date, room_id, hour_from">
                <!-- Rows from Rozpis služeb: doctor, room, date and hours are changed there. -->
                <field name="date" readonly="from_roster"/>
                <field name="doctor_id" readonly="from_roster"/>
                <field name="room_id" readonly="from_roster"/>
                <field name="hour_from" widget="float_time" readonly="from_roster"/>
                <field name="hour_to" widget="float_time" readonly="from_roster"/>
                <field name="from_roster" string="Z rozpisu služeb" optional="show"/>
                <field name="procedure_ids" widget="many2many_tags" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_assignment_form" model="ir.ui.view">
        <field name="name">elite.vet.doctor.assignment.form</field>
        <field name="model">elite.vet.doctor.assignment</field>
        <field name="arch" type="xml">
            <form string="Služba lékaře">
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not from_roster">
                        Tato služba je <b>z rozpisu služeb</b>. Lékařka, ordinace, datum a čas se mění
                        v aplikaci <b>Rozpis služeb</b> (směna <field name="shift_id" readonly="1" class="d-inline"/>);
                        tady jde upravit jen „Jen tyto úkony“ a poznámka.
                    </div>
                    <group>
                        <group>
                            <field name="from_roster" invisible="1"/>
                            <field name="date" readonly="from_roster"/>
                            <field name="doctor_id" readonly="from_roster"/>
                            <field name="room_id" readonly="from_roster"/>
                        </group>
                        <group>
                            <field name="hour_from" widget="float_time" readonly="from_roster"/>
                            <field name="hour_to" widget="float_time" readonly="from_roster"/>
                        </group>
                    </group>
                    <group>
                        <field name="procedure_ids" widget="many2many_tags"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_assignment_calendar" model="ir.ui.view">
        <field name="name">elite.vet.doctor.assignment.calendar</field>
        <field name="model">elite.vet.doctor.assignment</field>
        <field name="arch" type="xml">
            <calendar string="Rozpis lékařů" date_start="date" color="room_id" mode="week" quick_create="0"
                      js_class="elite_vet_holiday_calendar">
                <!-- js_class (elite_vet_calendar): Czech public holidays shown in the header / day cells -->
                <field name="doctor_id"/>
                <field name="room_id"/>
                <field name="from_roster"/>
            </calendar>
        </field>
    </record>

    <record id="view_assignment_search" model="ir.ui.view">
        <field name="name">elite.vet.doctor.assignment.search</field>
        <field name="model">elite.vet.doctor.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="doctor_id"/>
                <field name="room_id"/>
                <filter name="from_today" string="Od dneška"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="from_roster" string="Z rozpisu služeb" domain="[('from_roster', '=', True)]"/>
                <filter name="manual" string="Zadané ručně" domain="[('from_roster', '=', False)]"/>
                <group expand="0" string="Seskupit podle">
                    <filter name="group_date" string="Den" context="{'group_by': 'date:day'}"/>
                    <filter name="group_doctor" string="Lékařka" context="{'group_by': 'doctor_id'}"/>
                    <filter name="group_room" string="Ordinace" context="{'group_by': 'room_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_assignment" model="ir.actions.act_window">
        <field name="name">Rozpis lékařů</field>
        <field name="res_model">elite.vet.doctor.assignment</field>
        <field name="view_mode">list,calendar,form</field>
        <!-- No default grouping: rows sorted by date and room are easier to read. -->
        <field name="context">{'search_default_from_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zapište, kdo kdy slouží</p>
            <p>Směny se zadávají v Rozpisu služeb – směna s ordinací se sem propíše sama.
               Ručně tu jde přidat jen službu mimo rozpis (vlastní čas, půl směny).
               Podle toho se na webu nabízí termíny „k lékaři“ a na tabuli je vidět, kdo je v ordinaci.</p>
        </field>
    </record>

    <!-- Action on selected list rows (Action menu). -->
    <record id="action_assignment_copy_week" model="ir.actions.server">
        <field name="name">Zkopírovat na další týden</field>
        <field name="model_id" ref="model_elite_vet_doctor_assignment"/>
        <field name="binding_model_id" ref="model_elite_vet_doctor_assignment"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [ref('elite_vet_reservation.group_reservation_manager')])]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_copy_week()</field>
    </record>
</odoo>
