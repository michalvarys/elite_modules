<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reservation_wizard_form" model="ir.ui.view">
        <field name="name">elite.vet.reservation.wizard.form</field>
        <field name="model">elite.vet.reservation.wizard</field>
        <field name="arch" type="xml">
            <form string="Nová rezervace">
                <!-- Request 4. 11.: a step reached before is a button, action_go_step checks the way there. -->
                <field name="step" invisible="1"/>
                <field name="reached_step" invisible="1"/>
                <div class="d-flex flex-wrap gap-1 mb-3 o_ev_wizard_steps">
                    <span class="btn btn-primary btn-sm pe-none" invisible="step != 'what'">1. Co a kdy</span>
                    <button name="action_go_step" type="object" context="{'go_step': 'what'}" string="1. Co a kdy"
                            class="btn-outline-primary btn-sm" invisible="step == 'what' or reached_step &lt; 0"/>
                    <span class="btn btn-primary btn-sm pe-none" invisible="step != 'time'">2. Volný čas</span>
                    <button name="action_go_step" type="object" context="{'go_step': 'time'}" string="2. Volný čas"
                            class="btn-outline-primary btn-sm" invisible="step == 'time' or reached_step &lt; 1"/>
                    <span class="btn btn-light btn-sm disabled" invisible="reached_step &gt;= 1">2. Volný čas</span>
                    <span class="btn btn-primary btn-sm pe-none" invisible="step != 'client'">3. Klient</span>
                    <button name="action_go_step" type="object" context="{'go_step': 'client'}" string="3. Klient"
                            class="btn-outline-primary btn-sm" invisible="step == 'client' or reached_step &lt; 2"/>
                    <span class="btn btn-light btn-sm disabled" invisible="reached_step &gt;= 2">3. Klient</span>
                    <span class="btn btn-primary btn-sm pe-none" invisible="step != 'summary'">4. Shrnutí</span>
                    <button name="action_go_step" type="object" context="{'go_step': 'summary'}" string="4. Shrnutí"
                            class="btn-outline-primary btn-sm" invisible="step == 'summary' or reached_step &lt; 3"/>
                    <span class="btn btn-light btn-sm disabled" invisible="reached_step &gt;= 3">4. Shrnutí</span>
                </div>
                <field name="allowed_doctor_ids" invisible="1"/>
                <field name="serving_doctor_ids" invisible="1"/>
                <field name="has_multiple_serving" invisible="1"/>
                <field name="minute" invisible="1"/>
                <field name="has_pet" invisible="1"/>
                <field name="send_email_offered" invisible="1"/>

                <!-- Public holiday on the date: a warning only (reception books normally). -->
                <div invisible="not holiday_warning" class="alert alert-warning o_ev_holiday_warning" role="status">
                    <field name="holiday_warning" readonly="1" nolabel="1"/>
                </div>

                <!-- The client did not come before (Nedorazil, last 12 months): a warning only. -->
                <div invisible="not no_show_warning or step not in ('client', 'summary')"
                     class="alert alert-warning o_ev_no_show_warning" role="status">
                    <i class="fa fa-user-times me-1" title="Nedorazil" aria-hidden="true"/><field name="no_show_warning" readonly="1" nolabel="1"/>
                </div>

                <!-- 1. What and when -->
                <group invisible="step != 'what'">
                    <group>
                        <field name="title" placeholder="Nepovinné – ukáže se v kalendáři (bez klienta povinné)"/>
                        <field name="procedure_id" placeholder="Nepovinné – prázdné bude Jiné" options="{'no_create': True, 'no_open': True}"/>
                        <label for="duration"/>
                        <div class="d-flex align-items-center gap-2">
                            <field name="duration" class="oe_inline" style="width: 5em;"/>
                            <button name="action_extend_duration" type="object" string="+15 min" class="btn-secondary btn-sm"
                                    context="{'extend_minutes': 15}"/>
                            <button name="action_extend_duration" type="object" string="+30 min" class="btn-secondary btn-sm"
                                    context="{'extend_minutes': 30}"/>
                        </div>
                        <field name="serving_doctor_id" widget="radio"
                               invisible="not has_multiple_serving"
                               options="{'horizontal': true}"/>
                        <field name="doctor_id" placeholder="Kterákoli, která úkon dělá"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="date"/>
                    </group>
                    <group invisible="not room_id">
                        <div class="text-muted" colspan="2">
                            Vybraný termín: <field name="room_id" readonly="1" class="d-inline" options="{'no_open': True}"/> v <field name="time_label" class="d-inline"/>.
                            Je-li čas volný, krok s výběrem času se přeskočí.
                        </div>
                    </group>
                </group>

                <!-- 2. Free time -->
                <div invisible="step != 'time'">
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <button name="action_previous_day" type="object" string="‹ Předchozí den" class="btn-secondary"/>
                        <h4 class="mb-0 mx-2"><field name="day_label" readonly="1"/></h4>
                        <button name="action_next_day" type="object" string="Další den ›" class="btn-secondary"/>
                        <button name="action_next_free_day" type="object" string="Další volný den" class="btn-link"/>
                    </div>
                    <div class="text-muted mb-2">
                        <field name="procedure_id" readonly="1" class="d-inline" options="{'no_open': True}"/>
                        · <field name="duration" readonly="1" class="d-inline"/> min
                        <span invisible="not doctor_id"> · <field name="doctor_id" readonly="1" class="d-inline" options="{'no_open': True}"/></span>
                    </div>
                    <div invisible="not warning" class="alert alert-warning" role="status">
                        <field name="warning" readonly="1" nolabel="1"/>
                        <field name="overlap_room_id" invisible="1"/>
                        <button name="action_force_overlap" type="object" string="Přesto vytvořit" class="btn-warning btn-sm ms-2"
                                invisible="not overlap_room_id"/>
                    </div>
                    <div class="mb-2">
                        <field name="manual" widget="boolean_toggle" class="d-inline-block w-auto"/>
                        <label for="manual" string="Zadat čas ručně" class="ms-1"/>
                        <span class="text-muted small ms-2">i mimo nabízené časy – brání jen úplná blokace, u jiné rezervace se průvodce zeptá</span>
                    </div>
                    <div invisible="not manual" class="border rounded p-2 mb-2">
                        <group>
                            <group>
                                <field name="manual_room_id"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="manual_time"/>
                            </group>
                            <group>
                                <div class="text-muted small" colspan="2">
                                    Ordinační doba, služba lékařky, blokace jen pro web, víkend ani svátek tu nebrání.
                                    Lékařku (zvolenou v kroku 1, jinak tu, která v ordinaci zrovna slouží) zkontrolujte.
                                </div>
                            </group>
                        </group>
                        <button name="action_use_manual_time" type="object" string="Použít ruční čas" class="btn-primary"/>
                    </div>
                    <div invisible="manual or slot_ids" class="alert alert-info" role="status">
                        V tento den není volný čas. Zkuste „Další volný den“, nebo zadejte čas ručně.
                    </div>
                    <field name="slot_ids" invisible="manual or not slot_ids" nolabel="1">
                        <list create="0" delete="0" no_open="1" limit="500">
                            <field name="minute" column_invisible="1"/>
                            <field name="time_label"/>
                            <field name="room_id" readonly="1" options="{'no_open': True}"/>
                            <field name="doctor_id" readonly="1" options="{'no_open': True}"/>
                            <button name="action_select" type="object" string="Vybrat" class="btn-primary btn-sm"/>
                        </list>
                    </field>
                </div>

                <!-- 3. Client -->
                <div invisible="step != 'client'">
                    <field name="partner_mode" widget="radio" options="{'horizontal': true}"/>
                    <div invisible="partner_mode != 'none'" class="text-muted mb-2">
                        Rezervace se uloží bez klienta, v kalendáři ji poznáte podle popisu<field name="title" class="d-inline fw-bold ms-1" readonly="1" invisible="not title"/>.
                        Klienta jde doplnit později (Klient… / Spárovat klienta).
                    </div>
                    <group>
                        <group string="Klient" invisible="partner_mode == 'none'">
                            <field name="partner_id" invisible="partner_mode != 'existing'"
                                   context="{'ev_search_phone': True, 'default_is_vet_client': True}"
                                   placeholder="Jméno, telefon nebo e-mail" options="{'no_create': True}"/>
                            <field name="contact_name" required="step == 'client' and partner_mode == 'new'"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="contact_email" widget="email"/>
                            <field name="lang"/>
                        </group>
                        <group string="Mazlíček">
                            <field name="pet_id" invisible="partner_mode != 'existing' or not partner_id"
                                   options="{'no_create': True}"/>
                            <field name="pet_name" invisible="has_pet"/>
                            <field name="pet_species" invisible="has_pet"/>
                        </group>
                    </group>
                    <group>
                        <field name="problem" placeholder="S čím klient přichází"/>
                        <field name="note" placeholder="Interní poznámka recepce"/>
                        <field name="send_email" readonly="not contact_email" invisible="partner_mode == 'none'"/>
                    </group>
                </div>

                <!-- 4. Summary -->
                <div invisible="step != 'summary'">
                    <field name="summary" readonly="1" nolabel="1"/>
                </div>

                <footer>
                    <button name="action_step_time" type="object" string="Dále" class="btn-primary" invisible="step != 'what'"/>
                    <button name="action_back_to_what" type="object" string="Zpět" class="btn-secondary" invisible="step != 'time'"/>
                    <button name="action_go_step" type="object" context="{'go_step': 'client'}" string="Dále" class="btn-primary"
                            invisible="step != 'time' or not room_id"/>
                    <button name="action_back_to_time" type="object" string="Zpět" class="btn-secondary" invisible="step != 'client'"/>
                    <button name="action_step_summary" type="object" string="Dále" class="btn-primary" invisible="step != 'client'"/>
                    <button name="action_back_to_client" type="object" string="Zpět" class="btn-secondary" invisible="step != 'summary'"/>
                    <button name="action_save" type="object" string="Uložit rezervaci" class="btn-primary" invisible="step != 'summary'"/>
                    <button special="cancel" string="Zavřít" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reservation_wizard" model="ir.actions.act_window">
        <field name="name">Nová rezervace</field>
        <field name="res_model">elite.vet.reservation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
