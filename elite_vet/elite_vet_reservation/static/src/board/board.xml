<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elite_vet_reservation.Board">
        <div class="evb o_action">
            <div class="evb-toolbar">
                <button class="btn btn-secondary" t-on-click="() => this.shiftDay(-1)">‹</button>
                <input type="date" class="form-control evb-date" t-att-value="state.date" t-on-change="onDateInput"/>
                <button class="btn btn-secondary" t-on-click="() => this.shiftDay(1)">›</button>
                <button class="btn btn-link" t-on-click="today">Dnes</button>
                <h3 class="evb-day-title" t-esc="dayTitle"/>
                <span t-if="!state.loading and state.data and state.data.day_note" class="evb-day-note"
                      t-att-title="state.data.day_note + ' – recepce v tento den objednává normálně (i ručním časem).'"
                      t-esc="state.data.day_note"/>
                <div class="evb-week" role="group" aria-label="Dny v týdnu">
                    <button t-foreach="weekDays" t-as="d" t-key="d.iso" type="button" class="evb-weekday"
                            t-att-class="{'evb-weekday-selected': d.selected, 'evb-weekday-today': d.today}"
                            t-att-title="d.today ? 'Dnes' : ''" t-on-click="() => this.goTo(d.iso)">
                        <span class="evb-weekday-short" t-esc="d.short"/>
                        <span class="evb-weekday-date" t-esc="d.label"/>
                    </button>
                </div>
                <span class="flex-grow-1"/>
                <button type="button" class="btn btn-light evb-zvuk" t-on-click="prepnoutZvuk"
                        t-att-title="state.zvuk ? 'Zvuk při nové žádosti z webu je zapnutý – kliknutím vypnete' : 'Zvuk při nové žádosti z webu je vypnutý – kliknutím zapnete'">
                    <t t-if="state.zvuk">🔔 Zvuk</t><t t-else="">🔕 Bez zvuku</t>
                </button>
                <button class="btn btn-primary" t-on-click="() => this.openWizard()">Nová rezervace</button>
                <button class="btn btn-outline-secondary" t-on-click="newBlock">Nová blokace</button>
            </div>
            <div t-if="state.loading" class="p-4 text-muted">Načítám…</div>
            <div t-else="" class="evb-body">
                <aside class="evb-waiting" t-att-style="panelStyle">
                    <h5 class="mb-1">Čekající z webu (<t t-esc="state.data.waiting.length"/>)</h5>
                    <p t-if="state.data.waiting.length" class="small text-muted mb-2">
                        Potvrďte návrhem, nebo přetáhněte kartu do sloupce ordinace na požadovaný čas.
                    </p>
                    <p t-else="" class="text-muted small">Nic nečeká.</p>
                    <div t-foreach="state.data.waiting" t-as="w" t-key="w.id" class="evb-card" draggable="true"
                         t-att-class="{'evb-card-active': state.preview and state.preview.id === w.id}"
                         t-on-mouseenter="() => this.hoverWaiting(w)" t-on-mouseleave="leaveWaiting"
                         t-on-dragstart="(ev) => { this.leaveWaiting(); this.onDragStart(ev, w, 'waiting'); }" t-on-dragend="onDragEnd">
                        <div class="evb-card-when"><t t-esc="w.date_label"/> <span class="text-muted fw-normal">(<t t-esc="w.duration"/> min)</span></div>
                        <strong t-esc="w.name"/>
                        <div class="small text-muted"><t t-esc="w.phone"/><t t-if="w.phone and w.email"> · </t><t t-esc="w.email"/></div>
                        <div t-if="w.doctor" class="small">Lékařka: <t t-esc="w.doctor"/></div>
                        <div t-if="w.problem" class="small evb-problem" t-esc="w.problem"/>
                        <div class="evb-suggestions">
                            <button t-foreach="w.suggestions" t-as="sug" t-key="sug.room_id" type="button"
                                    class="btn btn-sm btn-success evb-suggestion" t-att-disabled="state.busy"
                                    t-on-mouseenter="() => this.hoverSuggestion(w, sug)"
                                    t-on-mouseleave="() => this.leaveSuggestion(w)"
                                    t-on-click="() => this.confirmSuggestion(w, sug)">
                                Potvrdit → <t t-esc="sug.room"/><t t-if="sug.doctor"> · <t t-esc="sug.doctor"/></t>
                            </button>
                            <div t-if="!w.suggestions.length and w.past" class="small evb-no-suggestion">
                                Požadovaný čas už uplynul – otevřete a přeplánujte.
                            </div>
                            <div t-elif="!w.suggestions.length" class="small evb-no-suggestion">
                                Požadovaný čas už není volný – otevřete a přeplánujte.
                            </div>
                        </div>
                        <div class="evb-card-actions">
                            <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openForm(w.id)">Upravit</button>
                            <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.reject(w)">Odmítnout</button>
                        </div>
                    </div>
                </aside>
                <div class="evb-resizer" role="separator" aria-orientation="vertical" tabindex="0"
                     aria-label="Šířka panelu čekajících žádostí"
                     title="Táhnutím změníte šířku panelu · dvojklik = výchozí šířka"
                     t-on-pointerdown="onResizeStart" t-on-dblclick="resetSirky" t-on-keydown="onResizeKey"/>
                <div class="evb-grid" t-ref="grid">
                    <div class="evb-axis">
                        <div class="evb-head"/>
                        <div class="evb-axis-body" t-att-style="'height:' + height(axis.from, axis.to) + 'px'">
                            <div t-foreach="rows" t-as="m" t-key="m" class="evb-tick" t-att-style="'top:' + top(m) + 'px'"
                                 t-att-class="{'evb-tick-hour': m % 60 === 0}">
                                <span t-if="m % 60 === 0" t-esc="hhmm(m)"/>
                            </div>
                            <div t-if="showNow" class="evb-now evb-now-axis" t-att-style="'top:' + top(state.now) + 'px'">
                                <span t-esc="hhmm(state.now)"/>
                            </div>
                        </div>
                    </div>
                    <div t-foreach="state.data.rooms" t-as="room" t-key="room.id" class="evb-col">
                        <div class="evb-head" t-att-style="'border-top: 4px solid ' + room.color_hex">
                            <div class="evb-room"><t t-esc="room.name"/> <span t-if="!room.online" class="badge text-bg-secondary">interní</span></div>
                            <div class="evb-doctors">
                                <span t-foreach="room.overlaps" t-as="o" t-key="o.from" class="badge evb-overlap"
                                      title="Dvě lékařky v jedné ordinaci: pacient je ale vždy jen jeden naráz.">
                                    <t t-esc="o.label"/>
                                </span>
                                <span t-foreach="room.doctors" t-as="d" t-key="d.id" class="badge evb-doctor-chip"
                                      t-att-style="'background:' + d.color" t-att-title="bandTitle(d)">
                                    <t t-esc="d.name"/> <t t-esc="d.time_label"/>
                                </span>
                                
                            </div>
                        </div>
                        <div class="evb-col-body" t-att-style="'height:' + height(axis.from, axis.to) + 'px'"
                             t-on-click="(ev) => this.onColumnClick(ev, room)"
                             t-on-dragover="onDragOver" t-on-drop="(ev) => this.onDrop(ev, room)">
                            <div t-foreach="rows" t-as="m" t-key="m" class="evb-cell"
                                 t-att-class="{'evb-closed': !isOpen(room, m), 'evb-hour': m % 60 === 0}"
                                 t-att-style="'top:' + top(m) + 'px;height:' + height(m, m + state.data.step) + 'px'"/>
                            <div t-foreach="room.doctors" t-as="d" t-key="'d' + d.id" class="evb-band"
                                 t-att-style="bandStyle(d)" t-att-title="bandTitle(d)">
                                <span class="evb-band-text"><t t-esc="d.initials"/> <t t-esc="d.time_label"/></span>
                            </div>
                            <t t-foreach="globalBlocks" t-as="b" t-key="'g' + b.id">
                                <div t-if="isWebBlock(b)" class="evb-event evb-block evb-block-web"
                                     t-att-style="eventStyle(room, b)">
                                    <span class="evb-block-tag" t-att-title="webBlockTitle(b)" t-on-click.stop="() => this.openForm(b.id)">jen web · <t t-esc="b.name"/></span>
                                </div>
                                <div t-else="" class="evb-event evb-block"
                                     t-att-style="eventStyle(room, b)"
                                     t-on-click.stop="() => this.openForm(b.id)">
                                    <t t-esc="b.name"/>
                                </div>
                            </t>
                            <div t-foreach="webBlocksFor(room)" t-as="e" t-key="e.id"
                                 class="evb-event evb-block evb-block-web" t-att-style="eventStyle(room, e)">
                                <span class="evb-block-tag" draggable="true" t-att-title="webBlockTitle(e)"
                                      t-on-dragstart="(ev) => this.onDragStart(ev, e, 'event')" t-on-dragend="onDragEnd"
                                      t-on-click.stop="() => this.openForm(e.id)">jen web · <t t-esc="e.name"/></span>
                            </div>
                            <div t-foreach="otherEventsFor(room)" t-as="e" t-key="e.id" class="evb-event"
                                 t-att-class="{'evb-block': e.kind === 'block', 'evb-muted': e.state === 'done' || e.state === 'no_show', 'evb-short': isShort(e)}"
                                 t-att-style="eventStyle(room, e)"
                                 t-att-title="eventTitle(e)"
                                 draggable="true" t-on-dragstart="(ev) => this.onDragStart(ev, e, 'event')" t-on-dragend="onDragEnd"
                                 t-on-click.stop="() => this.openForm(e.id)">
                                <div class="evb-ev-line">
                                    <!-- Iniciály lékařky vlevo u jejího proužku, zkratka úkonu vpravo. -->
                                    <span t-if="e.doctor_initials" class="evb-initials" t-att-title="e.doctor" t-esc="e.doctor_initials"/>
                                    <span class="evb-ev-text"><t t-esc="e.time_label"/> · <t t-esc="eventLabel(e)"/></span>
                                    <span t-if="e.source === 'web'" class="evb-web" title="Z webu">🌐</span>
                                    <span t-if="e.spojena" class="evb-web" t-att-title="'Společný zákrok, také v: ' + e.spojena">🔗</span>
                                    <span t-if="e.symbol" class="evb-symbol" t-att-title="e.procedure" t-esc="e.symbol"/>
                                </div>
                                <div t-if="!isShort(e) and e.kind !== 'block' and e.procedure" class="evb-ev-proc" t-esc="e.procedure"/>
                            </div>
                            <t t-set="pv" t-value="previewFor(room)"/>
                            <div t-if="pv" class="evb-preview" t-att-class="previewClass(room, pv)" t-att-style="previewStyle(room, pv)">
                                <span class="evb-preview-label">
                                    <t t-if="pv.free">Náhled · </t><t t-else="">Požadovaný čas (obsazeno) · </t>
                                    <t t-esc="pv.time"/> · <t t-esc="pv.name"/>
                                </span>
                            </div>
                            <div t-if="showNow" class="evb-now" t-att-style="'top:' + top(state.now) + 'px'"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
