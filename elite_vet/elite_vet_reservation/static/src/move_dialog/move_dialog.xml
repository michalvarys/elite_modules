<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Task 25: confirm a move / a web request with the date, time and room still editable;
         task 28: the end time (Do) too. -->
    <t t-name="elite_vet_reservation.MoveConfirmDialog">
        <Dialog title="props.title" size="'md'" contentClass="'o_ev_move_dialog'">
            <div class="o_ev_move_fields">
                <label class="o_ev_move_field">
                    <span>Datum</span>
                    <input type="date" class="form-control o_ev_move_date" t-att-value="state.date"
                           t-on-change="onDate" t-on-input="onDate"/>
                </label>
                <label class="o_ev_move_field o_ev_move_field_time">
                    <span>Od</span>
                    <input type="time" class="form-control o_ev_move_time" t-att-value="state.time"
                           t-att-step="stepSeconds" t-on-change="onTime" t-on-input="onTime"/>
                </label>
                <label class="o_ev_move_field o_ev_move_field_time">
                    <span>Do</span>
                    <input type="time" class="form-control o_ev_move_end" t-att-value="state.endTime"
                           t-att-step="stepSeconds" t-on-change="onEndTime" t-on-input="onEndTime"
                           t-att-class="{'is-invalid': !endValid}"/>
                </label>
                <label class="o_ev_move_field o_ev_move_field_room">
                    <span>Ordinace</span>
                    <select class="form-select o_ev_move_room" t-on-change="onRoom">
                        <option t-foreach="props.rooms" t-as="room" t-key="room.id" t-att-value="room.id"
                                t-att-selected="room.id === state.roomId" t-esc="room.name"/>
                    </select>
                </label>
            </div>
            <p class="o_ev_move_question" t-esc="question"/>
            <div t-if="mailApplies" class="o_ev_move_mail">
                <div class="o_ev_move_mail_text" t-esc="props.mailText"/>
                <label class="o_ev_move_mail_check">
                    <input type="checkbox" class="form-check-input" t-att-checked="state.notify" t-on-change="onNotify"/>
                    <span t-esc="props.mailLabel"/>
                </label>
                <div t-if="!state.notify" class="o_ev_move_mail_off">Klient e-mail nedostane – v historii rezervace zůstane poznámka.</div>
            </div>
            <div t-if="state.error" class="alert alert-danger o_ev_move_error mb-0" role="alert">
                <span t-esc="state.error"/>
                <div t-if="state.canForce" class="o_ev_move_force_text">Můžete to přesto udělat – v historii rezervace zůstane poznámka.</div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o_ev_move_confirm" t-att-disabled="state.busy or unchanged"
                        t-on-click="() => this.confirm()" t-esc="props.confirmLabel"/>
                <button t-if="state.canForce" class="btn btn-warning o_ev_move_force" t-att-disabled="state.busy"
                        t-on-click="() => this.confirm(true)" t-esc="forceLabel"/>
                <button class="btn btn-secondary" t-att-disabled="state.busy" t-on-click="props.close">Zrušit</button>
            </t>
        </Dialog>
    </t>
</templates>
