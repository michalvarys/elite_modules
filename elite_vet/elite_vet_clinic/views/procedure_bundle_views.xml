<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_procedure_bundle_list" model="ir.ui.view">
        <field name="name">elite.vet.procedure.bundle.list</field>
        <field name="model">elite.vet.procedure.bundle</field>
        <field name="arch" type="xml">
            <list string="Balíčky výkonů">
                <field name="code"/>
                <field name="name"/>
                <field name="line_count"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount"/>
                <field name="edited_in_odoo" optional="show"/>
                <field name="winvet_ref" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_procedure_bundle_form" model="ir.ui.view">
        <field name="name">elite.vet.procedure.bundle.form</field>
        <field name="model">elite.vet.procedure.bundle</field>
        <field name="arch" type="xml">
            <form string="Balíček výkonů">
                <sheet>
                    <widget name="web_ribbon" title="Neaktivní" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Název balíčku"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="winvet_ref" invisible="not winvet_ref"/>
                            <field name="edited_in_odoo" invisible="not winvet_ref"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Popis"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="item_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="unit"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_procedure_bundle" model="ir.actions.act_window">
        <field name="name">Balíčky výkonů</field>
        <field name="res_model">elite.vet.procedure.bundle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
