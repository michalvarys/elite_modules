<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pet_form_clinic" model="ir.ui.view">
        <field name="name">elite.vet.pet.form.clinic</field>
        <field name="model">elite.vet.pet</field>
        <field name="inherit_id" ref="elite_vet_winvet.view_pet_form_winvet"/>
        <field name="arch" type="xml">
            <xpath expr="//form/*[1]" position="before">
                <header>
                    <button name="action_open_patient_card" type="object" string="Karta pacienta" class="btn-primary"
                            groups="elite_vet_reservation.group_reservation_reception"/>
                </header>
                <div class="alert alert-danger mb-0" role="alert" invisible="not alert_summary">
                    <strong>Upozornění: </strong><field name="alert_summary" class="d-inline"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Upozornění" name="alerts">
                    <field name="alert_ids" context="{'active_test': False}">
                        <list editable="bottom">
                            <field name="kind"/>
                            <field name="note"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                </page>
                <page string="Záznamy návštěv" name="clinical_records" invisible="not clinical_record_ids">
                    <field name="clinical_record_ids" readonly="1">
                        <list>
                            <field name="start"/>
                            <field name="doctor_id"/>
                            <field name="record_summary"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="amount_total"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Client with several pets: pick the one whose card should open. -->
    <record id="view_pet_list_patient_card" model="ir.ui.view">
        <field name="name">elite.vet.pet.list.patient.card</field>
        <field name="model">elite.vet.pet</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Mazlíčci" create="0" delete="0">
                <field name="name"/>
                <field name="species"/>
                <field name="breed"/>
                <field name="alert_summary"/>
                <button name="action_open_patient_card" type="object" string="Karta pacienta" icon="fa-paw"
                        class="btn-link"/>
            </list>
        </field>
    </record>
</odoo>
