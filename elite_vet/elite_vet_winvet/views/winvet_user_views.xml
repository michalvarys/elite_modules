<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_winvet_user_list" model="ir.ui.view">
        <field name="name">elite.vet.winvet.user.list</field>
        <field name="model">elite.vet.winvet.user</field>
        <field name="arch" type="xml">
            <list string="Uživatelé WinVet" create="0" delete="0" editable="bottom">
                <header>
                    <button name="action_match_doctors" type="object" string="Spárovat s lékařkami" display="always"/>
                </header>
                <field name="name" readonly="1"/>
                <field name="code" readonly="1"/>
                <field name="doctor_id"/>
                <field name="winvet_ref" optional="hide" readonly="1"/>
                <field name="active" widget="boolean_toggle" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="view_winvet_user_search" model="ir.ui.view">
        <field name="name">elite.vet.winvet.user.search</field>
        <field name="model">elite.vet.winvet.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="no_doctor" string="Bez lékařky" domain="[('doctor_id', '=', False)]"/>
                <filter name="archived" string="Neaktivní" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_winvet_user" model="ir.actions.act_window">
        <field name="name">Uživatelé WinVet</field>
        <field name="res_model">elite.vet.winvet.user</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Uživatelé přijdou z WinVetu s první synchronizací.</p>
            <p>Lékařky se k nim přiřadí samy podle jména; chybějící můžete doplnit ručně.</p>
        </field>
    </record>
</odoo>
