<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_list" model="ir.ui.view">
        <field name="name">elite.vet.payment.list</field>
        <field name="model">elite.vet.payment</field>
        <field name="arch" type="xml">
            <list string="Platby" create="0" delete="0" edit="0">
                <header>
                    <button name="%(elite_vet_winvet.action_cash_closure_wizard)d" type="action" string="Uzávěrka (PDF)"
                            display="always" groups="elite_vet_reservation.group_reservation_manager"/>
                </header>
                <field name="date"/>
                <field name="time" optional="hide"/>
                <field name="partner_id"/>
                <field name="document_id" optional="show"/>
                <field name="method"/>
                <field name="method_code" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount" sum="Celkem"/>
                <field name="from_deposit" optional="hide" sum="Celkem"/>
                <field name="state" optional="hide"/>
                <field name="refunded_date" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">elite.vet.payment.form</field>
        <field name="model">elite.vet.payment</field>
        <field name="arch" type="xml">
            <form string="Platba" create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="time"/>
                            <field name="partner_id"/>
                            <field name="document_id"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="method_code"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="from_deposit"/>
                            <field name="state"/>
                            <field name="refunded_date"/>
                            <field name="winvet_ref"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_payment_search" model="ir.ui.view">
        <field name="name">elite.vet.payment.search</field>
        <field name="model">elite.vet.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="document_id"/>
                <filter name="cash" string="Hotově" domain="[('method', '=', 'cash')]"/>
                <filter name="card" string="Kartou" domain="[('method', '=', 'card')]"/>
                <filter name="transfer" string="Převodem" domain="[('method', '=', 'transfer')]"/>
                <separator/>
                <filter name="refunded" string="Vrácené" domain="[('refunded_date', '!=', False)]"/>
                <filter name="date" string="Datum" date="date"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_month" string="Měsíc" context="{'group_by': 'date:month'}"/>
                    <filter name="group_day" string="Den" context="{'group_by': 'date:day'}"/>
                    <filter name="group_method" string="Forma úhrady" context="{'group_by': 'method'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_payment_pivot" model="ir.ui.view">
        <field name="name">elite.vet.payment.pivot</field>
        <field name="model">elite.vet.payment</field>
        <field name="arch" type="xml">
            <pivot string="Platby" sample="1">
                <field name="date" interval="month" type="row"/>
                <field name="method" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_payment_graph" model="ir.ui.view">
        <field name="name">elite.vet.payment.graph</field>
        <field name="model">elite.vet.payment</field>
        <field name="arch" type="xml">
            <graph string="Platby" type="bar" stacked="1" sample="1">
                <field name="date" interval="month"/>
                <field name="method"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Platby</field>
        <field name="res_model">elite.vet.payment</field>
        <field name="view_mode">pivot,graph,list,form</field>
    </record>
</odoo>
