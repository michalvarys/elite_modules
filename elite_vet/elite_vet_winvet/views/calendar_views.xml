<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kalendáře WinVetu -> ordinace (mapování, Vedení) -->
    <record id="view_winvet_calendar_resource_list" model="ir.ui.view">
        <field name="name">elite.vet.winvet.calendar.resource.list</field>
        <field name="model">elite.vet.winvet.calendar.resource</field>
        <field name="arch" type="xml">
            <list string="Kalendáře WinVetu" create="0" delete="0" editable="bottom">
                <field name="sequence" column_invisible="1"/>
                <field name="name"/>
                <field name="color" widget="color" readonly="1"/>
                <field name="visible"/>
                <field name="room_id" options="{'no_create': True}"/>
                <field name="room_manual"/>
                <field name="event_count"/>
                <field name="work_from" optional="hide"/>
                <field name="work_to" optional="hide"/>
                <field name="winvet_ref" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_winvet_calendar_resource" model="ir.actions.act_window">
        <field name="name">Kalendáře WinVetu → ordinace</field>
        <field name="res_model">elite.vet.winvet.calendar.resource</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Kalendáře přijdou z WinVetu s první synchronizací.</p>
            <p>Ordinace se přiřadí sama podle názvu („ORDINACE 1“ → „Ordinace 1“); skryté kalendáře
                WinVetu zůstanou bez ordinace. Ručně vybraná ordinace se už nemění.</p>
        </field>
    </record>

    <!-- Činnosti WinVetu -> úkony -->
    <record id="view_winvet_calendar_activity_list" model="ir.ui.view">
        <field name="name">elite.vet.winvet.calendar.activity.list</field>
        <field name="model">elite.vet.winvet.calendar.activity</field>
        <field name="arch" type="xml">
            <list string="Činnosti kalendáře WinVetu" create="0" delete="0" editable="bottom">
                <field name="name"/>
                <field name="symbol"/>
                <field name="duration"/>
                <field name="color" widget="color" readonly="1"/>
                <field name="procedure_id" options="{'no_create': True}"/>
                <field name="procedure_manual"/>
                <field name="web" optional="hide"/>
                <field name="winvet_ref" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_winvet_calendar_activity_search" model="ir.ui.view">
        <field name="name">elite.vet.winvet.calendar.activity.search</field>
        <field name="model">elite.vet.winvet.calendar.activity</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="unmapped" string="Bez úkonu" domain="[('procedure_id', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_winvet_calendar_activity" model="ir.actions.act_window">
        <field name="name">Činnosti WinVetu → úkony</field>
        <field name="res_model">elite.vet.winvet.calendar.activity</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Záznamy (jen čtení) -->
    <record id="view_winvet_calendar_event_list" model="ir.ui.view">
        <field name="name">elite.vet.winvet.calendar.event.list</field>
        <field name="model">elite.vet.winvet.calendar.event</field>
        <field name="arch" type="xml">
            <list string="Záznamy kalendáře WinVetu" create="0" edit="0" delete="0">
                <field name="start"/>
                <field name="stop"/>
                <field name="all_day"/>
                <field name="room_ids" widget="many2many_tags"/>
                <field name="name"/>
                <field name="activity_id"/>
                <field name="pet_id" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="manual_pet_id" optional="hide"/>
                <field name="title" optional="hide"/>
                <field name="recurring" optional="hide"/>
                <field name="done" optional="show"/>
                <field name="resource_ids" widget="many2many_tags" optional="hide"/>
                <field name="key" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_winvet_calendar_event_form" model="ir.ui.view">
        <field name="name">elite.vet.winvet.calendar.event.form</field>
        <field name="model">elite.vet.winvet.calendar.event</field>
        <field name="arch" type="xml">
            <form string="Záznam kalendáře WinVetu" create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-secondary" role="status">
                        Záznam z WinVetu – v Odoo jen pro čtení. Změny dělejte ve WinVetu, při další
                        synchronizaci se sem přenesou.
                    </div>
                    <h2><field name="name"/></h2>
                    <group>
                        <group>
                            <field name="start"/>
                            <field name="stop"/>
                            <field name="all_day"/>
                            <field name="room_ids" widget="many2many_tags"/>
                            <field name="resource_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="activity_id"/>
                            <field name="procedure_id"/>
                            <field name="pet_id"/>
                            <field name="partner_id"/>
                            <field name="title"/>
                            <field name="done"/>
                        </group>
                    </group>
                    <group string="WinVet">
                        <group>
                            <field name="key"/>
                            <field name="winvet_ref"/>
                            <field name="recurring"/>
                            <field name="occurrence_date" invisible="not recurring"/>
                        </group>
                        <group>
                            <field name="owner_ref"/>
                            <field name="patient_ref"/>
                            <field name="winvet_modified"/>
                        </group>
                    </group>
                    <group string="Spárováno na recepci" invisible="not manual_pet_id">
                        <group>
                            <field name="manual_pet_id"/>
                            <field name="manual_partner_id"/>
                        </group>
                        <group>
                            <field name="matched_by_id"/>
                            <field name="matched_at"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_winvet_calendar_event_search" model="ir.ui.view">
        <field name="name">elite.vet.winvet.calendar.event.search</field>
        <field name="model">elite.vet.winvet.calendar.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="room_ids"/>
                <field name="activity_id"/>
                <filter name="today" string="Dnes" domain="[('date', '&lt;=', context_today().strftime('%Y-%m-%d')), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="from_today" string="Od dneška" domain="[('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="timed" string="S časem" domain="[('all_day', '=', False)]"/>
                <filter name="all_day" string="Celodenní" domain="[('all_day', '=', True)]"/>
                <filter name="unmapped" string="Bez ordinace" domain="[('room_ids', '=', False)]"/>
                <filter name="with_pet" string="Se zvířetem z kartotéky" domain="[('pet_id', '!=', False)]"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_date" string="Den" context="{'group_by': 'date:day'}"/>
                    <filter name="group_activity" string="Činnost" context="{'group_by': 'activity_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_winvet_calendar_event" model="ir.actions.act_window">
        <field name="name">Záznamy z WinVetu</field>
        <field name="res_model">elite.vet.winvet.calendar.event</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_from_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Zatím žádné záznamy kalendáře z WinVetu.</p>
            <p>Most WinVet je pošle při každém běhu (okno od včerejška na 60 dní dopředu).</p>
        </field>
    </record>

    <!-- Nastavení: vypnout / zapnout / smazat -->
    <record id="view_winvet_calendar_settings_form" model="ir.ui.view">
        <field name="name">elite.vet.winvet.calendar.settings.form</field>
        <field name="model">elite.vet.winvet.calendar.settings</field>
        <field name="arch" type="xml">
            <form string="Kalendář z WinVetu" create="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not enabled">
                        <strong>Kalendář z WinVetu je zapnutý.</strong> Záznamy z WinVetu se ukazují na tabuli
                        (v pokladně i v Odoo) jako „z WinVetu“ a záznamy s časem v namapované ordinaci
                        obsazují termín pro všechna objednávání v Odoo (web, chat, recepce, pokladna).
                    </div>
                    <div class="alert alert-warning" role="status" invisible="enabled">
                        <strong>Kalendář z WinVetu je vypnutý.</strong> Přenesené záznamy se nikde neukazují,
                        nic neblokují a nové záznamy z mostu se neukládají.
                    </div>
                    <group>
                        <group>
                            <field name="enabled"/>
                            <field name="event_count"/>
                            <field name="timed_count"/>
                            <field name="unmapped_count"/>
                        </group>
                        <group>
                            <field name="first_date"/>
                            <field name="last_date"/>
                        </group>
                    </group>
                    <button name="action_disable" type="object" class="btn-warning" string="Vypnout kalendář z WinVetu"
                            invisible="not enabled"
                            confirm="Záznamy z WinVetu zmizí z tabule a přestanou blokovat termíny. Most je dál posílá, ale Odoo je neukládá. Pokračovat?"/>
                    <button name="action_enable" type="object" class="btn-primary" string="Zapnout kalendář z WinVetu"
                            invisible="enabled"/>
                    <button name="action_purge" type="object" class="btn-outline-danger ms-2" string="Smazat přenesené záznamy"
                            confirm="Smaže všechny záznamy kalendáře přenesené z WinVetu (ve WinVetu zůstanou). Je-li kalendář zapnutý, další běh mostu okno znovu naplní. Pokračovat?"/>
                    <div class="text-muted mt-3">
                        Mapování kalendářů na ordinace a činností na úkony je v menu WinVet data → Kalendář z WinVetu.
                        WinVet se nikdy nemění – most z něj jen čte.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_winvet_calendar_settings" model="ir.actions.act_window">
        <field name="name">Kalendář z WinVetu</field>
        <field name="res_model">elite.vet.winvet.calendar.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
