<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_winvet_item_list" model="ir.ui.view">
        <field name="name">elite.vet.winvet.item.list</field>
        <field name="model">elite.vet.winvet.item</field>
        <field name="arch" type="xml">
            <list string="Ceník" create="0" delete="0" edit="0">
                <field name="code"/>
                <field name="name"/>
                <field name="classification"/>
                <field name="kind"/>
                <field name="unit"/>
                <field name="stock_tracked" optional="show"/>
                <field name="tracked_drug" optional="show"/>
                <field name="barcode" optional="hide"/>
                <field name="winvet_ref" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_winvet_item_form" model="ir.ui.view">
        <field name="name">elite.vet.winvet.item.form</field>
        <field name="model">elite.vet.winvet.item</field>
        <field name="arch" type="xml">
            <form string="Položka ceníku" create="0" delete="0" edit="0">
                <sheet>
                    <widget name="web_ribbon" title="Neaktivní" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="classification"/>
                            <field name="kind"/>
                            <field name="unit"/>
                        </group>
                        <group>
                            <field name="stock_tracked"/>
                            <field name="tracked_drug"/>
                            <field name="barcode"/>
                            <field name="winvet_ref"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_winvet_item_search" model="ir.ui.view">
        <field name="name">elite.vet.winvet.item.search</field>
        <field name="model">elite.vet.winvet.item</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="barcode"/>
                <filter name="services" string="Úkony" domain="[('kind', '=', 'service')]"/>
                <filter name="products" string="Léky a zboží" domain="[('kind', '=', 'product')]"/>
                <filter name="tracked_drug" string="Sledovaná léčiva" domain="[('tracked_drug', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Neaktivní" domain="[('active', '=', False)]"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_kind" string="Druh" context="{'group_by': 'kind'}"/>
                    <filter name="group_classification" string="Klasifikace" context="{'group_by': 'classification'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_winvet_item" model="ir.actions.act_window">
        <field name="name">Ceník</field>
        <field name="res_model">elite.vet.winvet.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
