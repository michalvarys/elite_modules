<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read-only access to everything the WinVet bridge stores, meant for an API account (an agent
         reading the data with an API key). Only read rights: the account cannot change anything
         through the API. Give it to a user without the Recepce / Vedení roles. -->
    <record id="module_category_winvet_readonly" model="ir.module.category">
        <field name="name">WinVet data</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_winvet_readonly" model="res.groups">
        <field name="name">Jen čtení (API)</field>
        <field name="category_id" ref="module_category_winvet_readonly"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Čte všechna data z WinVetu (kartotéka, návštěvy, tržby, platby, zálohy, výdaje, sklad,
            kalendář, stav synchronizace), nic nemění. Pro účet, přes který data čte agent přes API.</field>
    </record>
</odoo>
