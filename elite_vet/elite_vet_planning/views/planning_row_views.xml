<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_planning_row_list" model="ir.ui.view">
        <field name="name">elite.vet.planning.row.list</field>
        <field name="model">elite.vet.planning.row</field>
        <field name="arch" type="xml">
            <list string="Úseky plánu">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="room_id"/>
                <field name="slot_ids" widget="many2many_tags" string="Směny"/>
            </list>
        </field>
    </record>

    <record id="view_planning_row_form" model="ir.ui.view">
        <field name="name">elite.vet.planning.row.form</field>
        <field name="model">elite.vet.planning.row</field>
        <field name="arch" type="xml">
            <form string="Úsek plánu">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="např. Ordinace 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind"/>
                            <field name="room_id" invisible="kind == 'helpers'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="preferred_roles"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="slot_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="hour_from" widget="float_time"/>
                            <field name="hour_to" widget="float_time"/>
                            <field name="days"/>
                            <field name="type_id" options="{'no_create': True}"/>
                        </list>
                    </field>
                    <div class="alert alert-info" role="status">
                        Služba lékařky v úseku s ordinací se sama propíše do kalendáře rezervací.
                        Sestry, recepce a výpomoc se do rezervací nepropisují. Typ směny určuje barvu
                        a legendu na webu /rozpis-lekaru; čas na webu je čas typu.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_planning_row" model="ir.actions.act_window">
        <field name="name">Úseky plánu</field>
        <field name="res_model">elite.vet.planning.row</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
