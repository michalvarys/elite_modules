<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Request 16. 11.: a doctor on duty who is not listed on /rozpis-lekaru (an extra doctor
         strengthening a weekend). The service stays in the reservation calendar. -->
    <record id="view_vet_shift_form_web" model="ir.ui.view">
        <field name="name">elite.vet.shift.form.planning.web</field>
        <field name="model">elite.vet.shift</field>
        <field name="inherit_id" ref="elite_vet_calendar.view_vet_shift_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='doctor_id']" position="after">
                <field name="hide_on_web" invisible="is_note"/>
            </xpath>
        </field>
    </record>

    <record id="view_vet_shift_list_web" model="ir.ui.view">
        <field name="name">elite.vet.shift.list.planning.web</field>
        <field name="model">elite.vet.shift</field>
        <field name="inherit_id" ref="elite_vet_calendar.view_vet_shift_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='doctor_id']" position="after">
                <field name="hide_on_web" optional="show" readonly="is_note"/>
            </xpath>
        </field>
    </record>
</odoo>
