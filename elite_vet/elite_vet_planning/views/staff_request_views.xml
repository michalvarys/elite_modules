<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_staff_request_list" model="ir.ui.view">
        <field name="name">elite.vet.staff.request.list</field>
        <field name="model">elite.vet.staff.request</field>
        <field name="arch" type="xml">
            <list string="Availability and absences" editable="bottom">
                <field name="date"/>
                <field name="member_id"/>
                <field name="code"/>
                <field name="note"/>
                <field name="entered_by_member" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_staff_request_search" model="ir.ui.view">
        <field name="name">elite.vet.staff.request.search</field>
        <field name="model">elite.vet.staff.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id"/>
                <field name="date"/>
                <filter name="absence" string="Absence" domain="[('is_absence', '=', True)]"/>
                <filter name="vacation" string="Vacation" domain="[('code', '=', 'D')]"/>
                <group>
                    <filter name="by_member" string="Team member" context="{'group_by': 'member_id'}"/>
                    <filter name="by_code" string="Record" context="{'group_by': 'code'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_staff_request" model="ir.actions.act_window">
        <field name="name">Availability and absences</field>
        <field name="res_model">elite.vet.staff.request</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
