<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Personál: the roster list (Rozpis služeb › Lékařky) with the planning profile. -->
    <record id="view_vet_doctor_list_planning" model="ir.ui.view">
        <field name="name">elite.vet.doctor.list.planning</field>
        <field name="model">elite.vet.doctor</field>
        <field name="inherit_id" ref="elite_vet_calendar.view_vet_doctor_list"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="initials" optional="show"/>
                <field name="staff_role" optional="show"/>
                <field name="weekly_hours" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_vet_doctor_form_planning" model="ir.ui.view">
        <field name="name">elite.vet.doctor.form.planning</field>
        <field name="model">elite.vet.doctor</field>
        <field name="inherit_id" ref="elite_vet_calendar.view_vet_doctor_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Staff planning" name="planning">
                    <group>
                        <field name="staff_role"/>
                        <field name="initials"/>
                        <field name="weekly_hours"/>
                        <field name="in_planning"/>
                    </group>
                    <group>
                        <field name="vacation_days"/>
                        <field name="vacation_taken"/>
                        <field name="vacation_left"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_vet_doctor_staff_list" model="ir.ui.view">
        <field name="name">elite.vet.doctor.staff.list</field>
        <field name="model">elite.vet.doctor</field>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <list string="Staff" editable="bottom">
                <field name="planning_sequence" widget="handle"/>
                <field name="name"/>
                <field name="initials"/>
                <field name="staff_role"/>
                <field name="weekly_hours"/>
                <field name="calendar_color" widget="color" string="Color"/>
                <field name="accepts_bookings" string="Doctor (bookings)" optional="hide"/>
                <field name="user_id" options="{'no_create': True}" optional="show"/>
                <field name="vacation_days" optional="show"/>
                <field name="vacation_left" optional="show"/>
                <field name="in_planning"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_staff" model="ir.actions.act_window">
        <field name="name">Staff</field>
        <field name="res_model">elite.vet.doctor</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_vet_doctor_staff_list"/>
        <field name="context">{'active_test': False}</field>
        <field name="domain">[]</field>
    </record>
</odoo>
