<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="elite_vet_planning.Planner">
        <div class="evp o_action">
            <div class="evp-toolbar">
                <div class="btn-group">
                    <button class="btn btn-secondary" t-on-click="() => this.goMonth(-1)" title="Previous month">‹</button>
                    <span class="btn btn-light evp-month" t-esc="monthLabel"/>
                    <button class="btn btn-secondary" t-on-click="() => this.goMonth(1)" title="Next month">›</button>
                </div>
                <div class="evp-tools">
                    <span t-if="state.busy" class="text-muted evp-saving">Saving…</span>
                    <span t-else="" class="text-muted evp-saving">All changes saved</span>
                    <button t-if="state.data and assignmentCount" class="btn btn-warning"
                            t-on-click="adoptAssignments"
                            title="Turns the services entered in Rezervace › Rozpis lékařů into roster shifts, planned here from then on">
                        Take over services from Rozpis lékařů (<t t-esc="assignmentCount"/>)
                    </button>
                    <button class="btn btn-secondary" t-on-click="openStaff">Staff</button>
                    <button class="btn btn-secondary" t-on-click="exportCsv" title="Download for Excel">Export CSV</button>
                    <button class="btn btn-secondary" t-on-click="print">Print</button>
                </div>
            </div>

            <div t-if="state.data" class="evp-body">
                <h2 class="evp-print-title">Shift roster – <t t-esc="monthLabel"/></h2>

                <!-- Požadavky na směny above the plan (Lucie, 3. 11.): resizable by the bottom edge,
                     scrolls inside, day columns aligned and scrolled together with the plan. -->
                <div class="evp-req-panel">
                    <div class="evp-req-panel-head">
                        <button class="btn btn-sm btn-link" t-on-click="toggleRequests">
                            <t t-esc="state.reqOpen ? '▾' : '▸'"/> Shift requests
                        </button>
                        <small t-if="state.reqOpen" class="text-muted">Click or type a letter in a cell (D, N, L, P, S, M, R, O, V, Del) · dot = entered by themselves · drag the bottom edge to resize</small>
                    </div>
                    <t t-if="state.reqOpen">
                        <div class="evp-scroll evp-req-scroll" t-ref="reqScroll" t-att-style="'height:' + state.reqHeight + 'px'"
                             t-on-scroll="onReqScroll">
                            <t t-call="elite_vet_planning.PlannerRequestsTable"/>
                        </div>
                        <div class="evp-resize" title="Drag to resize" t-on-pointerdown="startResize"/>
                    </t>
                </div>
                <div class="evp-scroll" t-ref="gridScroll" t-on-scroll="onGridScroll">
                    <table class="evp-grid">
                        <thead>
                            <tr>
                                <th class="evp-head-row">Section / shift</th>
                                <t t-foreach="days" t-as="day" t-key="day.date">
                                    <th t-att-class="dayClass(day, 'evp-day')" t-att-title="day.holiday or null">
                                        <div class="evp-day-num" t-esc="day.day"/>
                                        <div class="evp-day-wd" t-esc="weekdayAbbr(day)"/>
                                        <div t-if="day.note" class="evp-day-note" t-att-title="day.note" t-esc="day.note"/>
                                        <button t-if="day.weekday === 0" class="evp-copy" title="Copy the shifts of the previous week here"
                                                t-on-click="(ev) => this.copyWeek(day, ev)">⧉</button>
                                    </th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data.rows" t-as="row" t-key="row.id">
                                <t t-foreach="row.slots" t-as="slot" t-key="slot.id">
                                    <tr t-attf-class="#{slot_first ? 'evp-row-first' : ''} evp-kind-#{row.kind}">
                                        <th class="evp-head-row">
                                            <span t-if="slot_first" class="evp-row-name" t-esc="row.name"/>
                                            <span class="evp-slot-name"><t t-esc="slot.name"/> <small t-esc="slot.time"/></span>
                                        </th>
                                        <t t-foreach="days" t-as="day" t-key="day.date">
                                            <t t-set="applies" t-value="slotApplies(slot, day)"/>
                                            <t t-set="items" t-value="cellShifts(slot, day)"/>
                                            <td t-att-class="dayClass(day, 'evp-cell' + (applies ? '' : ' evp-off'))"
                                                t-on-click="() => this.openCell(row, slot, day)">
                                                <t t-foreach="items" t-as="shift" t-key="shift.id">
                                                    <t t-set="conflict" t-value="chipConflict(shift)"/>
                                                    <span t-attf-class="evp-chip #{conflict or notBooked(shift) ? 'evp-chip-warn' : ''} #{shift.assignment ? 'evp-chip-assign' : ''}" t-att-style="chipStyle(shift)"
                                                          t-att-title="chipTitle(shift)">
                                                        <t t-esc="chipLabel(shift)"/>
                                                        <small t-if="chipTime(shift, slot)" t-esc="chipTime(shift, slot)"/>
                                                        <button class="evp-x" title="Remove" t-on-click="(ev) => this.removeShift(shift, ev)">×</button>
                                                    </span>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                            <tr class="evp-row-first evp-absence-row">
                                <th class="evp-head-row"><span class="evp-row-name">Absence</span>
                                    <span class="evp-slot-name"><small>D · NV · L · PN · Š</small></span></th>
                                <t t-foreach="days" t-as="day" t-key="day.date">
                                    <td t-att-class="dayClass(day, 'evp-cell evp-absences')">
                                        <t t-foreach="absencesOn(day)" t-as="r" t-key="r.member_id">
                                            <span class="evp-abs" t-att-title="(staffById[r.member_id].name) + (r.note ? ' – ' + r.note : '')">
                                                <t t-esc="staffById[r.member_id].initials"/> <b t-esc="r.short"/>
                                            </span>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <h3 class="evp-h3">Hours balance</h3>
                <div class="evp-scroll">
                    <table class="evp-balance">
                        <thead>
                            <tr>
                                <th>Full name</th><th>Contract</th><th>Fund</th><th>Worked</th><th>Morning</th>
                                <th>Afternoon</th><th>Full day (12 h)</th><th>Weekends</th><th>Absence</th><th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="state.data.staff" t-as="m" t-key="m.id">
                                <t t-set="b" t-value="balance(m)"/>
                                <tr>
                                    <td><span class="evp-chip" t-attf-style="background:#{m.color};color:#{textOn(m.color)}" t-esc="m.initials"/> <t t-esc="m.name"/></td>
                                    <td><t t-esc="fmt(m.weekly_hours)"/> h/wk</td>
                                    <td><t t-esc="fmt(b.fond)"/> h</td>
                                    <td t-att-title="workedTitle(b)"><t t-esc="fmt(b.worked)"/> h</td>
                                    <td t-esc="b.morning"/>
                                    <td t-esc="b.afternoon"/>
                                    <td t-esc="b.full_day"/>
                                    <td><t t-esc="b.weekend"/> <small class="text-muted" t-if="b.weekend">(<t t-esc="fmt(b.weekend_hours)"/> h)</small></td>
                                    <td t-esc="absenceText(m)"/>
                                    <td t-attf-class="evp-saldo #{b.saldo &gt; 0.05 ? 'evp-plus' : (b.saldo &lt; -0.05 ? 'evp-minus' : '')}">
                                        <t t-if="b.saldo &gt; 0.05">+</t><t t-esc="fmt(b.saldo)"/> h
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <p class="evp-help text-muted">
                    Fund = working days of the month without holidays × contract / 5. A morning and an afternoon shift on one day count once (8–16 + 12–20 = 12 h, full day). D, L and Š count as a worked day, NV and PN do not. Doctors' services in sections with a room go to the reservation calendar by themselves.
                </p>
            </div>

            <!-- ================= cell dialog ================= -->
            <div t-if="state.cell" class="evp-modal-back" t-on-click.self="closeCell">
                <div class="evp-modal" role="dialog">
                    <div class="evp-modal-head">
                        <b t-esc="cellTitle"/>
                        <button class="btn-close" t-on-click="closeCell" aria-label="Close"/>
                    </div>
                    <div t-if="openShifts.length" class="evp-current">
                        <t t-foreach="openShifts" t-as="shift" t-key="shift.id">
                            <div class="evp-current-row">
                                <span class="evp-chip" t-att-style="chipStyle(shift)" t-esc="chipLabel(shift)"/>
                                <span class="evp-current-name" t-esc="shiftName(shift)"/>
                                <input class="form-control form-control-sm evp-time" t-att-value="hm(shift.hour_from)"
                                       t-on-change="(ev) => this.changeTime(shift, 'hour_from', ev)"/>
                                <span>–</span>
                                <input class="form-control form-control-sm evp-time" t-att-value="hm(shift.hour_to)"
                                       t-on-change="(ev) => this.changeTime(shift, 'hour_to', ev)"/>
                                <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.removeShift(shift)">Delete</button>
                            </div>
                            <div t-if="chipConflict(shift)" class="evp-warn" t-esc="chipConflict(shift)"/>
                            <div t-if="shift.booking and shift.booking.ok !== null"
                                 t-attf-class="evp-booking #{shift.booking.ok ? 'evp-booking-ok' : 'evp-warn'}">
                                <t t-if="shift.booking.ok">✓ </t><t t-esc="shift.booking.text"/>
                            </div>
                        </t>
                    </div>
                    <div class="evp-times">
                        <span class="text-muted">Time of the new shift:</span>
                        <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.setPreset(state.cell.slot.hour_from, state.cell.slot.hour_to)" t-esc="state.cell.slot.time"/>
                        <t t-foreach="presets" t-as="p" t-key="p_index">
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.setPreset(p[0], p[1])"><t t-esc="p[0]"/>–<t t-esc="p[1]"/></button>
                        </t>
                        <input class="form-control form-control-sm evp-time" t-model="state.newFrom" title="From"/>
                        <span>–</span>
                        <input class="form-control form-control-sm evp-time" t-model="state.newTo" title="To"/>
                    </div>
                    <div class="evp-pick">
                        <p class="text-muted small mb-1">Click to add a person. Another click adds another one (+ together).</p>
                        <t t-foreach="pickerGroups()" t-as="group" t-key="group.key">
                            <div class="evp-pick-group">
                                <div class="evp-pick-label" t-esc="group.label"/>
                                <t t-foreach="group.staff" t-as="m" t-key="m.id">
                                    <button t-attf-class="evp-pick-btn #{memberState(m)}" t-on-click="() => this.addMember(m)"
                                            t-att-disabled="state.busy">
                                        <span class="evp-chip" t-attf-style="background:#{m.color};color:#{textOn(m.color)}" t-esc="m.initials"/>
                                        <span t-esc="m.name"/>
                                        <small t-if="memberHint(m)" class="evp-hint" t-esc="memberHint(m)"/>
                                    </button>
                                </t>
                            </div>
                        </t>
                        <div t-if="state.cell.row.kind === 'helpers'" class="evp-helper">
                            <input class="form-control form-control-sm" t-model="state.helperName" placeholder="Other name or note (intern, temp)"
                                   t-on-keydown="onHelperKey"/>
                            <button class="btn btn-sm btn-primary" t-on-click="addHelper">Add</button>
                        </div>
                    </div>
                    <div class="evp-modal-foot">
                        <span t-if="state.cell.row.room" class="text-muted small">A doctor's service goes to reservations: <t t-esc="state.cell.row.room"/></span>
                        <button class="btn btn-primary" t-on-click="closeCell">Done</button>
                    </div>
                </div>
            </div>

            <!-- ================= request picker ================= -->
            <div t-if="state.picker" class="evp-modal-back" t-on-click.self="() => this.state.picker = null">
                <div class="evp-modal evp-modal-sm" role="dialog">
                    <div class="evp-modal-head">
                        <b><t t-esc="state.picker.member.name"/> · <t t-esc="dayTitle(state.picker.day)"/></b>
                        <button class="btn-close" t-on-click="() => this.state.picker = null" aria-label="Close"/>
                    </div>
                    <input class="form-control mb-2" t-model="state.picker.note" placeholder="Note for the day (optional)"/>
                    <div class="evp-codes">
                        <t t-foreach="state.data.codes" t-as="c" t-key="c.key">
                            <button t-attf-class="btn btn-sm evp-code-btn evp-code-#{c.key}" t-on-click="() => this.pickCode(c.key)">
                                <b t-esc="c.short"/> <t t-esc="c.label"/>
                            </button>
                        </t>
                    </div>
                    <div class="evp-modal-foot">
                        <button class="btn btn-sm btn-outline-danger" t-on-click="() => this.pickCode(false)">Delete record</button>
                        <button class="btn btn-sm btn-secondary" t-on-click="saveNoteOnly">Save the note only</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
    <t t-name="elite_vet_planning.PlannerRequestsTable">
        <table class="evp-grid evp-requests">
            <thead>
                <tr>
                    <th class="evp-head-row">Full name</th>
                    <t t-foreach="days" t-as="day" t-key="day.date">
                        <th t-att-class="dayClass(day, 'evp-day')" t-att-title="day.holiday or null">
                            <div class="evp-day-num" t-esc="day.day"/>
                            <div class="evp-day-wd" t-esc="weekdayAbbr(day)"/>
                        </th>
                    </t>
                    <th class="evp-sum">D</th>
                    <th class="evp-sum">NV</th>
                    <th class="evp-note-col">Month note</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="staffGroups" t-as="group" t-key="group.key">
                    <t t-foreach="group.staff" t-as="m" t-key="m.id">
                        <tr t-attf-class="evp-role-#{m.role} #{m_first ? 'evp-row-first' : ''}">
                            <th class="evp-head-row">
                                <span class="evp-order">
                                    <button t-att-disabled="m_first" t-on-click="() => this.moveMember(m, -1)" title="Up">▲</button>
                                    <button t-att-disabled="m_last" t-on-click="() => this.moveMember(m, 1)" title="Down">▼</button>
                                </span>
                                <span class="evp-chip" t-attf-style="background:#{m.color};color:#{textOn(m.color)}" t-esc="m.initials"/>
                                <span class="evp-member-name" t-esc="m.name"/>
                                <small t-if="m_first" class="evp-role-label" t-esc="group.label"/>
                            </th>
                            <t t-foreach="days" t-as="day" t-key="day.date">
                                <t t-set="req" t-value="request(m.id, day.date)"/>
                                <td t-att-class="requestClass(m, day)" tabindex="0" t-att-data-req="m.id + '|' + day.date"
                                    t-att-title="req and req.note or null"
                                    t-on-click="() => this.openPicker(m, day)"
                                    t-on-keydown="(ev) => this.onRequestKey(m, day, ev)">
                                    <t t-if="req"><t t-esc="req.short"/><i t-if="req.self" class="evp-self">•</i><i t-if="req.note" class="evp-has-note">✎</i></t>
                                </td>
                            </t>
                            <td class="evp-sum" t-esc="countCode(m, 'D')"/>
                            <td class="evp-sum" t-esc="countCode(m, 'NV')"/>
                            <td class="evp-note-col">
                                <input class="form-control form-control-sm" t-att-value="monthNote(m)"
                                       t-on-change="(ev) => this.saveMonthNote(m, ev)" placeholder="Note…"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </tbody>
        </table>
    </t>
</templates>
