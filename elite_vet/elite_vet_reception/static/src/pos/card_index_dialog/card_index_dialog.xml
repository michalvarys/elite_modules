<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Task 22 pet fields (top fields, collapsible Další údaje, Upozornění) on the pet form `pf`;
         task 31: also the pet part of Nový klient. `prefix` "" = the pet form (Jméno and Druh
         required), "pet_" = with a new client (the pet is optional). Uhynulý stays in the pet form. -->
    <t t-name="elite_vet_reception.CardIndexPetFields">
        <div class="row g-2">
            <label class="col-12 col-md-6 o_ev_field"><b><t t-if="prefix">Jméno zvířete</t><t t-else="">Jméno *</t></b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'name'" t-model="pf.values.name"
                       t-att-required="prefix ? undefined : 'required'"/></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Druh<t t-if="!prefix"> *</t></b>
                <select class="form-select form-select-lg" t-att-name="prefix + 'species'" t-model="pf.values.species">
                    <option t-foreach="state.species" t-as="opt" t-key="opt.value" t-att-value="opt.value" t-esc="opt.label"/>
                </select></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Pohlaví</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'sex'" t-model="pf.values.sex" list="o_ev_sex_options"/>
                <datalist id="o_ev_sex_options">
                    <option value="pes"/><option value="fena"/><option value="kocour"/><option value="kočka"/>
                    <option value="samec"/><option value="samice"/>
                </datalist></label>
            <label t-if="pf.values.species === 'other'" class="col-12 col-md-6 o_ev_field o_ev_species_other"><b>Jiný druh</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'species_other'" t-model="pf.values.species_other"
                       placeholder="např. fretka, želva"/></label>
            <label class="col-12 col-md-6 o_ev_field"><b>Plemeno</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'breed'" t-model="pf.values.breed"/></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Narození</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'birth_date'" type="date" t-model="pf.values.birth_date"/></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Čip</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'chip'" t-model="pf.values.chip"/></label>
        </div>

        <button type="button" class="btn btn-link px-0 mt-2 o_ev_more_toggle" t-att-aria-expanded="pf.showMore ? 'true' : 'false'"
                t-on-click="() => this.toggleMore(pf)">
            <i t-att-class="pf.showMore ? 'fa fa-caret-down' : 'fa fa-caret-right'" class="me-1" aria-hidden="true"/>Další údaje
            <small class="text-muted">(nepovinné)</small>
        </button>
        <div t-if="pf.showMore" class="row g-2 o_ev_pet_more">
            <label class="col-6 col-md-3 o_ev_field"><b>Rok narození</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'birth_year'" inputmode="numeric" maxlength="4"
                       t-model="pf.values.birth_year" placeholder="např. 2019"/>
                <small class="text-muted">když datum neznáte</small></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Hmotnost (kg)</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'weight'" inputmode="decimal"
                       t-model="pf.values.weight" placeholder="např. 12,5"/></label>
            <label class="col-12 col-md-6 o_ev_field"><b>Barva</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'color'" t-model="pf.values.color"/></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Tetování</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'tattoo'" t-model="pf.values.tattoo"/></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Číslo pasu</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'passport'" t-model="pf.values.passport"/></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Příští vakcinace</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'next_vaccination'" type="date" t-model="pf.values.next_vaccination"/></label>
            <label class="col-6 col-md-3 o_ev_field"><b>Příští odčervení</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'next_deworming'" type="date" t-model="pf.values.next_deworming"/></label>
            <label class="col-12 o_ev_field"><b>Důležité</b>
                <input class="form-control form-control-lg" t-att-name="prefix + 'important_note'" t-model="pf.values.important_note"
                       placeholder="krátce – ukáže se jako červený štítek u zvířete"/></label>
            <label class="col-12 o_ev_field"><b>Poznámka</b>
                <textarea class="form-control" t-att-name="prefix + 'note'" rows="2" t-model="pf.values.note"/></label>
        </div>

        <div class="mt-3 o_ev_alerts">
            <div class="o_ev_field"><b>Upozornění</b></div>
            <div t-foreach="pf.alerts" t-as="alert" t-key="alert.key" class="d-flex flex-wrap gap-2 mt-2 o_ev_alert_row">
                <select class="form-select form-select-lg o_ev_alert_kind" t-model="alert.kind" aria-label="Druh upozornění">
                    <option t-foreach="state.alertKinds" t-as="opt" t-key="opt.value" t-att-value="opt.value" t-esc="opt.label"/>
                </select>
                <input class="form-control form-control-lg o_ev_grow o_ev_alert_note" t-model="alert.note"
                       placeholder="např. náhubek, penicilin" aria-label="Poznámka upozornění"/>
                <button type="button" class="btn btn-light btn-lg o_ev_alert_remove" t-on-click="() => this.removeAlert(pf, alert)"
                        title="Odebrat upozornění" aria-label="Odebrat upozornění"><i class="fa fa-trash" aria-hidden="true"/></button>
            </div>
            <button type="button" class="btn btn-secondary mt-2 o_ev_alert_add" t-on-click="() => this.addAlert(pf)">+ Upozornění</button>
        </div>
    </t>

    <t t-name="elite_vet_reception.CardIndexDialog">
        <Dialog title="title" size="'xl'" contentClass="'o_ev_card_index o_ev_card_index_' + mode">
            <p class="text-muted mb-2 o_ev_purpose" t-esc="hint"/>
            <div t-if="mode === 'winvet' and props.winvet and props.winvet.winvet_title" class="o_ev_winvet_text mb-2">
                <span class="badge o_ev_winvet_badge me-1">WinVet</span><span class="o_ev_winvet_title" t-esc="props.winvet.winvet_title"/>
            </div>
            <form class="d-flex gap-2 mb-3" t-on-submit="onSearchSubmit">
                <input type="search" class="form-control form-control-lg o_ev_search" t-model="state.term"
                       placeholder="Hledat: jméno, telefon, čip, zvíře …" autofocus="autofocus"/>
                <button type="submit" class="btn btn-primary btn-lg" t-att-disabled="state.searching">
                    <i class="fa fa-search me-1"/>Hledat
                </button>
                <button type="button" class="btn btn-secondary btn-lg text-nowrap o_ev_new_owner" t-on-click="newOwner">+ Nový klient</button>
            </form>

            <!-- Owner form (new or edit) -->
            <form t-if="state.ownerForm" class="o_ev_form o_ev_owner_form" t-on-submit="saveOwner">
                <h4 t-if="state.ownerForm.isNew">Nový klient</h4>
                <h4 t-else="">Upravit klienta</h4>
                <div class="row g-2">
                    <label class="col-12 col-md-6 o_ev_field"><b>Jméno *</b>
                        <input class="form-control form-control-lg" name="name" t-model="state.ownerForm.values.name" required="required"/></label>
                    <label class="col-6 col-md-3 o_ev_field"><b>Telefon</b>
                        <input class="form-control form-control-lg" name="phone" type="tel" t-model="state.ownerForm.values.phone"/></label>
                    <label class="col-6 col-md-3 o_ev_field"><b>Mobil</b>
                        <input class="form-control form-control-lg" name="mobile" type="tel" t-model="state.ownerForm.values.mobile"/></label>
                    <label class="col-12 col-md-6 o_ev_field"><b>E-mail</b>
                        <input class="form-control form-control-lg" name="email" type="email" t-model="state.ownerForm.values.email"/></label>
                    <label class="col-12 col-md-6 o_ev_field"><b>Ulice</b>
                        <input class="form-control form-control-lg" name="street" t-model="state.ownerForm.values.street"/></label>
                    <label class="col-8 col-md-4 o_ev_field"><b>Město</b>
                        <input class="form-control form-control-lg" name="city" t-model="state.ownerForm.values.city"/></label>
                    <label class="col-4 col-md-2 o_ev_field"><b>PSČ</b>
                        <input class="form-control form-control-lg" name="zip" t-model="state.ownerForm.values.zip"/></label>
                </div>
                <t t-if="state.ownerForm.isNew">
                    <h5 class="mt-3">Zvíře <small class="text-muted">(nepovinné, další jde přidat potom)</small></h5>
                    <div class="o_ev_new_owner_pet">
                        <t t-call="elite_vet_reception.CardIndexPetFields">
                            <t t-set="pf" t-value="state.ownerForm.pet"/>
                            <t t-set="prefix" t-value="'pet_'"/>
                        </t>
                    </div>
                </t>
                <div t-if="state.ownerForm.error" class="alert alert-danger mt-3 mb-0 o_ev_form_error" role="alert" t-esc="state.ownerForm.error"/>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary btn-lg o_ev_save_owner" t-att-disabled="state.saving">
                        <t t-if="state.ownerForm.isNew" t-esc="saveOwnerLabel"/><t t-else="">Uložit klienta</t></button>
                    <button type="button" class="btn btn-light btn-lg" t-on-click="cancelForm">Zrušit</button>
                </div>
            </form>

            <!-- Pet form (new or edit); Task 22: every pet field, only Jméno and Druh required -->
            <form t-elif="state.petForm" class="o_ev_form o_ev_pet_form" t-on-submit="savePet">
                <t t-set="pf" t-value="state.petForm"/>
                <h4><t t-if="pf.petId">Upravit zvíře</t><t t-else="">Nové zvíře</t> · <t t-esc="owner.name"/></h4>
                <t t-call="elite_vet_reception.CardIndexPetFields"><t t-set="prefix" t-value="''"/></t>

                <div t-if="pf.petId" class="mt-3 o_ev_deceased">
                    <label class="d-flex align-items-center gap-2">
                        <input type="checkbox" class="form-check-input o_ev_deceased_check" name="deceased" t-model="pf.deceased"/>
                        <b>Uhynulý</b>
                        <small class="text-muted">uhynulé zvíře nejde objednat ani přijmout</small>
                    </label>
                    <label t-if="pf.deceased" class="o_ev_field mt-2 o_ev_death_date"><b>Datum úhynu</b>
                        <input class="form-control form-control-lg" name="death_date" type="date" t-model="pf.values.death_date"/></label>
                </div>

                <div t-if="pf.error" class="alert alert-danger mt-3 mb-0 o_ev_form_error" role="alert" t-esc="pf.error"/>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary btn-lg o_ev_save_pet" t-att-disabled="state.saving">Uložit</button>
                    <button type="button" class="btn btn-light btn-lg" t-on-click="cancelForm">Zrušit</button>
                </div>
            </form>

            <!-- Owner with pets -->
            <div t-elif="state.data" class="row g-3 o_ev_owner_card">
                <div class="col-12 col-lg-5 d-flex flex-column gap-2">
                    <div class="o_ev_col_title">
                        <span>Klient</span>
                        <button t-if="state.results" type="button" class="btn btn-link p-0" t-on-click="backToResults">‹ Zpět na výsledky</button>
                    </div>
                    <div class="o_ev_field"><b>Jméno</b>
                        <span class="d-flex flex-wrap align-items-center gap-2">
                            <span class="fs-5 o_ev_owner_name" t-esc="owner.name"/>
                            <span t-if="state.data.no_shows and state.data.no_shows.count" class="o_ev_badge o_ev_badge_alert o_ev_no_show_badge"
                                  t-att-title="noShowTitle">Nedorazil <t t-esc="state.data.no_shows.count"/>×</span>
                        </span>
                    </div>
                    <div t-if="state.data.no_shows and state.data.no_shows.count" class="o_ev_field o_ev_no_shows">
                        <b>Nedorazil (posledních 12 měsíců)</b>
                        <small t-foreach="state.data.no_shows.items" t-as="ns" t-key="ns.id" class="text-muted">
                            <t t-esc="ns.date_label"/><t t-if="ns.procedure"> · <t t-esc="ns.procedure"/></t><t t-if="ns.pet"> · <t t-esc="ns.pet"/></t>
                        </small>
                    </div>
                    <div class="o_ev_field"><b>Telefon · e-mail</b>
                        <span class="o_ev_owner_phone" t-esc="ownerPhones"/>
                        <span class="o_ev_owner_email" t-esc="owner.email or 'bez e-mailu'"/></div>
                    <div class="o_ev_field"><b>Adresa</b>
                        <t t-esc="ownerAddress"/></div>
                    <div class="o_ev_field">
                        <b>Otevřené účty: <t t-esc="state.data.open_bills.length"/></b>
                        <div t-foreach="state.data.open_bills" t-as="bill" t-key="bill.record_id">
                            <t t-esc="bill.pet_name"/> · <t t-esc="formatAmount(bill.amount)"/> · <t t-esc="bill.payment_state_label"/>
                            <t t-if="bill.date_label !== 'dnes'"> (<t t-esc="bill.date_label"/>)</t>
                            <div t-if="bill.room_note" class="o_ev_note o_ev_room_note" title="Interní poznámka z ordinace pro recepci">
                                <i class="fa fa-sticky-note me-1" aria-hidden="true"/><span class="o_ev_note_text" t-esc="bill.room_note"/>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-secondary o_ev_edit_owner" t-on-click="editOwner">Upravit</button>
                    </div>
                </div>
                <div class="col-12 col-lg-7 d-flex flex-column gap-2">
                    <div class="o_ev_col_title">
                        <span>Zvířata</span>
                        <button type="button" class="btn btn-secondary o_ev_new_pet" t-on-click="newPet">+ Nové zvíře</button>
                    </div>
                    <div t-if="!pets.length" class="o_ev_empty">Klient zatím nemá žádné zvíře.</div>
                    <div t-foreach="pets" t-as="p" t-key="p.id" class="o_ev_row o_ev_pet" role="button"
                         t-att-class="{ 'o_ev_selected': p.id === state.petId, 'opacity-50': p.deceased }"
                         t-on-click="() => this.selectPet(p)">
                        <div class="o_ev_grow">
                            <div class="fw-bold"><t t-esc="p.name"/><t t-if="petLine(p)"> · <t t-esc="petLine(p)"/></t></div>
                            <small class="text-muted o_ev_pet_details" t-esc="petDetails(p)"/>
                        </div>
                        <span t-if="p.deceased" class="o_ev_badge">uhynulé</span>
                        <span t-if="p.important_note" class="o_ev_badge o_ev_badge_alert o_ev_important"
                              t-att-title="'Důležité: ' + p.important_note" t-esc="p.important_note"/>
                        <span t-if="p.alerts" class="o_ev_badge o_ev_badge_alert" t-esc="p.alerts"/>
                        <span t-if="p.no_show_count" class="o_ev_badge o_ev_badge_alert"
                              title="Kolikrát zvíře nedorazilo za posledních 12 měsíců">nedorazil <t t-esc="p.no_show_count"/>×</span>
                    </div>
                    <div t-if="pet" class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-secondary o_ev_edit_pet" t-on-click="editPet">Upravit <t t-esc="pet.name"/></button>
                    </div>
                    <div t-if="mode === 'walk_in' and pet and !pet.deceased" class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <label class="d-flex align-items-center gap-2">
                            <span class="text-muted text-nowrap">Lékařka</span>
                            <select class="form-select o_ev_walk_in_doctor" t-model="state.walkInDoctorId">
                                <option value="">kterákoli</option>
                                <option t-foreach="state.doctors" t-as="doc" t-key="doc.id" t-att-value="doc.id" t-esc="doc.name"/>
                            </select>
                        </label>
                        <label t-if="state.rooms.length" class="d-flex align-items-center gap-2">
                            <span class="text-muted text-nowrap">Ordinace</span>
                            <select class="form-select o_ev_walk_in_room" t-model="state.walkInRoomId">
                                <option value="">zatím žádná</option>
                                <option t-foreach="state.rooms" t-as="room" t-key="room.id" t-att-value="room.id" t-esc="room.name"/>
                            </select>
                        </label>
                        <label class="w-100 o_ev_field">
                            <b>Interní poznámka pro ordinaci (nepovinné)</b>
                            <textarea class="form-control o_ev_walk_in_note" rows="2" t-model="state.walkInNote"
                                      placeholder="Uvidí ji sestra a lékařka v ordinaci, klient nikde."/>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Search results -->
            <div t-elif="state.results" class="d-flex flex-column gap-2 o_ev_results">
                <div t-if="!state.results.length" class="o_ev_empty">Nic nenalezeno. Klienta můžete založit tlačítkem „+ Nový klient“.</div>
                <div t-foreach="state.results" t-as="r" t-key="resultKey(r)" class="o_ev_row o_ev_result" role="button"
                     t-on-click="() => this.openResult(r)">
                    <i t-att-class="r.kind === 'pet' ? 'fa fa-paw' : 'fa fa-user'" class="text-muted"/>
                    <div class="o_ev_grow">
                        <t t-if="r.kind === 'pet'">
                            <div class="fw-bold"><t t-esc="r.name"/><t t-if="r.species_label"> · <t t-esc="r.species_label"/></t><t t-if="r.breed">, <t t-esc="r.breed"/></t></div>
                            <small class="text-muted"><t t-esc="r.owner"/><t t-if="r.phone"> · <t t-esc="r.phone"/></t><t t-if="r.chip"> · čip <t t-esc="r.chip"/></t></small>
                        </t>
                        <t t-else="">
                            <div class="fw-bold" t-esc="r.name"/>
                            <small class="text-muted"><t t-esc="r.phone or ''"/><t t-if="r.email"> · <t t-esc="r.email"/></t> · zvířat: <t t-esc="r.pet_count"/></small>
                        </t>
                    </div>
                    <span t-if="r.deceased" class="o_ev_badge">uhynulé</span>
                    <span t-if="r.alerts" class="o_ev_badge o_ev_badge_alert" t-esc="r.alerts"/>
                </div>
            </div>
            <div t-else="" class="o_ev_empty">Zadejte jméno, telefon, číslo čipu nebo jméno zvířete a stiskněte Enter.</div>

            <t t-set-slot="footer">
                <!-- exactly one primary action, given by the place the dialog is opened from -->
                <t t-if="state.data and !editing">
                    <button t-if="mode === 'booking'" type="button" class="btn btn-primary btn-lg o_ev_primary o_ev_pick_for_booking"
                            t-att-disabled="!canUsePet" t-on-click="pickForBooking">Vybrat</button>
                    <button t-elif="mode === 'order'" type="button" class="btn btn-primary btn-lg o_ev_primary o_ev_select_for_order"
                            t-on-click="selectForOrder">Vybrat k účtu</button>
                    <button t-elif="mode === 'reservation'" type="button" class="btn btn-primary btn-lg o_ev_primary o_ev_match_reservation"
                            t-att-disabled="!canUsePet" t-on-click="matchReservation">Přiřadit k rezervaci</button>
                    <button t-elif="mode === 'walk_in'" type="button" class="btn btn-primary btn-lg o_ev_primary o_ev_walk_in"
                            t-att-disabled="!canUsePet" t-on-click="walkIn">Přijmout</button>
                    <button t-elif="mode === 'winvet'" type="button" class="btn btn-primary btn-lg o_ev_primary o_ev_pair_winvet"
                            t-att-disabled="!canUsePet" t-on-click="pairWinvet">Přiřadit k objednávce</button>
                    <span t-if="needsPet and !pets.length" class="text-muted align-self-center o_ev_need_pet">Přidejte zvíře (+ Nové zvíře).</span>
                    <span t-elif="needsPet and !pet" class="text-muted align-self-center o_ev_need_pet">Vyberte zvíře.</span>
                    <span t-elif="needsPet and pet.deceased" class="text-muted align-self-center o_ev_need_pet">Zvíře je vedené jako uhynulé.</span>
                </t>
                <button t-if="mode === 'winvet' and props.winvet and props.winvet.paired_manually and !editing" type="button"
                        class="btn btn-light btn-lg o_ev_unpair_winvet" t-att-disabled="state.saving" t-on-click="unpairWinvet"
                        title="Objednávka bude zase bez karty">Zrušit spárování</button>
                <button type="button" class="btn btn-light btn-lg ms-md-auto o_ev_close" t-on-click="props.close">Zavřít</button>
            </t>
        </Dialog>
    </t>

</templates>
