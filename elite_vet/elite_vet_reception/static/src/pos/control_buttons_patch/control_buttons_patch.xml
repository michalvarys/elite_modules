<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="elite_vet_reception.ReceptionClientButton">
        <button type="button" class="btn btn-secondary btn-lg lh-lg o_ev_order_client"
                title="Klient k účtu z Kartotéky" t-on-click="onClick">
            <i class="fa fa-address-book-o me-1"/>Klient
        </button>
    </t>

    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//SelectPartnerButton" position="before">
            <ReceptionClientButton t-if="pos.isReceptionPos and !props.showRemainingButtons"/>
        </xpath>
    </t>

</templates>
