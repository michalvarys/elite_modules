<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- "…" menu of a patient (component RoomMenu, props.it, props.board): Otevřít kartu,
         Spárovat… (WinVet appointment without a pet, task 30), Poznámka recepce, Do jiné ordinace (rooms right in the menu, also for touch screens). -->
    <t t-name="elite_vet_reception.RoomMenu">
        <t t-set="it" t-value="props.it"/>
        <t t-set="board" t-value="props.board"/>
        <Dropdown position="'bottom-end'" menuClass="'ev-clinic-menu'">
            <button type="button" class="ev-icon-btn evt-more evrm-more" t-att-aria-label="'Další akce: ' + (it.pet_name or 'pacient')"
                    title="Další akce" t-att-disabled="board.state.busy">
                <i class="fa fa-ellipsis-h" aria-hidden="true"/>
            </button>
            <t t-set-slot="content">
                <DropdownItem t-if="board.canOpenFromMenu(it)" class="'evrm-open'" onSelected="() => board.openCard(props.it)">
                    <i class="fa fa-folder-open-o fa-fw" aria-hidden="true"/>Otevřít kartu
                </DropdownItem>
                <DropdownItem t-if="board.canPair(it)" class="'evrm-pair-winvet'" onSelected="() => board.pairWinvet(props.it)">
                    <i class="fa fa-link fa-fw" aria-hidden="true"/>Spárovat…
                </DropdownItem>
                <DropdownItem t-if="board.canNote(it)" class="'evrm-note-edit'" onSelected="() => board.editNote(props.it)">
                    <i class="fa fa-sticky-note-o fa-fw" aria-hidden="true"/>Poznámka recepce…
                </DropdownItem>
                <t t-if="it.draggable">
                    <div class="dropdown-divider" t-if="board.canOpenFromMenu(it) or board.canNote(it)"/>
                    <h6 class="dropdown-header">Do jiné ordinace</h6>
                    <t t-foreach="board.roomColumns" t-as="col" t-key="col.key">
                        <DropdownItem t-if="col.room_id !== it.room_id" class="'evrm-to-room'" onSelected="() => board.pickRoomFor(props.it, col.room_id)">
                            <span class="evt-dot" t-att-style="'background:' + (col.color or '#8796ab')" aria-hidden="true"/>
                            <span><t t-esc="col.name"/> <small class="text-muted" t-esc="board.dutyText(col)"/></span>
                        </DropdownItem>
                    </t>
                    <DropdownItem t-if="it.room_id" class="'evrm-to-room'" onSelected="() => board.pickRoomFor(props.it, false)">
                        <span class="evt-dot" style="background:#b5bfbc" aria-hidden="true"/>Nepřiřazení
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

    <!-- One patient: the shared tile + one primary action + "…" (`it`, `column`, `compact`). -->
    <t t-name="elite_vet_reception.RoomTile">
        <t t-set="tile" t-value="this.tile(it)"/>
        <t t-set="primary" t-value="primaryAction(it)"/>
        <div class="evt evrm-card" t-att-class="'evt-' + it.stage + (compact ? ' evt-compact' : '') + (state.drag === it.key ? ' evrm-card-drag' : '') + (compact and it.draggable ? ' evrm-draggable' : '')"
             t-att-draggable="compact and it.draggable ? 'true' : 'false'"
             t-on-dragstart="(ev) => this.onDragStart(ev, it)" t-on-dragend="onDragEnd"
             t-att-data-key="it.key">
            <t t-call="elite_vet_clinic.VisitTileBody"/>
            <span class="evt-actions">
                <t t-if="!compact">
                    <button t-if="primary === 'call'" type="button" class="ev-btn ev-btn-primary evt-primary evrm-call"
                            t-att-disabled="state.busy" t-on-click="() => this.callPatient(it, column.room_id)">Zavolat</button>
                    <button t-elif="primary === 'open'" type="button" class="ev-btn ev-btn-primary evt-primary evrm-open"
                            t-on-click="() => this.openCard(it)">Otevřít kartu</button>
                </t>
                <RoomMenu t-if="hasMenu(it)" it="it" board="this"/>
            </span>
        </div>
    </t>

    <t t-name="elite_vet_reception.RoomNoteDialog">
        <Dialog title="'Poznámka recepce – ' + (props.item.pet_name or '')" size="'md'">
            <label class="form-label" for="evrm-note-input">Interní poznámka, klient ji neuvidí</label>
            <textarea id="evrm-note-input" class="form-control evrm-note-input" rows="4" t-model="state.note"
                      placeholder="Např. klient spěchá, platí převodem"/>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-att-disabled="state.busy" t-on-click="save">Uložit</button>
                <button type="button" class="btn btn-secondary" t-on-click="props.close">Zrušit</button>
            </t>
        </Dialog>
    </t>

    <t t-name="elite_vet_reception.RoomBoard">
        <div class="evrm ev-clinic o_action">
            <div class="evrm-toolbar">
                <t t-set="column" t-value="state.view !== 'all' ? currentColumn : null"/>
                <div class="evrm-title">
                    <t t-if="state.loading or state.view === 'all'">
                        <h1 class="evrm-room-name">Všechny ordinace</h1>
                        <div t-if="state.data" class="evrm-summary" aria-label="Souhrn">
                            <span class="ev-chip ev-chip-waiting">Čeká <b class="ev-num" t-esc="summary.waiting"/></span>
                            <span class="ev-chip ev-chip-in_room">V ordinacích <b class="ev-num" t-esc="summary.inRoom"/></span>
                            <span class="ev-chip">Nepřiřazení <b class="ev-num" t-esc="summary.unassigned"/></span>
                        </div>
                    </t>
                    <t t-elif="column">
                        <h1 class="evrm-room-name">
                            <span class="evrm-room-dot" t-att-style="'background:' + (column.color or '#8796ab')" aria-hidden="true"/>
                            <t t-esc="column.name"/>
                        </h1>
                        <t t-set="duty" t-value="dutyLine"/>
                        <div class="evrm-duty" t-att-class="{'evrm-duty-none': !duty.now}">
                            <i class="fa fa-user-md me-2" aria-hidden="true"/>
                            <t t-if="duty.now">Ve službě <b t-esc="duty.text"/></t>
                            <t t-elif="duty.text">Teď nikdo ve službě. Dnes: <t t-esc="duty.text"/></t>
                            <t t-else="">Dnes tu nikdo nemá službu</t>
                        </div>
                    </t>
                </div>
                <div class="evrm-tools">
                    <span t-if="state.data" class="ev-meta evrm-clock">Aktualizováno <span class="ev-num" t-esc="state.data.time"/></span>
                    <button type="button" class="ev-icon-btn" title="Obnovit" aria-label="Obnovit" t-on-click="() => this.refresh()"><i class="fa fa-refresh" aria-hidden="true"/></button>
                    <label class="evrm-switch">
                        <span class="visually-hidden">Ordinace</span>
                        <select class="form-select evrm-select" t-on-change="onViewChange" aria-label="Ordinace">
                            <option value="all" t-att-selected="state.view === 'all'">Všechny ordinace</option>
                            <t t-if="state.data">
                                <option t-foreach="state.data.rooms" t-as="room" t-key="room.id" t-att-value="room.id"
                                        t-att-selected="state.view === room.id" t-esc="room.name"/>
                            </t>
                        </select>
                    </label>
                </div>
            </div>

            <div t-if="state.loading" class="p-4 ev-meta">Načítám…</div>

            <!-- Všechny ordinace -->
            <div t-elif="state.view === 'all'" class="evrm-columns">
                <section t-foreach="columns" t-as="column" t-key="column.key" class="evrm-col"
                         t-att-class="{'evrm-col-unassigned': !column.room_id, 'evrm-col-drop': state.dropKey === column.key}"
                         t-att-data-column="column.key"
                         t-on-dragover="(ev) => this.onDragOver(ev, column)" t-on-drop="(ev) => this.onDrop(ev, column)">
                    <header class="evrm-col-head" t-att-style="column.color ? 'border-top-color:' + column.color : ''">
                        <h2 class="ev-h3 evrm-col-name" t-esc="column.name"/>
                        <div class="evrm-col-duty" t-att-class="{'evrm-duty-none': column.room_id and !column.on_duty.length}">
                            <t t-if="column.room_id"><i class="fa fa-user-md me-1" aria-hidden="true"/></t><t t-esc="dutyText(column)"/>
                        </div>
                    </header>
                    <div class="evrm-col-body">
                        <t t-set="compact" t-value="true"/>
                        <t t-foreach="sections" t-as="section" t-key="section.key">
                            <t t-set="items" t-value="sectionItems(column, section.key)"/>
                            <div t-if="items.length" class="evrm-section" t-att-class="'ev-group-' + section.key">
                                <h3 class="evrm-section-title"><t t-esc="section.title"/> <span class="ev-count" t-esc="items.length"/></h3>
                                <t t-foreach="items" t-as="it" t-key="it.key"><t t-call="elite_vet_reception.RoomTile"/></t>
                            </div>
                        </t>
                        <p t-if="!column.counts.in_room and !column.counts.waiting and !column.counts.booked" class="ev-empty-line">
                            <t t-if="column.room_id">Nikdo tu není.</t><t t-else="">Všichni mají ordinaci.</t>
                        </p>
                        <t t-set="items" t-value="sectionItems(column, 'done')"/>
                        <div t-if="items.length" class="evrm-done">
                            <button type="button" class="evrm-done-toggle" t-att-aria-expanded="isDoneOpen(column) ? 'true' : 'false'"
                                    t-on-click="() => this.toggleDone(column)">
                                <i t-att-class="isDoneOpen(column) ? 'fa fa-angle-down' : 'fa fa-angle-right'" aria-hidden="true"/>
                                Hotovo dnes: <span class="ev-num" t-esc="items.length"/>
                            </button>
                            <t t-if="isDoneOpen(column)">
                                <t t-foreach="items" t-as="it" t-key="it.key"><t t-call="elite_vet_reception.RoomTile"/></t>
                            </t>
                        </div>
                    </div>
                </section>
            </div>

            <!-- One room -->
            <div t-else="" class="evrm-room">
                <t t-set="column" t-value="currentColumn"/>
                <div t-if="!column" class="p-4 ev-meta">Ordinace nebyla nalezena.</div>
                <t t-else="">
                    <t t-set="compact" t-value="false"/>
                    <section t-if="unassignedArrived.length" class="evrm-bar" aria-label="Nepřiřazení">
                        <div class="evrm-bar-row">
                            <span class="evrm-bar-text"><i class="fa fa-clock-o me-2" aria-hidden="true"/><t t-esc="unassignedText"/></span>
                            <button type="button" class="ev-btn ev-btn-quiet evrm-bar-toggle" t-att-aria-expanded="state.showUnassigned ? 'true' : 'false'"
                                    t-on-click="toggleUnassigned">
                                <t t-if="state.showUnassigned">Skrýt</t><t t-else="">Zobrazit</t>
                            </button>
                            <button t-if="unassignedWaiting.length" type="button" class="ev-btn ev-btn-primary evrm-take-next"
                                    t-att-disabled="state.busy" t-on-click="takeNext"
                                    t-att-title="'Vezme do této ordinace pacienta, který čeká nejdéle: ' + unassignedWaiting[0].pet_name">
                                Vzít dalšího
                            </button>
                        </div>
                        <ol t-if="state.showUnassigned" class="evrm-list evrm-bar-list">
                            <li t-foreach="unassignedArrived" t-as="it" t-key="it.key">
                                <t t-set="tile" t-value="this.tile(it)"/>
                                <div class="evt" t-att-class="'evt-' + it.stage">
                                    <t t-call="elite_vet_clinic.VisitTileBody"/>
                                    <span class="evt-actions">
                                        <button type="button" class="ev-btn evrm-take" t-att-disabled="state.busy"
                                                t-on-click="() => this.assign(it, column.room_id)">Vzít do této ordinace</button>
                                    </span>
                                </div>
                            </li>
                        </ol>
                    </section>

                    <div class="evrm-flow">
                        <section t-foreach="sections" t-as="section" t-key="section.key" class="evrm-stage"
                                 t-att-class="'ev-group-' + section.key">
                            <t t-set="items" t-value="sectionItems(column, section.key)"/>
                            <h2 class="ev-group-head"><t t-esc="section.title"/> <span class="ev-count" t-esc="items.length"/></h2>
                            <p t-if="!items.length" class="ev-empty-line" t-esc="section.empty"/>
                            <ol t-else="" class="evrm-list">
                                <li t-foreach="items" t-as="it" t-key="it.key"><t t-call="elite_vet_reception.RoomTile"/></li>
                            </ol>
                            <t t-if="section_last">
                                <t t-set="done" t-value="sectionItems(column, 'done')"/>
                                <div t-if="done.length" class="evrm-done">
                                    <button type="button" class="evrm-done-toggle" t-att-aria-expanded="isDoneOpen(column) ? 'true' : 'false'"
                                            t-on-click="() => this.toggleDone(column)">
                                        <i t-att-class="isDoneOpen(column) ? 'fa fa-angle-down' : 'fa fa-angle-right'" aria-hidden="true"/>
                                        Hotovo dnes: <span class="ev-num" t-esc="done.length"/>
                                    </button>
                                    <ol t-if="isDoneOpen(column)" class="evrm-list">
                                        <li t-foreach="done" t-as="it" t-key="it.key"><t t-call="elite_vet_reception.RoomTile"/></li>
                                    </ol>
                                </div>
                            </t>
                        </section>
                    </div>
                </t>
            </div>

            <!-- Two doctors on duty: who takes the patient -->
            <div t-if="state.pickDoctor" class="evrm-modal-backdrop" t-on-click.self="() => this.chooseDoctor(null)">
                <div class="evrm-modal" role="dialog" aria-label="Která lékařka">
                    <h2 class="ev-h2">Kdo pacienta převezme?</h2>
                    <p class="ev-meta mt-2"><t t-esc="state.pickDoctor.item.pet_name"/> jde do ordinace <t t-esc="roomName(state.pickDoctor.roomId)"/>. Ve službě jsou dvě lékařky.</p>
                    <div class="evrm-modal-choices">
                        <button t-foreach="state.pickDoctor.doctors" t-as="doc" t-key="doc.id" type="button"
                                class="ev-btn ev-btn-primary evrm-doctor-choice" t-on-click="() => this.chooseDoctor(doc)" t-esc="doc.name"/>
                    </div>
                    <button type="button" class="ev-btn ev-btn-quiet" t-on-click="() => this.chooseDoctor(null)">Zatím nevybírat</button>
                </div>
            </div>
        </div>
    </t>
</templates>
