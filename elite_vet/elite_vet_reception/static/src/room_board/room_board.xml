<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Card of the view Všechny ordinace (`it` = item of room_board, `column` = its column). -->
    <t t-name="elite_vet_reception.RoomCard">
        <div class="evrm-card" t-att-class="{
                'evrm-card-waiting': it.stage === 'waiting', 'evrm-card-in_room': it.stage === 'in_room',
                'evrm-card-booked': it.stage === 'booked', 'evrm-card-done': it.stage === 'done',
                'evrm-card-drag': state.drag === it.key}"
             t-att-draggable="it.draggable ? 'true' : 'false'"
             t-on-dragstart="(ev) => this.onDragStart(ev, it)" t-on-dragend="onDragEnd"
             t-att-data-key="it.key">
            <div class="evrm-card-top">
                <span class="evrm-time" t-esc="timeText(it)"/>
                <span class="evrm-stage" t-att-class="'evrm-stage-' + it.stage" t-esc="stageText(it)"/>
            </div>
            <div class="evrm-pet">
                <t t-esc="it.pet_name or 'Bez mazlíčka'"/>
                <span t-if="it.species_label" class="evrm-muted" t-esc="' (' + it.species_label + ')'"/>
            </div>
            <div class="evrm-sub">
                <t t-esc="it.owner or ''"/><t t-if="it.procedure"> · <t t-esc="it.procedure"/></t>
                <t t-if="it.walk_in"> · bez objednání</t>
            </div>
            <div class="evrm-sub"><i class="fa fa-user-md me-1" aria-hidden="true"/><t t-esc="it.doctor or 'lékařka nevybrána'"/></div>
            <div t-if="it.alerts" class="evrm-alert"><i class="fa fa-exclamation-triangle me-1"/><t t-esc="it.alerts"/></div>
            <div t-if="it.draggable or it.pet_id or it.reservation_id" class="evrm-card-actions">
                <span t-if="it.draggable" class="evrm-picker-anchor">
                    <button type="button" class="btn btn-sm btn-light evrm-to-room" t-att-disabled="state.busy"
                            t-on-click="() => this.openRoomPicker(it)">Do ordinace…</button>
                    <div t-if="state.pickRoom and state.pickRoom.key === it.key" class="evrm-picker" role="menu">
                        <button t-foreach="roomColumns" t-as="col" t-key="col.key" type="button" class="evrm-picker-item"
                                t-att-class="{'evrm-picker-current': col.room_id === it.room_id}"
                                t-on-click="() => this.pickRoomFor(it, col.room_id)">
                            <b t-esc="col.name"/> <span class="evrm-muted" t-esc="dutyText(col)"/>
                        </button>
                        <button type="button" class="evrm-picker-item" t-att-class="{'evrm-picker-current': !it.room_id}"
                                t-on-click="() => this.pickRoomFor(it, false)">Nepřiřazení</button>
                    </div>
                </span>
                <button t-if="it.record_id or it.pet_id" type="button" class="btn btn-sm btn-link evrm-open"
                        t-on-click="() => this.openCard(it)">Karta</button>
            </div>
        </div>
    </t>

    <!-- Row of the one-room view (`it`, `section`, `column`). -->
    <t t-name="elite_vet_reception.RoomRow">
        <li class="evrm-row" t-att-class="'evrm-row-' + it.stage">
            <span class="evrm-row-time" t-esc="timeText(it)"/>
            <span class="evrm-row-main">
                <span class="evrm-row-pet">
                    <t t-esc="it.pet_name or 'Bez mazlíčka'"/>
                    <span t-if="it.species_label" class="evrm-muted" t-esc="' (' + it.species_label + ')'"/>
                    <span class="evrm-stage" t-att-class="'evrm-stage-' + it.stage" t-esc="stageText(it)"/>
                </span>
                <span class="evrm-sub">
                    <t t-esc="it.owner or ''"/><t t-if="it.procedure"> · <t t-esc="it.procedure"/></t>
                    <t t-if="it.walk_in"> · bez objednání</t> · <t t-esc="it.doctor or 'lékařka nevybrána'"/>
                </span>
                <span t-if="it.alerts" class="evrm-alert"><i class="fa fa-exclamation-triangle me-1"/><t t-esc="it.alerts"/></span>
            </span>
            <span class="evrm-row-actions">
                <button t-if="it.stage === 'waiting' and canCall" type="button" class="btn btn-primary evrm-call"
                        t-att-disabled="state.busy" t-on-click="() => this.callPatient(it, column.room_id)">Zavolat</button>
                <button t-if="it.record_id or it.pet_id" type="button" class="btn btn-secondary evrm-open"
                        t-on-click="() => this.openCard(it)">Otevřít kartu</button>
            </span>
        </li>
    </t>

    <t t-name="elite_vet_reception.RoomBoard">
        <div class="evrm o_action" t-on-click.self="closePickers">
            <div class="evrm-toolbar">
                <div class="evrm-switch" role="tablist" aria-label="Ordinace">
                    <button type="button" class="evrm-tab" t-att-class="{'evrm-tab-active': state.view === 'all'}"
                            t-on-click="() => this.selectView('all')">Všechny ordinace</button>
                    <t t-if="state.data">
                        <button t-foreach="state.data.rooms" t-as="room" t-key="room.id" type="button" class="evrm-tab"
                                t-att-class="{'evrm-tab-active': state.view === room.id}"
                                t-on-click="() => this.selectView(room.id)">
                            <span class="evrm-dot" t-att-style="'background:' + (room.color or '#94a3b8')"/>
                            <t t-esc="room.name"/>
                        </button>
                    </t>
                </div>
                <span class="flex-grow-1"/>
                <span t-if="state.data" class="evrm-muted evrm-clock">Aktualizováno <t t-esc="state.data.time"/></span>
                <button type="button" class="btn btn-light" title="Obnovit" t-on-click="() => this.refresh()"><i class="fa fa-refresh"/></button>
            </div>

            <div t-if="state.loading" class="p-4 text-muted">Načítám…</div>

            <!-- Všechny ordinace -->
            <div t-elif="state.view === 'all'" class="evrm-columns">
                <section t-foreach="columns" t-as="column" t-key="column.key" class="evrm-col"
                         t-att-class="{'evrm-col-unassigned': !column.room_id, 'evrm-col-drop': state.dropKey === column.key}"
                         t-att-data-column="column.key"
                         t-on-dragover="(ev) => this.onDragOver(ev, column)" t-on-drop="(ev) => this.onDrop(ev, column)">
                    <header class="evrm-col-head" t-att-style="column.color ? 'border-top-color:' + column.color : ''">
                        <div class="evrm-col-name" t-esc="column.name"/>
                        <div class="evrm-duty" t-att-class="{'evrm-duty-none': column.room_id and !column.on_duty.length}">
                            <t t-if="column.room_id"><i class="fa fa-user-md me-1" aria-hidden="true"/></t><t t-esc="dutyText(column)"/>
                        </div>
                    </header>
                    <div class="evrm-col-body">
                        <t t-foreach="sections" t-as="section" t-key="section.key">
                            <t t-set="items" t-value="sectionItems(column, section.key)"/>
                            <div t-if="section.key === 'done'" class="evrm-section evrm-section-done">
                                <button t-if="items.length" type="button" class="evrm-section-title evrm-done-toggle"
                                        t-on-click="() => this.toggleDone(column)">
                                    <i t-att-class="isDoneOpen(column) ? 'fa fa-caret-down' : 'fa fa-caret-right'"/>
                                    Hotovo <span class="evrm-count" t-esc="items.length"/>
                                </button>
                                <t t-if="isDoneOpen(column)">
                                    <t t-foreach="items" t-as="it" t-key="it.key"><t t-call="elite_vet_reception.RoomCard"/></t>
                                </t>
                            </div>
                            <div t-elif="items.length" class="evrm-section" t-att-class="'evrm-section-' + section.key">
                                <div class="evrm-section-title"><t t-esc="section.title"/> <span class="evrm-count" t-esc="items.length"/></div>
                                <t t-foreach="items" t-as="it" t-key="it.key"><t t-call="elite_vet_reception.RoomCard"/></t>
                            </div>
                        </t>
                        <p t-if="!column.counts.in_room and !column.counts.waiting and !column.counts.booked" class="evrm-empty">
                            <t t-if="column.room_id">Nikdo tu není.</t><t t-else="">Všichni mají ordinaci.</t>
                        </p>
                    </div>
                </section>
            </div>

            <!-- One room -->
            <div t-else="" class="evrm-room">
                <t t-set="column" t-value="currentColumn"/>
                <div t-if="!column" class="p-4 text-muted">Ordinace nebyla nalezena.</div>
                <t t-else="">
                    <header class="evrm-room-head" t-att-style="column.color ? 'border-left-color:' + column.color : ''">
                        <h2 class="evrm-room-name" t-esc="column.name"/>
                        <div class="evrm-duty evrm-duty-lg" t-att-class="{'evrm-duty-none': !column.on_duty.length}">
                            <i class="fa fa-user-md me-1" aria-hidden="true"/>
                            <t t-if="column.on_duty.length">Ve službě: <t t-esc="dutyText(column)"/></t>
                            <t t-else="">Teď nikdo ve službě</t>
                        </div>
                        <div t-if="column.shifts.length" class="evrm-muted evrm-shifts">
                            Dnes: <t t-foreach="column.shifts" t-as="s" t-key="s_index"><t t-if="s_index">, </t><span t-att-class="{'evrm-shift-now': s.now}"><t t-esc="s.doctor"/> <t t-esc="s.label"/></span></t>
                        </div>
                    </header>

                    <section t-if="unassignedArrived.length" class="evrm-unassigned" aria-label="Nepřiřazení">
                        <h3 class="evrm-group-title">Nepřiřazení – čekají na ordinaci <span class="evrm-count" t-esc="unassignedArrived.length"/></h3>
                        <ol class="evrm-list">
                            <li t-foreach="unassignedArrived" t-as="it" t-key="it.key" class="evrm-row evrm-row-unassigned">
                                <span class="evrm-row-time" t-esc="timeText(it)"/>
                                <span class="evrm-row-main">
                                    <span class="evrm-row-pet">
                                        <t t-esc="it.pet_name"/>
                                        <span t-if="it.species_label" class="evrm-muted" t-esc="' (' + it.species_label + ')'"/>
                                        <span class="evrm-stage" t-att-class="'evrm-stage-' + it.stage" t-esc="stageText(it)"/>
                                    </span>
                                    <span class="evrm-sub"><t t-esc="it.owner or ''"/><t t-if="it.walk_in"> · bez objednání</t><t t-if="it.doctor"> · <t t-esc="it.doctor"/></t></span>
                                    <span t-if="it.alerts" class="evrm-alert"><i class="fa fa-exclamation-triangle me-1"/><t t-esc="it.alerts"/></span>
                                </span>
                                <span class="evrm-row-actions">
                                    <button type="button" class="btn btn-primary evrm-take" t-att-disabled="state.busy"
                                            t-on-click="() => this.assign(it, column.room_id)">Vzít do této ordinace</button>
                                </span>
                            </li>
                        </ol>
                    </section>

                    <section t-foreach="sections" t-as="section" t-key="section.key" class="evrm-group"
                             t-att-class="'evrm-group-' + section.key">
                        <t t-set="items" t-value="sectionItems(column, section.key)"/>
                        <h3 class="evrm-group-title">
                            <button t-if="section.key === 'done'" type="button" class="evrm-done-toggle" t-on-click="() => this.toggleDone(column)">
                                <i t-att-class="isDoneOpen(column) ? 'fa fa-caret-down' : 'fa fa-caret-right'"/> Hotovo
                            </button>
                            <t t-else="" t-esc="section.title"/>
                            <span class="evrm-count" t-esc="items.length"/>
                        </h3>
                        <t t-if="section.key !== 'done' or isDoneOpen(column)">
                            <p t-if="!items.length" class="evrm-empty" t-esc="section.empty"/>
                            <ol t-else="" class="evrm-list">
                                <t t-foreach="items" t-as="it" t-key="it.key"><t t-call="elite_vet_reception.RoomRow"/></t>
                            </ol>
                        </t>
                    </section>
                </t>
            </div>

            <!-- Two doctors on duty: who takes the patient -->
            <div t-if="state.pickDoctor" class="evrm-modal-backdrop" t-on-click.self="() => this.chooseDoctor(null)">
                <div class="evrm-modal" role="dialog" aria-label="Která lékařka">
                    <h4>Kdo pacienta převezme?</h4>
                    <p class="evrm-muted"><t t-esc="state.pickDoctor.item.pet_name"/> · <t t-esc="roomName(state.pickDoctor.roomId)"/> – ve službě jsou dvě lékařky.</p>
                    <div class="evrm-modal-choices">
                        <button t-foreach="state.pickDoctor.doctors" t-as="doc" t-key="doc.id" type="button"
                                class="btn btn-primary btn-lg evrm-doctor-choice" t-on-click="() => this.chooseDoctor(doc)" t-esc="doc.name"/>
                    </div>
                    <button type="button" class="btn btn-link" t-on-click="() => this.chooseDoctor(null)">Zatím nevybírat</button>
                </div>
            </div>
        </div>
    </t>
</templates>
