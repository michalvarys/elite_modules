<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- One row of the staged list (rendered inside PatientCard, `it` = item of my_patients_today,
         `group` = PATIENT_GROUPS entry). Task 26: the shared visit tile of the clinical screens
         (elite_vet_clinic.VisitTileBody); the tile opens the card, Zavolat is the one action. -->
    <t t-name="elite_vet_reception.PatientRow">
        <t t-set="tile" t-value="patientTile(it, group)"/>
        <div class="evrc-row" t-att-class="'evrc-row-' + group.key">
            <button type="button" class="evt evt-link evpc-today-row" t-att-class="'evt-' + tile.state"
                    t-att-aria-label="'Otevřít kartu: ' + tile.pet"
                    t-on-click="() => this.openReservation(it)">
                <t t-call="elite_vet_clinic.VisitTileBody"/>
                <i t-if="group.key !== 'waiting'" class="fa fa-angle-right evt-go" aria-hidden="true"/>
            </button>
            <button t-if="group.key === 'waiting' and it.record_id" type="button" class="ev-btn ev-btn-primary evrc-call"
                    t-att-disabled="!!callState.key" t-on-click="() => this.callPatient(it)">
                <t t-if="callState.key === it.key">Volám…</t><t t-else="">Zavolat</t>
            </button>
        </div>
    </t>

    <t t-inherit="elite_vet_clinic.PatientCard" t-inherit-mode="extension">
        <xpath expr="//p[hasclass('evpc-empty')][@t-elif='!todayItems.length']" position="replace">
            <p t-elif="!todayItems.length and !unassignedItems.length" class="evpc-empty">Dnes nikdo nečeká ani není objednaný. Pacienta najdete vyhledáním nahoře.</p>
        </xpath>
        <xpath expr="//ol[hasclass('evpc-today-list')]" position="replace">
            <div t-else="" class="evrc-groups">
                <section t-foreach="todayGroups" t-as="group" t-key="group.key" class="evrc-group"
                         t-att-class="'evrc-group-' + group.key + ' ev-group-' + group.state" t-att-aria-label="group.title">
                    <h3 class="ev-group-head evrc-group-title"><t t-esc="group.title"/><span class="ev-count" t-esc="group.items.length"/></h3>
                    <p t-if="group.hint" class="evrc-group-hint" t-esc="group.hint"/>
                    <p t-if="!group.items.length" class="ev-empty-line" t-esc="group.empty"/>
                    <ol t-else="" class="evpc-today-list">
                        <li t-foreach="group.items" t-as="it" t-key="it.key">
                            <t t-call="elite_vet_reception.PatientRow"/>
                        </li>
                    </ol>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('evpc-tabs')]/button" position="attributes">
            <attribute name="t-key">it.key</attribute>
        </xpath>
    </t>
</templates>
