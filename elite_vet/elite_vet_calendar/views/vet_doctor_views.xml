<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_doctor_list" model="ir.ui.view">
        <field name="name">elite.vet.doctor.list</field>
        <field name="model">elite.vet.doctor</field>
        <field name="arch" type="xml">
            <list string="Lékařky" editable="bottom">
                <field name="name" string="Jméno"/>
                <field name="member_id" string="Karta v týmu"/>
                <field name="specialization_ids" widget="many2many_tags" string="Specializace"/>
            </list>
        </field>
    </record>

    <record id="view_vet_doctor_form" model="ir.ui.view">
        <field name="name">elite.vet.doctor.form</field>
        <field name="model">elite.vet.doctor</field>
        <field name="arch" type="xml">
            <form string="Lékařka">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Jméno"/>
                        <h1><field name="name" placeholder="např. MVDr. Kateřina Kadavá"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="specialization_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="active" string="Aktivní"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status">
                        Jméno se takhle přesně objeví na webu v buňce rozpisu.
                        Kdo na klinice skončí, nemusí se mazat — stačí zrušit
                        <b>Aktivní</b>. Zmizí z nabídky při zadávání směny, ale
                        odsloužené směny zůstanou v pořádku.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vet_doctor_search" model="ir.ui.view">
        <field name="name">elite.vet.doctor.search</field>
        <field name="model">elite.vet.doctor</field>
        <field name="arch" type="xml">
            <search string="Lékařky">
                <field name="name"/>
                <filter name="neaktivni" string="Archivované" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_vet_doctor" model="ir.actions.act_window">
        <field name="name">Lékařky</field>
        <field name="res_model">elite.vet.doctor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Přidejte lékařku</p>
            <p>Jména odsud se nabízejí při zadávání směny.</p>
        </field>
    </record>
</odoo>
