#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Duty schedule of the Elite Vet veterinary clinic in Karlovy Vary — a monthly calendar with morning and afternoon shifts and the weekend shifts of our doctors."
msgstr "Rozpis ordinačních služeb veterinární kliniky Elite Vet Karlovy Vary — měsíční kalendář s ranní a odpolední službou a s víkendovými službami našich lékařek."

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Duty schedule | Elite Vet Karlovy Vary"
msgstr "Rozpis služeb | Elite Vet Karlovy Vary"

#. module: elite_vet_calendar
#: model_terms:ir.ui.view,arch_db:elite_vet_calendar.rozpis_lekaru
msgid "Elite Vet booking system"
msgstr "Rezervační systém Elite Vet"

