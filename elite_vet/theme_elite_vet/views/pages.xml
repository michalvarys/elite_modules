<odoo>
<data>

<template id="vet_homepage" name="Elite Vet Homepage">
    <t t-call="website.layout">
        <t t-set="additional_title">Elite Vet | Veterinární klinika Karlovy Vary</t>
        <t t-set="meta_description">Moderní veterinární klinika v Karlových Varech. Komplexní péče pro psy, kočky i exoty, moderní diagnostika, chirurgie, pohotovost. Hybešova 167/18, Rybáře.</t>

        <div id="wrap" class="oe_structure vet-page">
            <t t-call="theme_elite_vet.s_vet_hero"/>
            <t t-call="theme_elite_vet.s_vet_services"/>
            <t t-call="theme_elite_vet.s_vet_about"/>
            <t t-call="theme_elite_vet.s_vet_testimonials"/>
            <t t-call="theme_elite_vet.s_vet_careers"/>
            <t t-call="theme_elite_vet.s_vet_contact"/>
        </div>
    </t>
</template>

<!-- Sablona vyse zustava, ale uz si NENAROKUJE adresu "/".

     Drive tu byl zaznam theme.website.page na "/". Podle nej Odoo pri kazde
     aktualizaci tematu zalozilo na domovske adrese dalsi stranku se starou
     podobou webu. Vedle stranky z modulu elite_vet_web tak na "/" vznikaly
     dve az tri stranky a Odoo si mezi nimi vybira nahodne:

         search(domain, order='website_id asc', limit=1)

     Mezi strankami tehoz webu uz zadne dalsi razeni neni, takze se
     navstevnikum jednou ukazal novy web a podruhe stary — a po kazdem
     kliknuti na "Aktualizovat tema" se stary vratil. Domovskou stranku
     dodava modul elite_vet_web. -->

</data>
</odoo>
