<odoo>

<template id="vet_snippets_registry" name="Elite Vet Snippets" inherit_id="website.snippets">
    <xpath expr="//snippets[@id='snippet_structure']" position="after">
        <snippets id="vet_snippet_structure" string="Elite Vet">
            <t t-snippet="theme_elite_vet.s_vet_hero"
               t-thumbnail="/theme_elite_vet/static/src/img/s_vet_hero.svg"/>
            <t t-snippet="theme_elite_vet.s_vet_services"
               t-thumbnail="/theme_elite_vet/static/src/img/s_vet_services.svg"/>
            <t t-snippet="theme_elite_vet.s_vet_about"
               t-thumbnail="/theme_elite_vet/static/src/img/s_vet_about.svg"/>
            <t t-snippet="theme_elite_vet.s_vet_testimonials"
               t-thumbnail="/theme_elite_vet/static/src/img/s_vet_testimonials.svg"/>
            <t t-snippet="theme_elite_vet.s_vet_careers"
               t-thumbnail="/theme_elite_vet/static/src/img/s_vet_careers.svg"/>
            <t t-snippet="theme_elite_vet.s_vet_contact"
               t-thumbnail="/theme_elite_vet/static/src/img/s_vet_contact.svg"/>
        </snippets>
    </xpath>
</template>

</odoo>
