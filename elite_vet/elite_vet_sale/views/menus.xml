<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The stock overview is for the till group (Recepce) and Vedení (task 14: not for nurses and
         doctors; "-" removes the groups of earlier versions on update). elite_vet_reception also
         puts the stock root under these groups. -->
    <menuitem id="menu_stock_overview" name="Přehled skladu" parent="stock.menu_stock_root"
              sequence="3" action="action_stock_overview"
              groups="-stock.group_stock_user,elite_vet_sale.group_till_stock"/>
    <!-- The same action under Ordinace (visible to Vedení, or to a nurse given the till group). -->
    <menuitem id="menu_stock_overview_clinic" name="Přehled skladu" parent="elite_vet_clinic.menu_clinic_root"
              sequence="45" action="action_stock_overview"
              groups="-elite_vet_reservation.group_reservation_reception,elite_vet_sale.group_till_stock"/>
</odoo>
