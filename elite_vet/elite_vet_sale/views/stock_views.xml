<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock overview of the reception and Vedení (spec, section 7; task 14): filters "Dochází", "Expiruje do 30 dní"
         and "Prošlé" on the stock by lot (stock.quant) and on the lots (stock.lot). -->
    <record id="quant_search_view_overview" model="ir.ui.view">
        <field name="name">stock.quant.search.elite.vet</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='internal_loc']" position="before">
                <filter name="below_minimum" string="Dochází"
                        domain="[('product_id.stock_below_minimum', '=', True)]"/>
                <separator/>
                <filter name="expiring_30_days" string="Expiruje do 30 dní"
                        domain="[('quantity', '&gt;', 0),
                                 ('expiration_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')),
                                 ('expiration_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="expired" string="Prošlé"
                        domain="[('quantity', '&gt;', 0),
                                 ('expiration_date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="search_product_lot_filter_overview" model="ir.ui.view">
        <field name="name">stock.lot.search.elite.vet</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='on_hand']" position="after">
                <separator/>
                <filter name="below_minimum" string="Dochází"
                        domain="[('product_id.stock_below_minimum', '=', True)]"/>
                <separator/>
                <filter name="expiring_30_days" string="Expiruje do 30 dní"
                        domain="[('product_qty', '&gt;', 0),
                                 ('expiration_date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')),
                                 ('expiration_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter name="expired" string="Prošlé"
                        domain="[('product_qty', '&gt;', 0),
                                 ('expiration_date', '&lt;', datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'))]"/>
            </xpath>
        </field>
    </record>

    <!-- Read-only list: what is in stock, by lot, with the expiry. -->
    <record id="view_stock_quant_overview_list" model="ir.ui.view">
        <field name="name">stock.quant.list.elite.vet.overview</field>
        <field name="model">stock.quant</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Přehled skladu" create="0" edit="0" delete="0"
                  decoration-danger="quantity &lt; 0" decoration-muted="quantity == 0">
                <field name="product_id"/>
                <field name="lot_id" groups="stock.group_production_lot"/>
                <field name="expiration_date" string="Expirace" width="110px" options="{'show_time': false}"/>
                <field name="location_id" groups="stock.group_stock_multi_locations"/>
                <field name="quantity" string="Množství" sum="Celkem"/>
                <field name="product_uom_id" string="MJ" groups="uom.group_uom"/>
            </list>
        </field>
    </record>

    <record id="action_stock_overview" model="ir.actions.act_window">
        <field name="name">Přehled skladu</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_stock_quant_overview_list"/>
        <field name="search_view_id" ref="stock.quant_search_view"/>
        <field name="context">{'search_default_internal_loc': 1, 'search_default_productgroup': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Na skladě nic není</p>
            <p>Filtry „Dochází“, „Expiruje do 30 dní“ a „Prošlé“ najdete v hledání.
               Úplně vyprodané zboží uvidíte v Sklady → Operace → Doplňování zboží → Doplňování.</p>
        </field>
    </record>
</odoo>
