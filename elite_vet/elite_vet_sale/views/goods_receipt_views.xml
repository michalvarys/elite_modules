<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Goods receipt by scanner (OWL client action registered by static/src/goods_receipt). -->
    <record id="action_goods_receipt" model="ir.actions.client">
        <field name="name">Příjem zboží</field>
        <field name="tag">elite_vet_sale.goods_receipt</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_goods_receipt_clinic" name="Příjem zboží" parent="elite_vet_clinic.menu_clinic_root"
              sequence="40" action="action_goods_receipt" groups="elite_vet_clinic.group_clinic_nurse"/>
    <menuitem id="menu_goods_receipt_stock" name="Příjem zboží" parent="stock.menu_stock_warehouse_mgmt"
              sequence="1" action="action_goods_receipt" groups="elite_vet_clinic.group_clinic_nurse"/>

    <!-- Codes assigned to products in the goods receipt (to correct a wrong assignment). -->
    <record id="view_product_code_list" model="ir.ui.view">
        <field name="name">elite.vet.product.code.list</field>
        <field name="model">elite.vet.product.code</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>
    <record id="view_product_code_search" model="ir.ui.view">
        <field name="name">elite.vet.product.code.search</field>
        <field name="model">elite.vet.product.code</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="product_id"/>
            </search>
        </field>
    </record>
    <record id="action_product_code" model="ir.actions.act_window">
        <field name="name">Kódy produktů pro čtečku</field>
        <field name="res_model">elite.vet.product.code</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_product_code" name="Kódy produktů pro čtečku" parent="stock.menu_product_in_config_stock"
              sequence="90" action="action_product_code" groups="stock.group_stock_manager"/>

    <!-- The expense shows the receipt it came from. -->
    <record id="view_expense_form_picking" model="ir.ui.view">
        <field name="name">elite.vet.expense.form.picking</field>
        <field name="model">elite.vet.expense</field>
        <field name="inherit_id" ref="elite_vet_winvet.view_expense_form"/>
        <field name="arch" type="xml">
            <field name="document_number" position="after">
                <field name="picking_id" invisible="not picking_id"/>
            </field>
        </field>
    </record>
</odoo>
