<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Bill lines without a price list item. The 21 % tax is set by ensure_setup,
             the chart of accounts does not exist yet when this file loads. -->
        <record id="product_free_line" model="product.product">
            <field name="name">Volná položka</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="available_in_pos" eval="True"/>
            <field name="list_price">0.0</field>
            <field name="default_code">EV-VOLNA</field>
        </record>
        <record id="config_winvet_master" model="ir.config_parameter">
            <field name="key">elite_vet_sale.winvet_master</field>
            <field name="value">1</field>
        </record>
    </data>
</odoo>
