<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS, sale and stock rights (spec, section "Role"; task 14: doctors and nurses have no till
         and no stock). They are a group of their own, outside the role chain
         Recepce < Sestra < Lékařka < Správce rezervací: a Recepce user gets it when the role is set
         (elite_vet_reception, res.users), Vedení implies it. Reception sees all sale orders:
         quotations come from the doctors' visit records. -->
    <record id="module_category_elite_vet_till" model="ir.module.category">
        <field name="name">Elite Vet – pokladna</field>
        <field name="description">Pokladna, prodej a sklad (příjem zboží, přehled skladu).</field>
        <field name="sequence">53</field>
    </record>
    <record id="group_till_stock" model="res.groups">
        <field name="name">Pokladna a sklad (recepce)</field>
        <field name="category_id" ref="module_category_elite_vet_till"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user')),
                                         (4, ref('sales_team.group_sale_salesman_all_leads')),
                                         (4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Pokladna Recepce, nabídky, přehled skladu a příjem zboží. Recepce ho dostane automaticky při nastavení role, sestra a lékařka ho nemají.</field>
    </record>

    <!-- The role groups are noupdate records of other modules, so a <record> here would apply only
         on install; <function> runs on install and on every upgrade. Earlier versions made Recepce
         imply POS + sale (salesman, later all documents) and Sestra imply stock: every POS, sale and
         stock link of Recepce / Sestra / Lékařka is removed here (idempotent,
         res.groups._elite_vet_unlink_role_till_rights); the users of the old chain are cleaned up
         once by the 18.0.1.0.2 migration (res.users._elite_vet_split_till_rights). -->
    <function model="res.groups" name="_elite_vet_unlink_role_till_rights"/>
    <!-- Adding an implied group also gives it to the existing users of the role. -->
    <function model="res.groups" name="write">
        <value eval="[ref('elite_vet_reservation.group_reservation_manager')]"/>
        <value eval="{'implied_ids': [(4, ref('group_till_stock')),
                                      (4, ref('point_of_sale.group_pos_manager')),
                                      (4, ref('stock.group_stock_manager')),
                                      (4, ref('sales_team.group_sale_manager'))]}"/>
    </function>
</odoo>
