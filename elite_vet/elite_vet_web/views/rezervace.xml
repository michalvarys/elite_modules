<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stranka rezervace. Zdrojovy jazyk sablony je ANGLICTINA, ostatni jazyky
         jsou preklady v i18n/*.po — uprava textu tady tedy nerozbije preklady. -->
    <template id="rezervace" name="Elite Vet - Rezervace">
        <t t-call="website.layout">
            <!-- Adresa teze stranky v kazdem jazyce. Prepinac na ne vede primo,
                 protoze pres /website/lang/ to stoji na cookie frontend_lang a ten
                 in-app prohlizec Instagramu a Facebooku neposila tak, jak Odoo ceka.
                 Cestina je vychozi jazyk a na "/" vraci url_for prazdno, proto "/". -->
            <t t-set="ev_jazyk_cs" t-value="('%s' % url_for(request.httprequest.path, lang_code='cs_CZ')) or '/'"/>
            <t t-set="ev_jazyk_de" t-value="('%s' % url_for(request.httprequest.path, lang_code='de_DE')) or '/'"/>
            <t t-set="ev_jazyk_en" t-value="('%s' % url_for(request.httprequest.path, lang_code='en_US')) or '/'"/>
            <t t-set="ev_jazyk_ru" t-value="('%s' % url_for(request.httprequest.path, lang_code='ru_RU')) or '/'"/>
            <t t-set="ev_web" t-value="request.env['elite.vet.setting'].sudo().nastaveni() if 'elite.vet.setting' in request.env else None"/>
            <t t-set="ev_hodiny" t-value="request.env['elite.vet.opening.hours'].sudo().search([]) if 'elite.vet.opening.hours' in request.env else []"/>
        <t t-set="ev_dotazy" t-value="request.env['elite.vet.faq'].sudo().search([]) if 'elite.vet.faq' in request.env else []"/>
            <t t-set="no_header" t-value="true"/>
            <t t-set="no_footer" t-value="true"/>
            <t t-set="additional_title">Book an appointment | Elite Vet Karlovy Vary</t>
            <t t-set="meta_description">Book online at the Elite Vet veterinary clinic in Karlovy Vary. Choose a free appointment with our doctors, or call the reception. Answers to the most common questions before your visit.</t>
            <meta name="theme-color" content="#1a2744"/>

            <!-- Styly stranky jsou v CSS souboru modulu, spolecne v elite_vet_theme. -->
            <t t-set="head">
                <t t-call-assets="elite_vet_web.stranka_rezervace" t-js="false"/>
            </t>

            <div id="wrap" class="oe_structure vet-page">

                <!-- =========================== TOPBAR =========================== -->
                <!-- Horni lista je spolecna pro cely web, viz elite_vet_theme. -->
                <t t-call="elite_vet_theme.vet_header"/>

                <!-- =========================== HERO =========================== -->
                <section class="ev-rezhero o_colored_level">
                    <div class="ev-container">
                        <span class="ev-rezhero-badge">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8" y1="2" x2="8" y2="6"/>
                                <line x1="3" y1="10" x2="21" y2="10"/>
                            </svg>
                            RESERVATION SYSTEM
                        </span>
                        <h1>Book your appointment</h1>
                        <p class="ev-rezhero-lead">Select a free appointment with our doctors online, whenever it suits you. If you are unsure, call the reception and we will book you in ourselves.</p>
                        <div class="ev-rezhero-meta">
                            <a t-attf-href="tel:#{(ev_web.phone if ev_web else False) or '+420722599699'}" class="ev-rezhero-chip">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                                </svg>
                                <t t-out="(ev_web.phone_display if ev_web else False) or (ev_web.phone if ev_web else False) or '+420 722 599 699'"/>
                            </a>
                            <span class="ev-rezhero-chip">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                <t t-foreach="ev_hodiny" t-as="ev_h"><t t-if="ev_h_index"> · </t><span t-out="ev_h.dny()"></span> <span t-field="ev_h.time_text"></span></t>
                            </span>
                            <a t-att-href="(ev_web.map_url if ev_web else False) or 'https://www.google.com/maps/place/ELITE+Veterin%C3%A1rn%C3%AD+Klinika/@50.2324691,12.8591764,17z/data=!4m6!3m5!1s0x47a0994d82cd5559:0xe9031539fb1b184c!8m2!3d50.2324692!4d12.8640473!16s%2Fg%2F11zf3w1c3h'" target="_blank" rel="noopener noreferrer" class="ev-rezhero-chip">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                    <circle cx="12" cy="10" r="3"/>
                                </svg>
                                Hybešova 167/18, Karlovy Vary
                            </a>
                        </div>
                    </div>
                </section>


                <!-- =========================== REZERVACNI SYSTEM =========================== -->
                <div class="evrez">
                  <div class="evrez-frame">
                    <div class="evrez-inner">
                      <!-- Texty jsou napevno pro kazdy jazyk, ne pres prekladovy rezim.
                           Duvod: tohle hlaseni lezi POD iframem, takze je v Odoo Translate
                           neviditelne a nikdo by se na nej neproklikal. Novy jazyk = novy radek. -->
                      <div class="evrez-nacitani" aria-hidden="true">
                        <span class="evrez-spinner"></span>
                        <span t-out="(ev_web.booking_loading_title if ev_web else False) or 'Načítáme rezervační systém…'"></span>
                        <span class="evrez-nacitani-podtext" t-out="(ev_web.booking_loading_note if ev_web else False) or ''"></span>
                      </div>
                      <!-- Zamerne BEZ loading="lazy": rezervace je hlavni obsah stranky,
                           nema smysl s ni cekat, az k ni nekdo doscrolluje. -->
                      <iframe t-att-src="(ev_web.booking_url if ev_web else False) or 'https://reservation.winvet.cz/booking/f5832eae07850edb2b5a1167843ef423'" title="Elite Vet booking system" scrolling="no" loading="eager"></iframe>
                    </div>
                  </div>
                </div>
                <!-- Text pod rezervaci. Zamerne NENI v hlasce o nacitani: ta lezi pod
                     iframem a zmizi, jakmile se WinVet vykresli. Tenhle ma zustat. -->
                <!-- Vychozi misto textu je tady, pod rameckem. Skript nize ho na dobu
                     nacitani presune dovnitr a po nacteni WinVetu vrati zpatky. -->
                <div class="evrez-zprava-misto">
                    <p t-if="(ev_web.booking_loading_middle if ev_web else False)" class="evrez-zprava" t-out="(ev_web.booking_loading_middle if ev_web else False)"></p>
                </div>
                <!-- Kdo si neni jisty, ke kteremu lekari se objednat, se odsud dostane
                     na rozpis sluzeb. url_for doplni jazykovou predponu, bez ni by klik
                     v in-app prohlizeci Instagramu skoncil zpatky v cestine. -->
                <section class="evrez-rozpis o_colored_level">
                    <p class="evrez-rozpis-lead" t-out="(ev_web.schedule_link_lead if ev_web else False) or ''"></p>
                    <a t-att-href="url_for('/rozpis-lekaru')" class="evrez-rozpis-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                            <line x1="8" y1="14" x2="16" y2="14"/>
                            <line x1="8" y1="18" x2="13" y2="18"/>
                        </svg>
                        <span t-out="(ev_web.schedule_link_button if ev_web else False) or 'Rozpis služeb'"></span>
                    </a>
                </section>

                <!-- =========================== FAQ =========================== -->
                <section id="faq" class="ev-faq o_colored_level">
                    <div class="ev-container">
                        <div class="ev-faq-head">
                            <div class="ev-badge">Frequently Asked Questions</div>
                            <h2>What do you ask most often</h2>
                        </div>
                        <!-- Caste dotazy z adminu (Web kliniky -> Caste dotazy). -->
                        <div class="ev-faq-list">
                            <t t-foreach="ev_dotazy" t-as="ev_d">
                                <details class="ev-faq-item">
                                    <summary>
                                        <span class="ev-faq-q" t-field="ev_d.name"></span>
                                        <svg class="ev-faq-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                    </summary>
                                    <div class="ev-faq-a" t-field="ev_d.answer"></div>
                                </details>
                            </t>
                        </div>
                    </div>
                </section>

                <!-- =========================== AUTORSKY KREDIT =========================== -->
                <t t-call="elite_vet_theme.vet_footer"/>

            </div>
        <script>(function(){
        var misto=document.querySelector(".evrez-zprava-misto");
        var zprava=document.querySelector(".evrez-zprava");
        var nacitani=document.querySelector(".evrez-nacitani");
        var ram=document.querySelector(".evrez-inner iframe");
        if(!misto||!zprava||!nacitani||!ram){return;}
        function dolu(){if(zprava.parentNode!==misto){misto.appendChild(zprava);}
        zprava.classList.remove("evrez-zprava--nacitani");}
        nacitani.appendChild(zprava);
        zprava.classList.add("evrez-zprava--nacitani");
        ram.addEventListener("load",dolu);
        window.setTimeout(dolu,20000);
        })();</script>
        </t>
    </template>

    <record id="rezervace_page" model="website.page">
        <!-- Nazev se zamerne nenastavuje: website.page pri prejmenovani prepise
             i klic pohledu, takze by sablona modulu po kazdem upgradu prisla
             o svuj klic (elite_vet_web.rezervace -> website.rezervace). -->
        <field name="url">/rezervacni-system</field>
        <field name="view_id" ref="rezervace"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
    </record>

</odoo>
