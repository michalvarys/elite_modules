<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kazdy obsahovy blok domovske stranky jako samostatna sablona. Stranka je
         jen vypisuje v poradi, ktere urcuje admin, takze se bloky daji prerovnat
         nebo vypnout bez zasahu do kodu. -->

    <template id="sekce_letak" name="Blok: Leták s otevírací dobou">
        <t t-set="ev_hodiny" t-value="request.env['elite.vet.opening.hours'].sudo().search([]) if 'elite.vet.opening.hours' in request.env else []"/>
            <section id="odpocet" class="ev-cd o_colored_level">
                <div class="ev-container ev-cd-inner">
                    <h1 class="ev-sr-only">Veterinary clinic Karlovy Vary — Elite Vet</h1>
                    <!-- LETAK V HTML: pozadi, tyrkysovy pult a zvirata jsou obrazky, VSECHEN TEXT je zivy,
                         takze se da prekladat i upravovat v editoru.
                         Bez pravého sloupce s odrážkami a bez spodního kontaktního pruhu. -->
                    <div class="ev-flyer2">
                        <div class="ev-flyer2-bg"></div>
                        <div class="ev-flyer2-veil"></div>
                        <div class="ev-flyer2-desk"></div>

                        <div class="ev-flyer2-deco ev-flyer2-paw1">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <ellipse cx="7" cy="7.5" rx="2.4" ry="3.1"/>
                                <ellipse cx="12.6" cy="5.4" rx="2.3" ry="3"/>
                                <ellipse cx="17.8" cy="8.2" rx="2.2" ry="2.8"/>
                                <ellipse cx="20.4" cy="13.6" rx="1.9" ry="2.4"/>
                                <path d="M12.4 11.4c3.1 0 5.6 2.3 5.6 5.1 0 2.3-1.9 3.9-4.3 3.9-1 0-1.6-.3-2.6-.3s-1.6.3-2.6.3c-2.4 0-4.3-1.6-4.3-3.9 0-2.8 2.5-5.1 5.6-5.1z"/>
                            </svg>
                        </div>
                        <div class="ev-flyer2-deco ev-flyer2-paw2">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <ellipse cx="7" cy="7.5" rx="2.4" ry="3.1"/>
                                <ellipse cx="12.6" cy="5.4" rx="2.3" ry="3"/>
                                <ellipse cx="17.8" cy="8.2" rx="2.2" ry="2.8"/>
                                <ellipse cx="20.4" cy="13.6" rx="1.9" ry="2.4"/>
                                <path d="M12.4 11.4c3.1 0 5.6 2.3 5.6 5.1 0 2.3-1.9 3.9-4.3 3.9-1 0-1.6-.3-2.6-.3s-1.6.3-2.6.3c-2.4 0-4.3-1.6-4.3-3.9 0-2.8 2.5-5.1 5.6-5.1z"/>
                            </svg>
                        </div>
                        <div class="ev-flyer2-deco ev-flyer2-heart1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>
                            </svg>
                        </div>
                        <div class="ev-flyer2-deco ev-flyer2-heart2">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 0 0 0-7.8z"/>
                            </svg>
                        </div>

                        <div class="ev-flyer2-hand ev-flyer2-hand-1">We look forward to seeing you!</div>

                        <div class="ev-flyer2-inner">
                            <img src="/elite_vet_web/static/src/img/logo.jpeg" alt="Elite Vet" class="ev-flyer2-logo" loading="eager" decoding="async"/>
                            <div class="ev-flyer2-brand">Elite Veterinary Clinic</div>

                            <div class="ev-flyer2-title">
                                <svg class="ev-flyer2-brush" viewBox="0 0 600 130" preserveAspectRatio="none" aria-hidden="true">
                                    <path d="M300 4 C 420 4, 520 8, 566 13 C 584 15, 594 24, 596 45 C 598 63, 598 78, 595 98 C 592 113, 580 119, 558 121 C 470 127, 330 128, 250 126 C 168 124, 78 120, 42 115 C 20 112, 6 103, 4 83 C 2 65, 2 47, 5 29 C 8 15, 20 10, 42 8 C 120 3, 220 4, 300 4 Z" fill="#16787b"/>
                                </svg>
                                <span class="ev-flyer2-open">Open</span>
                            </div>
                            <div class="ev-flyer2-sub">Every day!</div>

                            <div class="ev-flyer2-pills">
                                <div class="ev-flyer2-pill">
                                    <span class="ev-flyer2-ic">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                                            <line x1="16" y1="2" x2="16" y2="6"/>
                                            <line x1="8" y1="2" x2="8" y2="6"/>
                                            <line x1="3" y1="10" x2="21" y2="10"/>
                                        </svg>
                                    </span>
                                    <span class="ev-flyer2-date"><t t-out="ev_hodiny[0].dny() if ev_hodiny else ''"/> <t t-out="ev_hodiny[0].cas() if ev_hodiny else ''"/></span>
                                </div>
                                <div class="ev-flyer2-pill">
                                    <span class="ev-flyer2-ic">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="9"/>
                                            <polyline points="12 7 12 12 15.5 14"/>
                                        </svg>
                                    </span>
                                    <span class="ev-flyer2-time"><t t-out="ev_hodiny[1].dny() if len(ev_hodiny) > 1 else ''"/> <t t-out="ev_hodiny[1].cas() if len(ev_hodiny) > 1 else ''"/></span>
                                </div>
                            </div>

                            <div class="ev-flyer2-hand ev-flyer2-hand-2">Your pets in the best hands!</div>
                        </div>

                        <picture>
                            <source media="(max-width: 820px)" srcset="/elite_vet_web/static/src/img/zvirata-440.png"/>
                            <img class="ev-flyer2-pets" src="/elite_vet_web/static/src/img/zvirata.png" alt="Dogs and cat" loading="eager" decoding="async"/>
                        </picture>
                    </div>

                </div>
            </section>
    </template>

    <template id="sekce_objednat" name="Blok: Tlačítko Objednat se">
            <!-- Ramecek s vysvetlenim priplatku. Obsah se pise v adminu
                 (Nastaveni kontaktu -> Ramecek pod uvodni sekci). -->
            <div t-if="ev_web and ev_web.hero_note" class="ev-hero-note">
                <div class="ev-hero-note-in" t-out="(ev_web.hero_note if ev_web else False)"></div>
            </div>
            <section class="ev-where-sec o_colored_level">
                <div class="ev-container ev-where-row">
                    <a href="/rezervacni-system" class="ev-cd-where">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Book an appointment
                    </a>
                </div>
            </section>
    </template>

    <template id="sekce_o_klinice" name="Blok: O klinice a galerie">
        <t t-set="ev_hodiny" t-value="request.env['elite.vet.opening.hours'].sudo().search([]) if 'elite.vet.opening.hours' in request.env else []"/>
            <section id="o-nas" class="ev-about o_colored_level">
                <div class="ev-container">
                    <div class="ev-about-grid">
                        <div>
                            <div class="ev-badge">About the clinic</div>
                            <h2>We have built a modern clinic for <span class="ev-accent-text">your pets</span></h2>
                            <p class="ev-about-lead">We have built a modern veterinary clinic in Karlovy Vary for you — a long-term project with the goal of offering comprehensive veterinary care in the region, all in one place.</p>
                            <!-- Dokud pohotovost nebezi a neni ani ohlasena, nesmi o ni byt
                                 ani zminka — jinak ji lide ctou jako uz fungujici. -->
                            <p t-if="ev_web and ev_web.emergency_mode == 'hidden'" class="ev-about-lead">The clinic is equipped with modern diagnostic and treatment technology and from the outset offers extended opening hours including weekends. We will gradually extend our operation further.</p>
                            <p t-else="" class="ev-about-lead">The clinic is equipped with modern diagnostic and treatment technology and from the outset offers extended opening hours including weekends. We will gradually extend our operation further and in the near future also plan 24/7 availability for acute cases.</p>
                            <div class="ev-about-feats">
                                <div class="ev-about-feat-item">
                                    <div class="ev-check-circle">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5ba8a0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                    </div>
                                    Modern equipment
                                </div>
                                <div class="ev-about-feat-item">
                                    <div class="ev-check-circle">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5ba8a0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                    </div>
                                    Gentle handling
                                </div>
                                <div class="ev-about-feat-item">
                                    <div class="ev-check-circle">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5ba8a0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                    </div>
                                    Individual approach
                                </div>
                                <div class="ev-about-feat-item">
                                    <div class="ev-check-circle">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5ba8a0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="20 6 9 17 4 12"/>
                                        </svg>
                                    </div>
                                    Complex care
                                </div>
                            </div>
                        </div>

                        <div class="ev-about-mission">
                            <div class="ev-mission-card">
                                <div class="ev-blob-1"></div>
                                <div class="ev-blob-2"></div>
                                <div class="ev-mission-foto">
                                    <img src="/elite_vet_web/static/src/img/galerie/15.jpg" alt="Reception of the Elite Vet veterinary clinic in Karlovy Vary" loading="lazy" decoding="async"/>
                                </div>
                                <h3>We are here for you every day</h3>
                                <p class="ev-mission-text">We are in full operation — <t t-foreach="ev_hodiny" t-as="ev_h"><t t-if="ev_h_index">, </t><span t-out="ev_h.dny().lower()"></span> <span t-field="ev_h.time_text"></span></t>. Book online or by phone at the reception.</p>
                                <a t-attf-href="tel:#{(ev_web.phone if ev_web else False) or '+420722599699'}" class="ev-call ev-call--mission">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                                    </svg>
                                    Call the reception<br/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- Galerie z adminu (Web kliniky -> Galerie kliniky). Pas listuje po
                         trech fotkach, takze stran je tolik, kolik vyjde po trech. Posledni
                         strana se zarovnava na konec, aby v ni nezustalo prazdne misto. -->
                    <t t-set="ev_pocet_fotek" t-value="len(ev_fotky)"/>
                    <t t-set="ev_stran" t-value="(ev_pocet_fotek + 2) // 3"/>
                    <div t-if="ev_pocet_fotek" id="galerie" class="ev-gal-inline">
                        <style>
                            @media (min-width: 769px) {
                                <t t-foreach="range(2, ev_stran + 1)" t-as="ev_k">
                                    <t t-if="ev_k &lt; ev_stran">#ev-gal-s<t t-out="ev_k"/>:checked ~ .ev-gal-view .ev-gal-track { transform: translateX(calc(-<t t-out="(ev_k - 1) * 100"/>% - <t t-out="(ev_k - 1) * 18"/>px)); }</t>
                                    <t t-else="">#ev-gal-s<t t-out="ev_k"/>:checked ~ .ev-gal-view .ev-gal-track { transform: translateX(calc(-<t t-out="round((ev_pocet_fotek - 3) * 100.0 / 3, 3)"/>% - <t t-out="6 * (ev_pocet_fotek - 3)"/>px)); }</t>
                                </t>
                                <t t-foreach="range(1, ev_stran)" t-as="ev_k">#ev-gal-s<t t-out="ev_k"/>:checked ~ .ev-gal-nav .ev-gal-next-<t t-out="ev_k + 1"/> { display: flex; }</t>
                                <t t-foreach="range(2, ev_stran + 1)" t-as="ev_k">#ev-gal-s<t t-out="ev_k"/>:checked ~ .ev-gal-nav .ev-gal-prev-<t t-out="ev_k - 1"/> { display: flex; }</t>
                            }
                        </style>
                        <div class="ev-gal-box">
                            <t t-foreach="range(1, ev_stran + 1)" t-as="ev_k">
                                <input class="ev-gal-radio" type="radio" name="ev-gal-strana"
                                       t-attf-id="ev-gal-s#{ev_k}" t-att-checked="'checked' if ev_k == 1 else None"/>
                            </t>
                            <div class="ev-gal-view">
                                <div class="ev-gal-track">
                                    <t t-foreach="ev_fotky" t-as="ev_f">
                                        <div class="ev-gal-item">
                                            <img t-attf-src="/web/image/elite.vet.gallery.photo/#{ev_f.id}/image/500x667"
                                                 t-att-alt="ev_f.name or 'Elite Vet'"
                                                 loading="lazy" decoding="async" fetchpriority="low"
                                                 width="500" height="667"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                            <div t-if="ev_stran &gt; 1" class="ev-gal-nav">
                                <t t-foreach="range(1, ev_stran)" t-as="ev_k">
                                    <label class="ev-gal-arr ev-gal-arr--prev" t-attf-class="ev-gal-arr ev-gal-arr--prev ev-gal-prev-#{ev_k}"
                                           t-attf-for="ev-gal-s#{ev_k}" aria-label="Previous photos"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg></label>
                                </t>
                                <t t-foreach="range(2, ev_stran + 1)" t-as="ev_k">
                                    <label t-attf-class="ev-gal-arr ev-gal-arr--next ev-gal-next-#{ev_k}"
                                           t-attf-for="ev-gal-s#{ev_k}" aria-label="Next photos"><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg></label>
                                </t>
                            </div>
                        </div>
                        <p class="ev-gal-hint">Swipe sideways to browse the photos</p>
                    </div>
                </div>
            </section>
    </template>

    <template id="sekce_sluzby" name="Blok: Služby">
        <t t-set="ev_druhy" t-value="request.env['elite.vet.species'].sudo().search([]) if 'elite.vet.species' in request.env else []"/>
            <section id="sluzby" class="ev-services o_colored_level">
                <div class="ev-container">
                    <div class="ev-section-head">
                        <div class="ev-badge">Our services</div>
                        <h2>Comprehensive care for your pets</h2>
                        <p>Dogs, cats and small mammals — comprehensive veterinary care in one place, with technology at a very high level. Our goal is to provide the widest possible range of care under one roof.</p>
                    </div>
                    <!-- Koho prijimame — z adminu (Web kliniky -> Koho prijimame). -->
                    <div t-if="ev_druhy" class="ev-species">
                        <t t-foreach="ev_druhy" t-as="ev_dr">
                            <div class="ev-species-chip">
                                <img t-if="ev_dr.icon_id and ev_dr.icon_id.image"
                                     t-attf-src="/web/image/elite.vet.team.icon/#{ev_dr.icon_id.id}/image/30x30"
                                     width="30" height="30" alt="" loading="lazy" decoding="async"/>
                                <svg t-else="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <t t-if="ev_dr.icon_code == 'kocka'"><path d="M12 5c.67 0 1.35.09 2 .26 1.78-2 5.03-2.84 6.42-2.26 1.4.58-.42 7-.42 7 .57 1.07 1 2.24 1 3.44C21 17.9 16.97 21 12 21s-9-3.1-9-7.56c0-1.25.5-2.4 1-3.44 0 0-1.89-6.42-.5-7 1.39-.58 4.72.23 6.5 2.23A9.04 9.04 0 0 1 12 5z"/><path d="M8 14v.5"/><path d="M16 14v.5"/><path d="M11.25 16.25h1.5L12 17z"/></t>
                                    <t t-elif="ev_dr.icon_code == 'savec'"><path d="M13 16a3 3 0 0 1 2.24 5"/><path d="M18 12h.01"/><path d="M18 21h-8a4 4 0 0 1-4-4 7 7 0 0 1 7-7h.2L9.6 6.4a1 1 0 1 1 2.8-2.8L15.8 7h.2c3.3 0 6 2.7 6 6v1a2 2 0 0 1-2 2h-1a3 3 0 0 0-3 3"/><path d="M20 8.54V4a2 2 0 1 0-4 0v3"/><path d="M7.612 12.524a3 3 0 1 0-1.6 4.3"/></t>
                                    <t t-else=""><path d="M11.25 16.25h1.5L12 17z"/><path d="M16 14v.5"/><path d="M4.42 11.247A13.152 13.152 0 0 0 4 14.556C4 18.728 7.582 21 12 21s8-2.272 8-6.444a11.702 11.702 0 0 0-.493-3.309"/><path d="M8 14v.5"/><path d="M8.5 8.5c-.384 1.05-1.083 2.028-2.344 2.5-1.931.722-3.576-.297-3.656-1-.113-.994 1.177-6.53 4-7 1.923-.321 3.651.845 3.651 2.235A7.497 7.497 0 0 1 14 5.277c0-1.39 1.844-2.598 3.767-2.277 2.823.47 4.113 6.006 4 7-.08.703-1.725 1.722-3.656 1-1.261-.472-1.96-1.45-2.344-2.5"/></t>
                                </svg>
                                <span t-field="ev_dr.name"></span>
                            </div>
                        </t>
                    </div>
                    <!-- Sluzby se berou z adminu (Web kliniky -> Sluzby), takze si je
                         klinika pridava a preskladava sama. Mrizka na PC i rozbalovaci
                         seznam na mobilu vypisuji stejne zaznamy. -->
                    <div class="ev-services-grid">
                        <t t-foreach="ev_sluzby" t-as="ev_s">
                            <div class="ev-service-card">
                                <div class="ev-service-icon">
                                    <t t-call="elite_vet_web.service_icon">
                                        <t t-set="ev_service" t-value="ev_s"/>
                                        <t t-set="ev_size" t-value="28"/>
                                    </t>
                                </div>
                                <h3 t-field="ev_s.name"></h3>
                                <p t-field="ev_s.description"></p>
                            </div>
                        </t>
                    </div>

                    <div class="ev-services-mobile-list">
                        <t t-foreach="ev_sluzby" t-as="ev_s">
                            <details>
                                <summary>
                                    <div class="ev-srv-icon">
                                        <t t-call="elite_vet_web.service_icon">
                                            <t t-set="ev_service" t-value="ev_s"/>
                                            <t t-set="ev_size" t-value="22"/>
                                        </t>
                                    </div>
                                    <span class="ev-srv-title" t-field="ev_s.name"></span>
                                    <svg class="ev-srv-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                                </summary>
                                <p class="ev-srv-body" t-field="ev_s.description"></p>
                            </details>
                        </t>
                    </div>
                </div>
            </section>
    </template>

    <template id="sekce_tym" name="Blok: Pozvánka na náš tým">
            <section id="tym" class="ev-teamcta o_colored_level">
                <div class="ev-container">
                    <div class="ev-teamcta-card">
                        <div class="ev-blob-1"></div>
                        <div class="ev-blob-2"></div>
                        <div class="ev-teamcta-icon">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>
                        <div class="ev-teamcta-badge">OUR TEAM</div>
                        <h2>Expert team for the health of your pets</h2>
                        <p class="ev-teamcta-text">Behind Elite Vet is a team of experienced veterinarians and specialists. Get to know the people who are opening our clinic in Karlovy Vary.</p>
                        <a href="/nas-tym" class="ev-teamcta-btn">
                            Meet our team<br/>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"/>
                                <polyline points="12 5 19 12 12 19"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </section>
    </template>

    <template id="sekce_kontakt" name="Blok: Kontakt, hodiny a mapa">
            <section id="kontakt" class="ev-contact o_colored_level">
                <div class="ev-container">
                    <div class="ev-section-head">
                        <div class="ev-badge">Contact</div>
                        <h2>Visit us</h2>
                        <p>Book by phone or email.</p>
                    </div>
                    <div class="ev-contact-grid">
                        <!-- Kontaktni karty z adminu (Web kliniky -> Kontaktni karty). -->
                        <div class="ev-contact-stack">
                            <t t-foreach="ev_kontakty" t-as="ev_k">
                                <div class="ev-contact-card">
                                    <div class="ev-contact-card-inner">
                                        <div class="ev-contact-card-icon">
                                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                <t t-if="ev_k.icon_code == 'telefon'">
                                                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                                                </t>
                                                <t t-elif="ev_k.icon_code == 'email'">
                                                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                                </t>
                                                <t t-else="">
                                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                                    <circle cx="12" cy="10" r="3"/>
                                                </t>
                                            </svg>
                                        </div>
                                        <div class="ev-contact-card-body">
                                            <h3 t-field="ev_k.name"></h3>
                                            <a t-att-href="ev_k.url or None"
                                               t-att-target="'_blank' if ev_k.url and '://' in ev_k.url else None"
                                               t-att-rel="'noopener noreferrer' if ev_k.url and '://' in ev_k.url else None"
                                               class="ev-contact-link">
                                                <span t-field="ev_k.value"></span>
                                                <t t-if="ev_k.value2"><br/><span t-field="ev_k.value2"></span></t>
                                            </a>
                                            <p t-if="ev_k.note" class="ev-contact-role" t-field="ev_k.note"></p>
                                        </div>
                                        <svg class="ev-contact-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                    </div>
                                </div>
                            </t>
                        </div>

                    <div class="ev-contact-bottom">
                        <div class="ev-hours">
                            <h3 class="ev-hours-h3-desk">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                Opening soon
                            </h3>
                            <h3 class="ev-hours-h3-mob">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/>
                                    <polyline points="12 6 12 12 16 14"/>
                                </svg>
                                Opening hours
                            </h3>
                            <!-- Ordinacni hodiny z adminu (Web kliniky -> Ordinacni hodiny). -->
                            <div class="ev-hours-table">
                                <t t-foreach="ev_hodiny" t-as="ev_h">
                                    <div class="ev-hours-row">
                                        <span class="ev-hours-day" t-field="ev_h.name"></span>
                                        <span t-attf-class="ev-hours-time#{' ev-closed' if ev_h.is_closed else ''}"
                                              t-field="ev_h.time_text"></span>
                                    </div>
                                </t>
                            </div>
                            <!-- Veta pod hodinami se ridi rezimem pohotovosti (Nastaveni kontaktu).
                                 Ve skrytem rezimu se o lince nesmi objevit ani zminka, jinak si ji
                                 klienti vylozi jako bezici pohotovost. -->
                            <t t-set="ev_rezim" t-value="ev_web.emergency_mode if ev_web else 'hidden'"/>
                            <p t-if="ev_rezim == 'hidden'" class="ev-hours-note">
                                <t t-if="ev_web and ev_web.emergency_off_note"><t t-out="(ev_web.emergency_off_note if ev_web else False)"/></t>
                                <t t-else="">Treatment outside opening hours is possible only by prior telephone arrangement and confirmation that the team is available. This is not a round-the-clock service.</t>
                            </p>
                            <p t-elif="not ev_pohotovost" class="ev-hours-note">
                                <t t-if="ev_web and ev_web.emergency_off_note"><t t-out="(ev_web.emergency_off_note if ev_web else False)"/></t>
                                <t t-else="">We plan to extend our opening hours further in the near future. We will also soon launch <span class="ev-hours-emergency">a 24/7 emergency line</span> for acute cases — we will publish the number as soon as it is ready.</t>
                            </p>
                            <p t-else="" class="ev-hours-note">We plan to extend our opening hours further in the near future. For acute cases outside opening hours we are available on <span class="ev-hours-emergency">the 24/7 emergency line</span>.</p>
                            <a href="/rezervacni-system" class="ev-call ev-call--full" style="margin-top: 22px;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                                    <line x1="16" y1="2" x2="16" y2="6"/>
                                    <line x1="8" y1="2" x2="8" y2="6"/>
                                    <line x1="3" y1="10" x2="21" y2="10"/>
                                </svg>
                                Book an appointment
                            </a>
                        </div>

                        <a t-att-href="(ev_web.map_url if ev_web else False) or 'https://www.google.com/maps/place/ELITE+Veterin%C3%A1rn%C3%AD+Klinika/@50.2324691,12.8591764,17z/data=!4m6!3m5!1s0x47a0994d82cd5559:0xe9031539fb1b184c!8m2!3d50.2324692!4d12.8640473!16s%2Fg%2F11zf3w1c3h'" target="_blank" rel="noopener noreferrer" class="ev-map" id="mapa">
                            <div class="ev-map-static"></div>
                            <div class="ev-map-pin">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                                    <circle cx="12" cy="10" r="3"/>
                                </svg>
                            </div>
                            <div class="ev-map-overlay">
                                <p class="ev-map-addr">Hybešova 167/18</p>
                                <p>Rybáře, 360 05 Karlovy Vary</p>
                                <span class="ev-map-link">
                                    Open in maps
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                        <polyline points="15 3 21 3 21 9"/>
                                        <line x1="10" y1="14" x2="21" y2="3"/>
                                    </svg>
                                </span>
                            </div>
                        </a>
                        </div>
                    </div>

                    <!-- Socialni site z Nastaveni webu. Kdyz nejsou vyplnene, pas se
                         vubec nevykresli — at na strance nevisi prazdna kolecka. -->
                    <div t-if="ev_web and (ev_web.instagram_url or ev_web.facebook_url)" class="ev-cd-social">
                        <a t-if="(ev_web.instagram_url if ev_web else False)" t-att-href="(ev_web.instagram_url if ev_web else False)"
                           target="_blank" rel="noopener noreferrer"
                           class="ev-cd-soc ev-cd-ig" aria-label="Instagram">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07zm0 5.18a4.66 4.66 0 1 0 0 9.32 4.66 4.66 0 0 0 0-9.32zm0 7.69a3.03 3.03 0 1 1 0-6.06 3.03 3.03 0 0 1 0 6.06zm5.94-7.87a1.09 1.09 0 1 1-2.18 0 1.09 1.09 0 0 1 2.18 0z"/></svg>
                        </a>
                        <a t-if="(ev_web.facebook_url if ev_web else False)" t-att-href="(ev_web.facebook_url if ev_web else False)"
                           target="_blank" rel="noopener noreferrer"
                           class="ev-cd-soc ev-cd-fb" aria-label="Facebook">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
                        </a>
                    </div>
                </div>
            </section>
    </template>

</odoo>
