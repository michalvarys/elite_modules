<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_list" model="ir.ui.view">
        <field name="name">elite.vet.service.list</field>
        <field name="model">elite.vet.service</field>
        <field name="arch" type="xml">
            <list string="Služby" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon_image" widget="image" options="{'size': [28, 28]}" nolabel="1"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="icon_code"/>
                <field name="icon_id" options="{'no_create': True}"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_service_form" model="ir.ui.view">
        <field name="name">elite.vet.service.form</field>
        <field name="model">elite.vet.service</field>
        <field name="arch" type="xml">
            <form string="Služba">
                <sheet>
                    <widget name="web_ribbon" title="Vypnuto" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="icon_image" widget="image" class="oe_avatar"
                           options="{'size': [90, 90]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="např. Preventivní péče"/></h1>
                    </div>
                    <group>
                        <group string="Text na webu">
                            <field name="description" placeholder="Krátký popis pod nadpisem."/>
                        </group>
                        <group string="Ikona">
                            <field name="icon_code"/>
                            <field name="icon_id" options="{'no_create': True}"/>
                            <div class="text-muted" colspan="2">
                                Vlastní obrázek má přednost. Nové obrázky se nahrávají
                                v Náš tým → Ikony a dají se použít i u lékařek.
                            </div>
                        </group>
                        <group string="Zařazení">
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        Text jde přeložit: nahoře vpravo přepni jazyk a přepiš název i popis.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service" model="ir.actions.act_window">
        <field name="name">Služby na webu</field>
        <field name="res_model">elite.vet.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Přidejte první službu</p>
            <p>Služby se vypisují na domovské stránce. Pořadí se mění přetažením.</p>
        </field>
    </record>

    <menuitem id="menu_web_root" name="Web kliniky" sequence="49"
              groups="elite_vet_calendar.group_calendar_manager"/>
    <menuitem id="menu_web_service" name="Služby" parent="menu_web_root"
              action="action_service" sequence="10"/>

</odoo>
