<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eet_attempt_list" model="ir.ui.view">
        <field name="name">elite.eet.attempt.list</field>
        <field name="model">elite.eet.attempt</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="sent_at"/>
                <field name="device_id"/>
                <field name="sale_id"/>
                <field name="verification"/>
                <field name="first_send"/>
                <field name="result"/>
                <field name="code"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_eet_attempt_form" model="ir.ui.view">
        <field name="name">elite.eet.attempt.form</field>
        <field name="model">elite.eet.attempt</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="device_id"/>
                            <field name="sale_id"/>
                            <field name="uuid"/>
                            <field name="sent_at"/>
                            <field name="first_send"/>
                            <field name="verification"/>
                        </group>
                        <group>
                            <field name="result"/>
                            <field name="code"/>
                            <field name="message"/>
                            <field name="pok"/>
                            <field name="is_test"/>
                            <field name="received_at"/>
                            <field name="warnings"/>
                            <field name="http_status"/>
                            <field name="transaction_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Odeslaná zpráva" name="request">
                            <field name="request_xml" widget="text" class="font-monospace"/>
                        </page>
                        <page string="Odpověď" name="response">
                            <field name="response_xml" widget="text" class="font-monospace"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eet_attempt_search" model="ir.ui.view">
        <field name="name">elite.eet.attempt.search</field>
        <field name="model">elite.eet.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="uuid"/>
                <field name="sale_id"/>
                <field name="device_id"/>
                <filter name="filter_failed" string="Neúspěšné"
                        domain="[('result', 'not in', ('pok', 'verified'))]"/>
            </search>
        </field>
    </record>
</odoo>
