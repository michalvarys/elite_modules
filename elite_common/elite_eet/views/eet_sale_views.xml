<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_eet_sale_list" model="ir.ui.view">
        <field name="name">elite.eet.sale.list</field>
        <field name="model">elite.eet.sale</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="state == 'registered'" decoration-warning="state == 'pending'"
                  decoration-danger="state == 'error'">
                <field name="dat_trzby"/>
                <field name="device_id"/>
                <field name="source_ref"/>
                <field name="porad_cis" optional="hide"/>
                <field name="celk_trzba" sum="Celkem"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge" decoration-success="state == 'registered'"
                       decoration-warning="state == 'pending'" decoration-danger="state == 'error'"/>
                <field name="pok" optional="show"/>
                <field name="deadline" optional="hide"/>
                <field name="attempt_count" optional="hide"/>
                <field name="last_error" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_eet_sale_form" model="ir.ui.view">
        <field name="name">elite.eet.sale.form</field>
        <field name="model">elite.eet.sale</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_send_to_eet" type="object" string="Odeslat do EET" class="btn-primary"
                            invisible="state == 'registered'" groups="elite_eet.group_eet_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                        <field name="last_error"/>
                    </div>
                    <group>
                        <group string="Tržba">
                            <field name="device_id" readonly="1"/>
                            <field name="source_ref" readonly="1"/>
                            <field name="porad_cis" readonly="1"/>
                            <field name="dat_trzby" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="celk_trzba" readonly="1"/>
                            <field name="urceno_cerp_zuct" readonly="1" invisible="not urceno_cerp_zuct"/>
                            <field name="cerp_zuct" readonly="1" invisible="not cerp_zuct"/>
                            <field name="deadline"/>
                        </group>
                        <group string="EET">
                            <field name="pok"/>
                            <field name="received_at"/>
                            <field name="is_test" invisible="not pok"/>
                            <field name="warning_text" invisible="not warning_text"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pokusy o odeslání" name="attempts">
                            <field name="attempt_ids" readonly="1">
                                <list>
                                    <field name="sent_at"/>
                                    <field name="uuid"/>
                                    <field name="first_send"/>
                                    <field name="result"/>
                                    <field name="code"/>
                                    <field name="message"/>
                                    <field name="transaction_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_eet_sale_search" model="ir.ui.view">
        <field name="name">elite.eet.sale.search</field>
        <field name="model">elite.eet.sale</field>
        <field name="arch" type="xml">
            <search>
                <field name="source_ref"/>
                <field name="porad_cis"/>
                <field name="pok"/>
                <field name="device_id"/>
                <filter name="filter_pending" string="Čeká" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_error" string="Chyba" domain="[('state', '=', 'error')]"/>
                <filter name="filter_registered" string="Evidováno" domain="[('state', '=', 'registered')]"/>
                <separator/>
                <filter name="filter_near_deadline" string="Blíží se 48 h" domain="[('is_near_deadline', '=', True)]"/>
                <filter name="filter_overdue" string="Po lhůtě" domain="[('is_overdue', '=', True)]"/>
                <separator/>
                <filter name="filter_date" string="Čas tržby" date="dat_trzby"/>
                <group expand="0" string="Seskupit">
                    <filter name="group_device" string="Pokladna" context="{'group_by': 'device_id'}"/>
                    <filter name="group_state" string="Stav" context="{'group_by': 'state'}"/>
                    <filter name="group_day" string="Den" context="{'group_by': 'dat_trzby:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_eet_sale" model="ir.actions.act_window">
        <field name="name">Tržby EET</field>
        <field name="res_model">elite.eet.sale</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1, 'search_default_filter_error': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Žádné tržby ke zobrazení</p>
            <p>Tržby vznikají samy při zaplacení na pokladně se zapnutým EET.</p>
        </field>
    </record>

    <record id="action_server_send_to_eet" model="ir.actions.server">
        <field name="name">Odeslat do EET</field>
        <field name="model_id" ref="model_elite_eet_sale"/>
        <field name="binding_model_id" ref="model_elite_eet_sale"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('elite_eet.group_eet_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_send_to_eet()</field>
    </record>
</odoo>
