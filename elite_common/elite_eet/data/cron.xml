<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_send_pending" model="ir.cron">
        <field name="name">EET: odeslat čekající tržby</field>
        <field name="model_id" ref="model_elite_eet_sale"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_watch" model="ir.cron">
        <field name="name">EET: hlídání tržeb a certifikátů</field>
        <field name="model_id" ref="model_elite_eet_device"/>
        <field name="state">code</field>
        <field name="code">model._cron_watch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
