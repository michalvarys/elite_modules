<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form_color" model="ir.ui.view">
        <field name="name">pos.payment.method.form.elite.color</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <field name="payment_method_type" position="before">
                <field name="pos_button_color" widget="color"/>
            </field>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_color" model="ir.ui.view">
        <field name="name">pos.payment.method.list.elite.color</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="pos_button_color" widget="color" string="Barva" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
