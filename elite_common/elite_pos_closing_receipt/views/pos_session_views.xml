<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_session_form_closing_receipt" model="ir.ui.view">
        <field name="name">pos.session.form.elite.closing.receipt</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_print_elite_closing_receipt" type="object"
                        string="Vytisknout uzávěrku" icon="fa-print"
                        invisible="state == 'opening_control'"/>
            </xpath>
        </field>
    </record>

</odoo>
