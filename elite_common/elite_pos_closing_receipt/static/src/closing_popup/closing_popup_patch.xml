<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- The "Daily Sale" report download and Odoo's sale details print give way to the printed
         closing receipt. -->
    <t t-name="point_of_sale.ClosePosPopup" t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">

        <xpath expr="//button[@t-on-click='downloadSalesReport']" position="replace">
            <button class="button btn btn-secondary"
                    t-att-class="this.ui.isSmall ? 'w-100' : 'btn-lg ms-auto'"
                    t-att-disabled="closingPrint.busy"
                    t-on-click="printClosingReceipt">
                <t t-if="closingPrint.busy">Tisknu…</t>
                <t t-else="">Vytisknout uzávěrku</t>
                <i t-if="!this.ui.isSmall" class="fa fa-print ms-1" role="img"/>
            </button>
        </xpath>

        <xpath expr="//button[@t-if='hardwareProxy.printer']" position="replace"/>

        <xpath expr="//t[@t-set-slot='footer']/div" position="before">
            <label class="d-flex align-items-center gap-2 w-100 mb-2">
                <input type="checkbox" class="form-check-input mt-0" t-model="closingPrint.withProducts"/>
                <span>Na uzávěrce vypsat i jednotlivé zboží</span>
            </label>
        </xpath>

    </t>

</templates>
